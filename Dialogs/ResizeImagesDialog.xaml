<Window x:Class="MpcHcVideoEditor.Dialogs.ResizeImagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:MpcHcVideoEditor.Dialogs"
        Title="Resize images" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="OptionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="SIZE" Style="{StaticResource Heading}"/>

        <!-- Left in the system's own colours, as the theme picker in Settings
             is. A light foreground over the default white chrome is text you
             cannot read. -->
        <ComboBox x:Name="SizeCombo" Padding="6,4" SelectionChanged="Size_Changed"/>

        <!-- Only in reach once Custom is the selection, so the two boxes cannot
             disagree with the list above them. -->
        <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="False">
            <TextBox x:Name="WidthBox" Width="70" TextChanged="Custom_Changed"/>
            <TextBlock Text="×" Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" Margin="8,0"/>
            <TextBox x:Name="HeightBox" Width="70" TextChanged="Custom_Changed"/>
            <TextBlock Text="pixels" Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock Text="SHAPE" Style="{StaticResource Heading}" Margin="0,18,0,8"/>

        <RadioButton x:Name="FitInside" GroupName="Fit" IsChecked="True">
            <StackPanel>
                <TextBlock Text="Fit inside"/>
                <TextBlock Style="{StaticResource OptionNote}"
                           Text="Keeps the picture's shape. One side lands on the size you picked and the other comes up short, so nothing is cut off or squashed."/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="FillCrop" GroupName="Fit">
            <StackPanel>
                <TextBlock Text="Fill and crop"/>
                <TextBlock Style="{StaticResource OptionNote}"
                           Text="Exactly the size you picked, with the overflow trimmed evenly from both sides."/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="StretchExact" GroupName="Fit">
            <StackPanel>
                <TextBlock Text="Stretch"/>
                <TextBlock Style="{StaticResource OptionNote}"
                           Text="Exactly the size you picked, by squashing. Distorts anything that was not already that shape."/>
            </StackPanel>
        </RadioButton>

        <dialogs:OutputFolderPicker x:Name="Where" Margin="0,14,0,0"/>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="4"
                Padding="10,8" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="11">
                <Run Text="Each picture keeps its own format. WebP comes back as PNG — nothing here can write WebP."/>
                <LineBreak/>
                <Run Text="The files you pick are not changed; new ones are written wherever you chose above."/>
            </TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Continue" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
