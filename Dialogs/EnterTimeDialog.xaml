<Window x:Class="MpcHcVideoEditor.Dialogs.EnterTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter time or range"
        SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ControlBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- The label down the left of each example row. Fixed width, so the
             examples themselves line up into a column and can be read down
             rather than hunted for. -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="54"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,8,0"/>
        </Style>

        <!-- Every example is a link that types itself into the box. Reading
             what a field accepts and then transcribing it by hand is the part
             of a help panel nobody enjoys; one click puts a working value in
             and the line above says the field will take it. -->
        <Style x:Key="ExampleLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource LinkBlue}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExampleRow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Why the last attempt was refused, when there was one. The caller's
             reasons are about the cut list — an overlap, a time before the
             last mark — not about how the time was written, so they belong
             above the box rather than in the line that reads it back. -->
        <Border Grid.Row="0" x:Name="ErrorBanner" Visibility="Collapsed"
                Background="{DynamicResource InsetBackground}"
                BorderBrush="{DynamicResource StatusError}" BorderThickness="1"
                CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource StatusError}"/>
        </Border>

        <TextBlock Grid.Row="1" Text="You may enter a time by itself, or a range of times"
                   FontSize="12" Margin="0,0,0,6"
                   Foreground="{DynamicResource TextSecondary}"/>

        <TextBox Grid.Row="2" x:Name="InputBox"
                 Background="{DynamicResource WindowBackground}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 CaretBrush="{DynamicResource TextPrimary}"
                 Padding="6" FontSize="15" FontFamily="Consolas"
                 TextChanged="Input_TextChanged"/>

        <!-- Whether what is in the box can be read, as it is typed: Valid or
             Invalid, and nothing while the box is empty. It used to read the
             value back in words — "Bookmark from 1:04 to 12:35" — which is a
             second thing to read on the way to an answer the user already
             knows, having just typed it. The question this has to settle is
             whether the field will take it. -->
        <TextBlock Grid.Row="3" x:Name="ReadingText" Margin="0,8,0,0"
                   FontSize="12" TextWrapping="Wrap" MinHeight="15"/>

        <Border Grid.Row="4" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="EXAMPLES — click one to use it" FontSize="10"
                           FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextMuted}"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Clock" Style="{StaticResource FormLabel}"/>
                    <TextBlock Style="{StaticResource ExampleRow}">
                        <Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">35</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">12:35</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1:04:35</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">00:00:35</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Units" Style="{StaticResource FormLabel}"/>
                    <TextBlock Style="{StaticResource ExampleRow}">
                        <Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1s</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1min</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1hr</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">4min 35s</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">3hr 4min 35s</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Words" Style="{StaticResource FormLabel}"/>
                    <TextBlock Style="{StaticResource ExampleRow}">
                        <Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">sixty</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1 minute</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1 hour 4 minutes 35 seconds</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Range" Style="{StaticResource FormLabel}"/>
                    <TextBlock Style="{StaticResource ExampleRow}">
                        <Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1 - 35</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1:04 - 12:35</Hyperlink><Run Text="   "/><Hyperlink Style="{StaticResource ExampleLink}" Click="Example_Click">1:04:35 - 1 hour 10 minutes 25 seconds</Hyperlink>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="4" IsDefault="True"
                    Click="Ok_Click" Padding="8,4"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="90" Margin="4" IsCancel="True" Click="Cancel_Click" Padding="8,4"/>
        </StackPanel>
    </Grid>
</Window>
