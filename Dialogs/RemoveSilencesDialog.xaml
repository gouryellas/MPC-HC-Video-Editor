<Window x:Class="MpcHcVideoEditor.Dialogs.RemoveSilencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove silences" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="What counts as a silence?" Foreground="{DynamicResource Accent}"
                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Quieter than" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="ThresholdBox"/>
                <TextBlock Text="dB" Style="{StaticResource Unit}"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Lasting at least" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="MinSilenceBox"/>
                <TextBlock Text="seconds" Style="{StaticResource Unit}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Keep around speech" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="PaddingBox"/>
                <TextBlock Text="seconds" Style="{StaticResource Unit}"/>
            </StackPanel>
        </Grid>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="4"
                Padding="10,8" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                       Text="-30 dB suits a quiet room; raise it towards -20 for a noisy one. Shorter pauses than the second number are left in, so speech keeps its rhythm. The last number keeps a little of each silence either side of what is kept, so words are not clipped at their edges."/>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ValueRed}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Continue" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
