<Window x:Class="MpcHcVideoEditor.Dialogs.CompressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compress to size" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="How big can each file be?" Foreground="{DynamicResource Accent}"
                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

        <RadioButton x:Name="Size10" GroupName="Size" Content="10 MB" Tag="10"/>
        <RadioButton x:Name="Size25" GroupName="Size" Content="25 MB" Tag="25"/>
        <RadioButton x:Name="Size50" GroupName="Size" Content="50 MB" Tag="50"/>
        <RadioButton x:Name="Size100" GroupName="Size" Content="100 MB" Tag="100"/>
        <RadioButton x:Name="SizeCustom" GroupName="Size">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Other:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="CustomBox" Width="70" GotKeyboardFocus="Custom_Focused"/>
                <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </RadioButton>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="4"
                Padding="10,8" Margin="0,6,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                       Text="Each file is encoded twice to MP4 to land just under the size: once to measure it, once to write it. When the size is too small for the picture to look decent at full size, the picture is made smaller to match. Files already under the size are left alone."/>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ValueRed}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Continue" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
