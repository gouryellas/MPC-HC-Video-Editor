<Window x:Class="MpcHcVideoEditor.Dialogs.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        SizeToContent="Height"
        Width="470"
        MinHeight="240"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadlineText" Foreground="{DynamicResource Accent}"
                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="RunningText" Foreground="{DynamicResource ValueGreen}"
                       FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- What changed, taken from the release's own notes. Collapsed when the
             release has none: the point of the list is to answer "is this worth
             downloading", and an empty box answers nothing. -->
        <Border x:Name="ChangesPanel" Grid.Row="1" Background="{DynamicResource PanelBackground}"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="ChangesHeading" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ChangesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Dot in its own column so a wrapped line lines up
                                 under the text rather than under the bullet. -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource Accent}"
                                           FontSize="12" Margin="0,0,7,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Says what upgrading actually involves, and answers the question that
             stops people doing it: replacing the folder looks like it throws
             the settings away with it. It does not — every save is mirrored to
             %APPDATA%, and a folder that arrives without a settings file
             restores from that copy on its first run. -->
        <TextBlock Grid.Row="2" Foreground="{DynamicResource TextDim}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,14">
            <Run Text="The releases page has the archive and the notes in full. This program does not update itself — just replace the folder and all the files in it with the new version, and run it from there."/>
            <LineBreak/><LineBreak/>
            <Run Text="You will not lose your settings. They live beside the executable, and a copy of them is also kept in your AppData folder — so a new folder that arrives without a settings file restores that copy the first time it runs. Shortcuts, naming tags, folders and hotkeys all come back."
                 Foreground="{DynamicResource ValueGreen}"/>
        </TextBlock>

        <!-- The way out of this notice sits in the notice, rather than only in
             a Settings tab the user would have to go looking for. The second
             sentence is there so turning it off does not feel permanent. -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBackground}" CornerRadius="6"
                Padding="12" Margin="0,0,0,14">
            <TextBlock Foreground="{DynamicResource TextDim}" FontSize="11" TextWrapping="Wrap">
                <Run Text="This check runs once each time the program starts."/>
                <LineBreak/>
                <Hyperlink x:Name="StopLink" Click="Stop_Click"
                           Foreground="{DynamicResource ValueYellow}"
                           ToolTip="Turns the startup check off and closes this window">
                    <Run Text="Stop checking for new versions"/>
                </Hyperlink>
                <Run Text=" — you can turn it back on at any time in Settings ▸ General ▸ Updates, or check by hand from Help ▸ Check for updates."/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Closed from code-behind, not by IsCancel. IsCancel closes a
                 window by setting DialogResult, and DialogResult only means
                 anything on a window shown with ShowDialog. This notice is
                 shown with Show() — see the class remarks for why it must not
                 block — so the cancel path silently did nothing and the button
                 was dead. Esc was dead with it, for the same reason.

                 IsCancel stays for the role it still carries: it marks this as
                 the dismissing button for automation and accessibility. It is
                 no longer what does the dismissing. -->
            <Button Content="Not now" Width="90" IsCancel="True" Click="NotNow_Click"/>
            <Button Content="Open the releases page" Click="Releases_Click" IsDefault="True"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
        </StackPanel>
    </Grid>
</Window>
