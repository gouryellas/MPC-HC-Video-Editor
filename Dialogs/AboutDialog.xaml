<Window x:Class="MpcHcVideoEditor.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MPC-HC Video Editor"
        Height="620" Width="560"
        MinHeight="420" MinWidth="460"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One version in the history, shut until asked.

             Templated rather than left to WPF's own Expander, which draws a
             circled chevron in system colours — the one piece of light
             chrome in a dark window, and the reason the scrollbars in this
             program are templated too.

             The arrow is a Path rotated by a trigger rather than two glyphs
             swapped, so it turns from pointing right to pointing down
             through the same shape. A character swap at this size reads as
             a flicker.

             The whole header is the button, not just the arrow: the target
             is then the width of the row, which is what anybody actually
             aims at. -->
        <Style x:Key="VersionExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Head"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Cursor="Hand"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Row" Background="Transparent"
                                                CornerRadius="4" Padding="6,5">
                                            <DockPanel LastChildFill="True">
                                                <Path x:Name="Arrow" DockPanel.Dock="Left"
                                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                                      Fill="{DynamicResource Accent}"
                                                      Width="8" Height="8"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,10,0"
                                                      RenderTransformOrigin="0.5,0.5"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource RowHover}"/>
                                            </Trigger>
                                            <!-- The whole transform, not an
                                                 Angle inside one: a trigger
                                                 cannot reach a name that
                                                 belongs to a Freezable
                                                 rather than to a template
                                                 child. -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>

                            <!-- Indented to the text of the header above it,
                                 so the notes read as belonging to that
                                 version rather than sitting between two. -->
                            <ContentPresenter x:Name="Body" Visibility="Collapsed"
                                              Margin="26,2,4,12"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The mark beside the name. Drawn at run time from the current
             theme's palette, like the window and tray icons, so the About box
             shows the icon the program is actually wearing rather than a
             picture of the one it shipped with. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image x:Name="Logo" Width="56" Height="56" Margin="0,0,14,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MPC-HC Video Editor" Foreground="{DynamicResource Accent}"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource ValueGreen}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDim}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="Bookmark, trim, merge, and split video from MPC-HC. Set bookmarks with a hotkey while you watch, then cut the result with ffmpeg."/>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Version history, first: it is the part of this window
                         anybody opens twice. The licensing below it is read
                         once, if ever, and does not move. -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Version history" Foreground="{DynamicResource Accent}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="HistoryCount" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel x:Name="VersionList" Margin="0,0,0,4"/>

                    <!-- Said only when there is nothing to say; filled in and
                         shown by the code behind. -->
                    <TextBlock x:Name="HistoryEmpty" Visibility="Collapsed"
                               Foreground="{DynamicResource TextMuted}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,2,0,8"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,0"/>

                    <TextBlock Text="License" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                               FontSize="13" Margin="0,14,0,6"/>
                    <TextBlock x:Name="LicenseText" Foreground="{DynamicResource TextDim}" FontSize="12"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Third-party components" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                               FontSize="13" Margin="0,14,0,6"/>
                    <TextBlock Foreground="{DynamicResource TextDim}" FontSize="12" TextWrapping="Wrap">
                        <Run Text="ffmpeg 9.0.1"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="Does all encoding, cutting and concatenation. Distributed with this application, in a build configured with --enable-gpl and --enable-version3 and therefore licensed under the GNU GPL v3 or later. The corresponding source and the scripts that produced these binaries are at github.com/BtbN/FFmpeg-Builds."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Media Player Classic - Home Cinema"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="The player this tool drives, via its web interface. GPL v3. Separately installed and separately licensed."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="CommunityToolkit.Mvvm"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="MVVM source generators. MIT license, © .NET Foundation and Contributors."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Microsoft.Xaml.Behaviors.Wpf"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="XAML behaviors. MIT license, © Microsoft Corporation."/>
                        <LineBreak/><LineBreak/>
                        <Run Text=".NET and WPF"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="MIT license, © Microsoft Corporation."/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="GitHub repository" Click="Repo_Click"
                    ToolTip="https://github.com/gouryellas/MPC-HC-Video-Editor"/>
            <!-- IsCancel closes the dialog by itself; Esc and Enter both land
                 here, which is the whole interaction this window needs. -->
            <Button Content="Close" Width="90" IsDefault="True" IsCancel="True"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}" Foreground="{DynamicResource OnAccent}"/>
        </StackPanel>
    </Grid>
</Window>
