<Window x:Class="MpcHcVideoEditor.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MPC-HC Video Editor"
        Height="440" Width="480"
        MinHeight="380" MinWidth="420"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="MPC-HC Video Editor" Foreground="{DynamicResource Accent}"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource ValueGreen}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDim}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="Bookmark, trim, merge and split video straight from MPC-HC. Set timestamps with a hotkey while you watch, then cut the result with ffmpeg."/>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Licence" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LicenseText" Foreground="{DynamicResource TextDim}" FontSize="11"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Third-party components" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                               FontSize="13" Margin="0,14,0,6"/>
                    <TextBlock Foreground="{DynamicResource TextDim}" FontSize="11" TextWrapping="Wrap">
                        <Run Text="ffmpeg 9.0.1"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="Does all encoding, cutting and concatenation. Distributed with this application, in a build configured with --enable-gpl and --enable-version3 and therefore licensed under the GNU GPL v3 or later. The corresponding source and the scripts that produced these binaries are at github.com/BtbN/FFmpeg-Builds."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Media Player Classic - Home Cinema"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="The player this tool drives, via its web interface. GPL v3. Separately installed and separately licensed."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="CommunityToolkit.Mvvm"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="MVVM source generators. MIT licence, © .NET Foundation and Contributors."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Microsoft.Xaml.Behaviors.Wpf"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="XAML behaviours. MIT licence, © Microsoft Corporation."/>
                        <LineBreak/><LineBreak/>
                        <Run Text=".NET and WPF"  Foreground="{DynamicResource ValueYellow}"/><LineBreak/>
                        <Run Text="MIT licence, © Microsoft Corporation."/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="GitHub repository" Click="Repo_Click"
                    ToolTip="https://github.com/gouryellas/MPC-HC-Video-Editor"/>
            <!-- IsCancel closes the dialog by itself; Esc and Enter both land
                 here, which is the whole interaction this window needs. -->
            <Button Content="Close" Width="90" IsDefault="True" IsCancel="True"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}" Foreground="{DynamicResource OnAccent}"/>
        </StackPanel>
    </Grid>
</Window>
