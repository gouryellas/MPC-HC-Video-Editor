<Window x:Class="MpcHcVideoEditor.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" MinHeight="160" Width="380" MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ControlBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!-- SizeToContent above, rather than a fixed 160px height: the prompt
         wraps and can run to several lines (the add-to-playlist prompt lists
         up to 12 names, and a rejected time now explains the accepted
         formats), which pushed the OK/Cancel row off the bottom edge. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Foreground="{DynamicResource TextDim}" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox Grid.Row="1" x:Name="InputBox" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderBrush}" Padding="6" FontSize="14"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="4" IsDefault="True" Click="Ok_Click" Background="{DynamicResource PrimaryButton}" Foreground="{DynamicResource OnAccent}" Padding="8,4"/>
            <Button Content="Cancel" Width="80" Margin="4" IsCancel="True" Click="Cancel_Click" Padding="8,4"/>
        </StackPanel>
    </Grid>
</Window>
