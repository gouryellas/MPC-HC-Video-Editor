<Window x:Class="MpcHcVideoEditor.Dialogs.ThumbnailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:MpcHcVideoEditor.Dialogs"
        Title="Save thumbnails" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OptionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="HOW OFTEN" Style="{StaticResource Heading}"/>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="A frame every" Style="{StaticResource Label}" Margin="0,0,8,0"/>
            <TextBox x:Name="EverySecondsBox" Width="64" TextChanged="Input_Changed"/>
            <TextBlock Text="seconds" Style="{StaticResource Label}" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="CountNote" Style="{StaticResource OptionNote}" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Each one" Style="{StaticResource Label}" Margin="0,0,8,0"/>
            <TextBox x:Name="WidthBox" Width="64" TextChanged="Input_Changed"/>
            <TextBlock Text="pixels wide" Style="{StaticResource Label}" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock Text="WHAT TO WRITE" Style="{StaticResource Heading}" Margin="0,18,0,8"/>

        <RadioButton x:Name="SeparateFiles" GroupName="Layout" IsChecked="True" Checked="Layout_Changed">
            <StackPanel>
                <TextBlock Text="A picture for each frame"/>
                <TextBlock Style="{StaticResource OptionNote}"
                           Text="Numbered PNGs in order, so you can keep the ones you want and throw the rest away."/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="ContactSheet" GroupName="Layout" Checked="Layout_Changed">
            <StackPanel>
                <TextBlock Text="One sheet of them all"/>
                <TextBlock Style="{StaticResource OptionNote}"
                           Text="Every frame tiled into a single picture, the way MPC-HC's own thumbnails look. A video with more frames than fit starts another sheet."/>
                <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
                    <TextBox x:Name="ColumnsBox" Width="48" TextChanged="Input_Changed"/>
                    <TextBlock Text="across" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </RadioButton>

        <dialogs:OutputFolderPicker x:Name="Where" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Continue" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
