<Window x:Class="MpcHcVideoEditor.Dialogs.StripAudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strip audio" SizeToContent="Height" MinHeight="300" Width="470"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- The option itself, with its explanation beneath it. The two are one
             click target: the description says what lands on disk, and having
             to hit the eight-pixel circle to choose it would be the wrong
             place to make the user aim. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OptionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="What should this produce?" Foreground="{DynamicResource Accent}"
                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="AudioOnly" GroupName="Output" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="The audio only"/>
                    <TextBlock x:Name="AudioHint" Style="{StaticResource OptionNote}" Margin="0,2,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="VideoOnly" GroupName="Output">
                <StackPanel>
                    <TextBlock Text="The video only, with its sound removed"/>
                    <TextBlock x:Name="VideoHint" Style="{StaticResource OptionNote}" Margin="0,2,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="Both" GroupName="Output">
                <StackPanel>
                    <TextBlock Text="Both"/>
                    <TextBlock Text="Two files: the audio, and the silent video."
                               Style="{StaticResource OptionNote}" Margin="0,2,0,0"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- Stated on the dialog rather than left to be discovered. "Strip" can
             be read as something done to the file you picked, and the one
             setting that does delete it lives three tabs into Settings. -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="4"
                Padding="10,8" Margin="0,6,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="11">
                <Run Text="The file you pick is never changed — every option above writes new files beside it."/>
                <LineBreak/>
                <Run Text="It is deleted afterwards only if you have asked for that under Settings ▸ Cleanup."/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Continue" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
