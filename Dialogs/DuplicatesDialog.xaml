<Window x:Class="MpcHcVideoEditor.Dialogs.DuplicatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find duplicates"
        Height="640" Width="860"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        </Style>

        <!-- Templated rather than left to the default chrome, which paints a
             disabled button in system colours — a near-white block in a dark
             window, which is how "Delete checked" looked before anything was
             checked. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <!-- Dimmed in place rather than recoloured by the
                                 system: a disabled button should read as the
                                 same button, unavailable. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource ControlBackground}"/>
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- What to scan. The folder sits on its own line because a path is
             long and the two switches beside it are short. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Folder" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>

            <Border Grid.Column="1" Background="{DynamicResource InsetBackground}"
                    CornerRadius="4" Padding="8,6">
                <TextBlock x:Name="FolderText" Text="No folder chosen"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ValueGreen}"/>
            </Border>

            <Button Grid.Column="2" Content="Choose…" Click="ChooseFolder_Click"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="RecurseCheck" IsChecked="True" VerticalAlignment="Center"
                      Content="Include subfolders"
                      Foreground="{DynamicResource TextBody}"/>

            <!-- Off by default. The exact pass is instant and certain; this
                 one decodes every candidate and can only ever be a strong
                 suggestion, so it is asked for rather than assumed. -->
            <CheckBox x:Name="FootageCheck" VerticalAlignment="Center" Margin="18,0,0,0"
                      Content="Also look for the same footage re-encoded"
                      Foreground="{DynamicResource TextBody}"
                      ToolTip="Compares sampled frames, so a clip saved at another size or bitrate still matches. Much slower — it decodes each file."/>

            <Button Content="Scan" Click="Scan_Click" Margin="18,0,0,0"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- Progress, and the one line that says what is happening. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10"
              x:Name="ProgressArea" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100"
                         Background="{DynamicResource InsetBackground}"
                         Foreground="{DynamicResource Accent}" BorderThickness="0"
                         VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="StageText" Margin="10,0,0,0"
                       Style="{StaticResource Quiet}" VerticalAlignment="Center"/>
        </Grid>

        <!-- The footer. Built before the list so it is never pushed off the
             bottom by a long set of results. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>

            <Button DockPanel.Dock="Right" Content="Close" Width="90"
                    IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="DeleteButton"
                    Content="Delete checked" Click="Delete_Click" IsEnabled="False"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button DockPanel.Dock="Right" Content="Check all but the largest"
                    Click="CheckAllButLargest_Click"
                    ToolTip="In every group, checks every copy except the biggest one."/>
            <Button DockPanel.Dock="Right" Content="Clear checks" Click="ClearChecks_Click"/>
        </DockPanel>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="2">
            <Grid>
                <!-- Said when there is nothing to show, which covers both
                     "not scanned yet" and "scanned, found none". -->
                <TextBlock x:Name="EmptyText" Margin="14"
                           TextWrapping="Wrap" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Choose a folder and press Scan."/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="GroupList" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10,8"
                                        Background="{DynamicResource InsetBackground}"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding Heading}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{Binding HeadingBrush}"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Recoverable}"
                                                       Style="{StaticResource Quiet}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"/>

                                                        <StackPanel Grid.Column="1">
                                                            <!-- Foreground stated rather than
                                                                 inherited: inside a template the
                                                                 row would otherwise pick up the
                                                                 ItemsControl's, which is not the
                                                                 colour body text wants. -->
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}"/>
                                                            <TextBlock Text="{Binding Folder}"
                                                                       Style="{StaticResource Quiet}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Path}"/>
                                                        </StackPanel>

                                                        <!-- Marks the one a
                                                             "keep the best"
                                                             rule would keep. -->
                                                        <TextBlock Grid.Column="2" Text="largest"
                                                                   Margin="10,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource ValueGreen}"
                                                                   Visibility="{Binding LargestVisibility}"/>

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Size}"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
