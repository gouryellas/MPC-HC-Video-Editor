<Window x:Class="MpcHcVideoEditor.Dialogs.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File exists" SizeToContent="Height" MinHeight="200" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ControlBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="This file already exists:" Foreground="{DynamicResource TextDim}" Margin="0,0,0,8"/>
        <!-- The name, then the folder it is already in. "This file exists" is
             not a complete statement without saying where — and Overwrite is
             about to replace whatever is sitting there. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="FileNameText" Foreground="{DynamicResource StatusError}" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <!-- Trimmed, not wrapped: a deep path would take three lines in a
                 480-wide dialog. The whole path is on the tooltip. -->
            <TextBlock x:Name="FolderText" Foreground="{DynamicResource TextSecondary}"
                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="IncrementHint" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   FontStyle="Italic" VerticalAlignment="Top"/>

        <!-- The checkbox gets a row of its own rather than sharing one with the
             buttons. Side by side they overlapped: four buttons need most of a
             480-wide window, and the label was printed underneath them. -->
        <StackPanel Grid.Row="3">
            <!-- Applies to Overwrite and Increment only: those repeat cleanly
                 on any later file, whereas a name typed into Rename cannot be
                 reused without colliding. -->
            <CheckBox x:Name="ApplyToAllCheck" HorizontalAlignment="Left" Margin="0,0,0,8"
                      Foreground="{DynamicResource TextDim}" Visibility="Collapsed"
                      ToolTip="Applies to Overwrite and Increment. Rename always asks, since a typed name cannot repeat."
                      Content="Do this for all remaining files"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Overwrite" Width="90" Margin="4" Click="Overwrite_Click" Background="{DynamicResource PrimaryButton}" Foreground="{DynamicResource OnAccent}" Padding="8,4"/>
                <Button Content="Increment" Width="90" Margin="4" Click="Increment_Click" Padding="8,4"/>
                <Button Content="Rename…" Width="90" Margin="4" Click="Rename_Click" Padding="8,4"/>
                <Button Content="Cancel" Width="80" Margin="4" Click="Cancel_Click" Padding="8,4"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
