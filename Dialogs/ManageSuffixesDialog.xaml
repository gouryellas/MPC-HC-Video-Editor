<Window x:Class="MpcHcVideoEditor.Dialogs.ManageSuffixesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MpcHcVideoEditor.Models"
        Title="Manage Suffixes"
        Height="440" Width="520"
        MinHeight="360" MinWidth="440"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#999" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Filename suffixes are appended to all video outputs as [suffix].&#x0a;Drag rows to reorder. Double-click to rename. Letters and numbers only, max 50 chars."/>

        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="6" Margin="0,0,0,10">
            <ListBox x:Name="SuffixList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#DDDDDD"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="List_PreviewMouseMove"
                     DragOver="List_DragOver"
                     Drop="List_Drop"
                     MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#094771"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2D2E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SuffixEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="#666"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="Drag to reorder"/>
                            <TextBlock Grid.Column="1" Text="{Binding Display}"
                                       Foreground="#4EC9B0" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyHint" Grid.Row="1"
                   Text="No suffixes yet. Click Add… below to add one."
                   Foreground="#777" FontSize="12" FontStyle="Italic"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Add…" Click="Add_Click"/>
            <Button Content="Rename…" Click="Rename_Click"/>
            <Button Content="Remove" Click="Remove_Click"/>
            <Rectangle Width="12"/>
            <Button Content="↑ Up" Click="Up_Click" Width="60"/>
            <Button Content="↓ Down" Click="Down_Click" Width="60"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Done" Width="90" IsDefault="True" Click="Done_Click"
                    Background="#0E639C" BorderBrush="#1177BB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
