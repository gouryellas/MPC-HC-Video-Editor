<Window x:Class="MpcHcVideoEditor.Dialogs.ExportAnimationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export as animation" SizeToContent="Height" MinHeight="340" Width="470"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="OptionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" Foreground="{DynamicResource Accent}"
                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="FormatGif" GroupName="Format" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="GIF"/>
                    <TextBlock Style="{StaticResource OptionNote}"
                               Text="Plays in anything, including places that accept nothing else. 256 colors and no real transparency, and several times the size of the same clip as WebP."/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="FormatWebp" GroupName="Format">
                <StackPanel>
                    <TextBlock Text="Animated WebP"/>
                    <!-- Names image viewers specifically. "Some older tools"
                         was true and useless: the thing that actually happens
                         is a desktop viewer opening the file and reporting it
                         as unreadable, which reads as a broken export rather
                         than a format it does not handle. -->
                    <TextBlock Style="{StaticResource OptionNote}"
                               Text="A fraction of the size, full color and real transparency. Every current browser reads it, and so does Windows Photos. Image viewers are the catch — plenty of them show a still WebP but cannot play an animated one, and say the file could not be read rather than saying that."/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="4"
                Padding="10,8" Margin="0,4,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Frames a second" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBody}" Margin="0,0,8,0"/>
                    <TextBox x:Name="FpsBox" Width="52"/>
                    <TextBlock Text="Width" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBody}" Margin="18,0,8,0"/>
                    <TextBox x:Name="WidthBox" Width="62"/>
                    <TextBlock Text="px" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBody}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource OptionNote}" Margin="0,8,0,0"
                           Text="These two decide the size of the file more than anything else does. 15 frames a second and 480 pixels wide is the usual compromise; the height follows the shape of the picture. A width of 0 keeps the frame as it is."/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="AppliedNote" Style="{StaticResource OptionNote}" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Export" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
