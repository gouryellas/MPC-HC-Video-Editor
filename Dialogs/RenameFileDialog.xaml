<Window x:Class="MpcHcVideoEditor.Dialogs.RenameFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename output file" SizeToContent="Height" MinHeight="290" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ControlBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ReasonText" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" x:Name="OriginalText" Foreground="{DynamicResource StatusError}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBox Grid.Row="2" x:Name="NameBox"
                 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderBrush}" Padding="6,4" FontSize="14"
                 PreviewTextInput="NameBox_PreviewTextInput"
                 TextChanged="NameBox_TextChanged"/>

        <!-- The name and the folder together, because either alone leaves the
             question half answered: "saves as" without a folder does not say
             where, and a run that writes into a quick-save folder rather than
             beside the video is exactly when that matters.

             One row holding both, so neither has to be renumbered to sit under
             the other. -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="PreviewText" Foreground="{DynamicResource Accent}"
                       TextWrapping="Wrap"/>
            <!-- Trimmed rather than wrapped: a deep path would otherwise take
                 three lines and push the buttons off a fixed-width dialog. The
                 whole path is on the tooltip. -->
            <TextBlock x:Name="FolderText" Foreground="{DynamicResource TextSecondary}"
                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="MessageText" Foreground="{DynamicResource ValueYellow}"
                   TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top"/>

        <!-- Above the buttons rather than beside them: the three of them plus
             the label are wider than the window, so sharing a row printed one
             on top of the other. -->
        <StackPanel Grid.Row="5">
            <!-- Hidden when only one file is being processed, where
                 "remaining" means nothing. -->
            <CheckBox x:Name="ApplyToAllCheck" HorizontalAlignment="Left" Margin="0,0,0,8"
                      Foreground="{DynamicResource TextDim}" Visibility="Collapsed"
                      ToolTip="Silently apply the suggested correction to every later file that breaks the rules"
                      Content="Do this for all remaining files"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Use suggested" Width="120" Margin="4" Click="Suggested_Click" Padding="8,4"/>
                <Button Content="OK" Width="90" Margin="4" Click="Ok_Click"
                        Background="{DynamicResource PrimaryButton}" Foreground="{DynamicResource OnAccent}" Padding="8,4"/>
                <Button Content="Cancel" Width="80" Margin="4" Click="Cancel_Click" Padding="8,4"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
