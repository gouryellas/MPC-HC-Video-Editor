<Window x:Class="MpcHcVideoEditor.Dialogs.DriveSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a drive to search"
        Height="420" Width="470"
        MinHeight="340" MinWidth="400"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Same reason as the scan window: the stock chrome paints its own
                 near-white fill when disabled and ignores the Background it was
                 given, so Search greys into illegibility with nothing picked. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextSecondary}"/>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="6">
            <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextBody}"
                     MouseDoubleClick="DriveList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- The letter is how a drive is identified, so it
                                 leads and is the only monospaced thing here:
                                 "C:\" and "H:\" line up under each other. -->
                            <TextBlock Text="{Binding Root}" FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" MinWidth="42"/>

                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Space}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- A drive is the answer when a disk came back on a different letter.
             When the files moved rather than the letter changing, pointing at
             the folder they moved into is quicker — and that is what this
             command used to do, so the escape hatch stays. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Pick a folder instead…" HorizontalAlignment="Left" Margin="0"
                    Click="Folder_Click"
                    />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SearchButton" Content="Use this drive" Click="Search_Click" IsEnabled="False"
                        Background="{DynamicResource PrimaryButton}"
                        BorderBrush="{DynamicResource PrimaryButtonBorder}"
                        Foreground="{DynamicResource OnAccent}"/>
                <Button Content="Cancel" IsCancel="True" Width="90"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
