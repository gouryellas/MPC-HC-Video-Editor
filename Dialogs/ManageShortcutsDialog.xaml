<Window x:Class="MpcHcVideoEditor.Dialogs.ManageShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MpcHcVideoEditor.Models"
        Title="Manage Shortcuts"
        Height="440" Width="560"
        MinHeight="360" MinWidth="480"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Drag a row up or down to reorder. Double-click a row to rename."
                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- ListBox of shortcuts. Drag-reorderable; double-click to rename. -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="6" Margin="0,0,0,10">
            <ListBox x:Name="ShortcutList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextBody}"
                     AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="List_PreviewMouseMove"
                     DragOver="List_DragOver"
                     Drop="List_Drop"
                     MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowSelected}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ShortcutEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="Drag to reorder"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyHint" Grid.Row="1"
                   Text="No shortcuts yet. Click Add… below to add one."
                   Foreground="{DynamicResource TextMuted}" FontSize="12" FontStyle="Italic"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Add…" Click="Add_Click"/>
            <Button Content="Rename…" Click="Rename_Click"/>
            <Button Content="Remove" Click="Remove_Click"/>
            <Rectangle Width="12"/>
            <Button Content="↑ Up" Click="Up_Click" Width="60"/>
            <Button Content="↓ Down" Click="Down_Click" Width="60"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Done" Width="90" IsDefault="True" Click="Done_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}" Foreground="{DynamicResource OnAccent}"/>
        </StackPanel>
    </Grid>
</Window>
