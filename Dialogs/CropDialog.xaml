<Window x:Class="MpcHcVideoEditor.Dialogs.CropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- The shape buttons. Checked rather than clicked: the chosen shape
             holds for every drag until another is chosen. -->
        <Style TargetType="RadioButton" x:Key="Shape">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="DRAG A BOX ON THE PICTURE" Style="{StaticResource Heading}"/>

        <!-- Sized in code to the frame's own shape, so the overlay and the
             picture share one coordinate space and a fraction of the box is a
             fraction of the frame. -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Left">
            <Grid x:Name="Stage" Background="#FF101010"
                  MouseLeftButtonDown="Stage_MouseDown"
                  MouseMove="Stage_MouseMove"
                  MouseLeftButtonUp="Stage_MouseUp"
                  MouseLeave="Stage_MouseUp">
                <Image x:Name="Frame" Stretch="Fill"/>

                <!-- Everything outside the box, dimmed. One path with two
                     rectangles and an even-odd fill, rather than four borders
                     that have to be kept in step with each other. -->
                <Path x:Name="Shade" Fill="#A6000000" IsHitTestVisible="False"/>

                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Rectangle x:Name="Box" Stroke="{DynamicResource AccentBright}" StrokeThickness="2"/>

                    <Rectangle x:Name="HandleTL" Width="10" Height="10" Fill="{DynamicResource AccentBright}"/>
                    <Rectangle x:Name="HandleTR" Width="10" Height="10" Fill="{DynamicResource AccentBright}"/>
                    <Rectangle x:Name="HandleBL" Width="10" Height="10" Fill="{DynamicResource AccentBright}"/>
                    <Rectangle x:Name="HandleBR" Width="10" Height="10" Fill="{DynamicResource AccentBright}"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Shape" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextSecondary}"/>
                <RadioButton x:Name="ShapeFree" GroupName="Shape" Content="Free" IsChecked="True"
                             Style="{StaticResource Shape}" Checked="Shape_Changed"/>
                <RadioButton x:Name="Shape169" GroupName="Shape" Content="16:9"
                             Style="{StaticResource Shape}" Checked="Shape_Changed"/>
                <RadioButton x:Name="Shape916" GroupName="Shape" Content="9:16"
                             Style="{StaticResource Shape}" Checked="Shape_Changed"/>
                <RadioButton x:Name="Shape11" GroupName="Shape" Content="1:1"
                             Style="{StaticResource Shape}" Checked="Shape_Changed"/>
                <RadioButton x:Name="Shape43" GroupName="Shape" Content="4:3"
                             Style="{StaticResource Shape}" Checked="Shape_Changed"/>
            </StackPanel>

            <TextBlock x:Name="SizeNote" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas"/>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Button Content="Whole frame" Click="Reset_Click" HorizontalAlignment="Left" Margin="0,4,4,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Width="90" IsDefault="True" Click="Ok_Click"
                        Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                        Foreground="{DynamicResource OnAccent}"/>
                <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
