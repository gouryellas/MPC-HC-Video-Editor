<Window x:Class="MpcHcVideoEditor.Dialogs.RuleTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test rule"
        Height="520" Width="760"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="RuleText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Accent}"/>
            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Run against the files in the folder set in the rename window, using every word list and rule as they stand there — including anything typed but not yet saved. Nothing is renamed."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

            <Button DockPanel.Dock="Right" Content="Close" Width="90"
                    IsCancel="True" IsDefault="True"/>
        </DockPanel>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="4">
            <Grid>
                <TextBlock x:Name="EmptyText" Margin="14" TextWrapping="Wrap"
                           VerticalAlignment="Top" Visibility="Collapsed"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Nothing here is changed by this rule. The files may still be renamed by the character rules or by another rule — this list is only what this one does."/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultList" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="4"
                                        Background="{DynamicResource InsetBackground}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Original}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="&#x2192;"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{Binding Result}"
                                                       FontFamily="Consolas" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ValueGreen}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
