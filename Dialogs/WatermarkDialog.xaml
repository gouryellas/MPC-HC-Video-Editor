<Window x:Class="MpcHcVideoEditor.Dialogs.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add watermark" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="What goes on the picture?" Style="{StaticResource Heading}"/>

        <RadioButton x:Name="UseText" GroupName="Kind" IsChecked="True" Checked="Kind_Changed">
            <DockPanel Width="400">
                <TextBlock Text="Text" Width="52" VerticalAlignment="Center"/>
                <TextBox x:Name="MarkTextBox" GotKeyboardFocus="Text_Focused"/>
            </DockPanel>
        </RadioButton>

        <RadioButton x:Name="UseImage" GroupName="Kind" Checked="Kind_Changed">
            <DockPanel Width="400">
                <TextBlock Text="Image" Width="52" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="6,0,0,0" Padding="10,2"/>
                <Border Background="{DynamicResource InsetBackground}" CornerRadius="4" Padding="6,3">
                    <TextBlock x:Name="ImageText" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondary}" Text="No image chosen"/>
                </Border>
            </DockPanel>
        </RadioButton>

        <TextBlock Text="Where?" Style="{StaticResource Heading}" Margin="0,12,0,8"/>

        <!-- Laid out as the picture is, so the choice reads as a place
             rather than as a list of words. -->
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RadioButton x:Name="TopLeft" GroupName="Where" Content="Top left"/>
            <RadioButton x:Name="TopRight" Grid.Column="2" GroupName="Where" Content="Top right"/>
            <RadioButton x:Name="Center" Grid.Row="1" Grid.Column="1" GroupName="Where" Content="Center"/>
            <RadioButton x:Name="BottomLeft" Grid.Row="2" GroupName="Where" Content="Bottom left"/>
            <RadioButton x:Name="BottomRight" Grid.Row="2" Grid.Column="2" GroupName="Where" Content="Bottom right"/>
        </Grid>

        <TextBlock Text="How big?" Style="{StaticResource Heading}" Margin="0,12,0,8"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Size" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="SizeBox" Width="60"/>
                <TextBlock x:Name="SizeUnit" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Opacity" Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="OpacityBox" Width="60"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="4"
                Padding="10,8" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                       Text="Sizes are a share of the picture, so one setting suits files of any size. Every file you picked gets the same mark, and is written as a new copy in your output format — the originals are not changed."/>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ValueRed}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Continue" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
