<Window x:Class="MpcHcVideoEditor.Dialogs.CaptureHotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Timestamp Hotkey"
        SizeToContent="Height" Width="420" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The whole dialog captures. It arms itself on open, so the field
             below is already live when it appears — press the key or button
             you want, watch it update, then click OK. -->
        <TextBlock Grid.Row="0" x:Name="PromptText" Foreground="#CCCCCC"
                   Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="Listening — press any key, key combination, or mouse button."/>

        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#0E639C" BorderThickness="2"
                CornerRadius="4" Padding="14,18" Margin="0,0,0,10">
            <TextBlock x:Name="CapturedText" Text="…"
                       Foreground="#4EC9B0" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>

        <TextBlock Grid.Row="2" Foreground="#666666" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="Middle and side mouse buttons work too. Click OK to set it."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Disable hotkey" Width="120" Margin="4" Padding="8,4" Click="Disable_Click"/>
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="4" Padding="8,4" Click="Ok_Click"
                    Background="#0E639C" Foreground="White"/>
            <Button Content="Cancel" Width="80" Margin="4" Padding="8,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
