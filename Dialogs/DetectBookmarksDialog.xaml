<Window x:Class="MpcHcVideoEditor.Dialogs.DetectBookmarksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan for cuts"
        Height="600" Width="660"
        MinHeight="460" MinWidth="560"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- The stock chrome ignores Background and paints its own
                 near-white fill when disabled, which turned the two accent
                 buttons into blank white rectangles the moment a scan started:
                 white text on white. This template honours the colours it is
                 given in every state, so a disabled button still reads as the
                 button it was. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <!-- Dimmed enough to read as unavailable, not so
                                 far that the label goes with it. -->
                            <!-- Unclickable, and nothing more. A button that
                                 fades to say it is unavailable is a button
                                 made hard to read at the moment somebody is
                                 trying to work out why. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- The rail's parts, matched to the rename and duplicates
             windows: same headings, same sizes, same order. -->
        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RailCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Pale, matching the other two rails. Its own template with no
             triggers: this window's base button dims on hover, and these
             hold one colour throughout. -->
        <Style x:Key="RailButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#C2C2C2"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A number the rail asks for: its own caption above it, because
             three of these stacked need telling apart. -->
        <Style x:Key="RailFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- The video, and the one button that acts on it. Scan sits where
             the other two windows put it: at the end of the line naming
             what is about to be read. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Video" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>

            <Border Grid.Column="1" Background="{DynamicResource InsetBackground}"
                    CornerRadius="4" Padding="8,6">
                <TextBlock x:Name="VideoText" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ValueGreen}"/>
            </Border>

            <!-- One button with two jobs, never both at once. Theme's own
                 colour to start a scan, red to stop one. -->
            <Button Grid.Column="2" x:Name="ScanButton" Content="Scan" Click="Scan_Click"
                    MinWidth="78"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
        </Grid>

        <!-- The stage under way and how far through the video it is, then
             the finished line in the same place. The stage keeps a fixed
             slot so its moving dots cannot shuffle the figures beside
             them. -->
        <DockPanel DockPanel.Dock="Top" x:Name="ProgressPanel" Visibility="Collapsed"
                   Margin="0,0,0,10" LastChildFill="False">
            <TextBlock x:Name="StageText" DockPanel.Dock="Left" Width="158" FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Accent}"/>

            <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" FontSize="13"
                       Foreground="{DynamicResource Accent}"/>

            <TextBlock x:Name="InfoText" DockPanel.Dock="Left" FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Accent}"/>
        </DockPanel>

        <!-- The footer: what this window commits, on the left. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" x:Name="UseButton" Content="Use selected"
                    Click="Use_Click" IsEnabled="False" Margin="0"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>

            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True"
                    Style="{StaticResource CloseButton}"/>
        </DockPanel>

        <!-- The rail. Scrolled, because this window asks for more than the
             other two and a short window should still reach the bottom
             of it. -->
        <Border DockPanel.Dock="Left" Width="158" Margin="0,0,10,0"
                Background="{DynamicResource PanelBackground}"
                CornerRadius="6" Padding="10,9">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Named short here, with the long version in the hint
                         below: the rail is a column, and a sentence per
                         radio button would wrap three times. -->
                    <TextBlock Text="Find" Style="{StaticResource RailLabel}"/>

                    <RadioButton x:Name="ModeSilence" GroupName="Mode" IsChecked="True"
                                 Content="Silence" FontSize="12" Checked="Mode_Changed"/>
                    <RadioButton x:Name="ModeBlack" GroupName="Mode"
                                 Content="Black frames" FontSize="12" Checked="Mode_Changed"/>
                    <RadioButton x:Name="ModeScene" GroupName="Mode"
                                 Content="Scene changes" FontSize="12" Checked="Mode_Changed"/>

                    <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" FontSize="11"/>

                    <TextBlock Text="Limits" Style="{StaticResource RailLabel}"
                               Margin="0,14,0,5"/>

                    <TextBlock x:Name="ThresholdLabel" Text="Threshold"
                               Style="{StaticResource RailFieldLabel}"/>
                    <TextBox x:Name="ThresholdBox" Margin="0,0,0,6"/>

                    <TextBlock x:Name="GapLabel" Text="Min gap (s)"
                               Style="{StaticResource RailFieldLabel}"/>
                    <TextBox x:Name="GapBox" Margin="0,0,0,6"/>

                    <TextBlock Text="Min clip (s)" Style="{StaticResource RailFieldLabel}"/>
                    <TextBox x:Name="MinClipBox"/>

                    <TextBlock x:Name="ThresholdHint" Style="{StaticResource Hint}" FontSize="11"/>

                    <TextBlock Text="Select" Style="{StaticResource RailLabel}"
                               Margin="0,14,0,5"/>

                    <Button Content="All" Click="SelectAll_Click"
                            Style="{StaticResource RailButton}"/>
                    <Button Content="None" Click="SelectNone_Click"
                            Style="{StaticResource RailButton}"/>

                    <TextBlock Text="Apply" Style="{StaticResource RailLabel}"
                               Margin="0,14,0,5"/>

                    <CheckBox x:Name="ReplaceCheck" IsChecked="True"
                              Style="{StaticResource RailCheck}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Replace existing" VerticalAlignment="Center"
                                       FontSize="12"/>
                            <ContentControl Style="{StaticResource Qmhp}">
                                <ContentControl.ToolTip>
                                    <TextBlock MaxWidth="330" TextWrapping="Wrap"
                                               Text="The clips you accept replace the bookmarks currently loaded. With this off they are added to them instead."/>
                                </ContentControl.ToolTip>
                            </ContentControl>
                        </StackPanel>
                    </CheckBox>

                    <!-- Offered here because here is where the points come
                         from. The seekbar's own menu carries the same
                         switch, but only once a scan has produced
                         something for it to act on. -->
                    <CheckBox x:Name="SnapCheck" Style="{StaticResource RailCheck}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Snap brackets" VerticalAlignment="Center"
                                       FontSize="12"/>
                            <ContentControl Style="{StaticResource Qmhp}">
                                <ContentControl.ToolTip>
                                    <TextBlock MaxWidth="330" TextWrapping="Wrap"
                                               Text="Every place this scan found the video changing is marked along the foot of the seekbar. With this on, a bracket dragged near one of those marks lands exactly on it — hold Alt while dragging to ignore them. It lasts as long as the marks do: opening another video clears both."/>
                                </ContentControl.ToolTip>
                            </ContentControl>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Proposals are a starting point, never applied on their own.
             Detection on real footage is a good first guess, and the user
             unticking the wrong ones is the whole workflow. -->
        <Border Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="2">
            <Grid>
                <TextBlock x:Name="EmptyText" Margin="14"
                           TextWrapping="Wrap" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Press Scan to look for cuts."/>

                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                         Margin="6"
                         Foreground="{DynamicResource TextBody}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Use, Mode=TwoWay}" Content="{Binding Display}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</Window>
