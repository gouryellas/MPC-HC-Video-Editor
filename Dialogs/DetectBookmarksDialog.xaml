<Window x:Class="MpcHcVideoEditor.Dialogs.DetectBookmarksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan for cuts"
        Height="560" Width="520"
        MinHeight="460" MinWidth="460"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- The stock chrome ignores Background and paints its own
                 near-white fill when disabled, which turned the two accent
                 buttons into blank white rectangles the moment a scan started:
                 white text on white. This template honours the colours it is
                 given in every state, so a disabled button still reads as the
                 button it was. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <!-- Dimmed enough to read as unavailable, not so
                                 far that the label goes with it. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What marks the end of a clip?" Style="{StaticResource Heading}"/>
                <RadioButton x:Name="ModeSilence" GroupName="Mode" IsChecked="True"
                             Content="Silence — for anything speech-driven"
                             Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeBlack" GroupName="Mode"
                             Content="Black frames — for recordings that fade between segments"
                             Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeScene" GroupName="Mode"
                             Content="Scene changes — for edited footage with hard cuts"
                             Checked="Mode_Changed"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="ThresholdLabel" Text="Threshold" FontSize="12"/>
                        <TextBox x:Name="ThresholdBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Min gap (s)" FontSize="12"/>
                        <TextBox x:Name="GapBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Min clip (s)" FontSize="12"/>
                        <TextBox x:Name="MinClipBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ThresholdHint" Style="{StaticResource Hint}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ScanButton" Content="Scan video" Click="Scan_Click"
                    Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}" Foreground="{DynamicResource OnAccent}" Margin="0"/>
            <TextBlock x:Name="ScanStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextSecondary}" Text="Nothing scanned yet."/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="8">
            <DockPanel>
                <!-- Proposals are a starting point, never applied on their own.
                     Detection on real footage is a good first guess, and the
                     user unticking the wrong ones is the whole workflow. -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                    <TextBlock x:Name="ResultsHeading" Text="Proposed clips" Style="{StaticResource Heading}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="All" Click="SelectAll_Click" Padding="8,2"/>
                        <Button Content="None" Click="SelectNone_Click" Padding="8,2"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBody}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Use, Mode=TwoWay}" Content="{Binding Display}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="ReplaceCheck" IsChecked="True"
                      Content="Replace the bookmarks currently loaded"/>

            <!-- Offered here because here is where the points come from. The
                 seekbar's own menu carries the same switch, but only once a
                 scan has produced something for it to act on. -->
            <CheckBox x:Name="SnapCheck" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Snap brackets to the points found"
                               VerticalAlignment="Center"/>
                    <Border Margin="8,0,0,0" Width="14" Height="14"
                            CornerRadius="7" VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{DynamicResource TextMuted}"
                            BorderThickness="1">
                        <Border.ToolTip>
                            <TextBlock MaxWidth="330" TextWrapping="Wrap"
                                       Text="Every place this scan found the video changing is marked along the foot of the seekbar. With this on, a bracket dragged near one of those marks lands exactly on it — hold Alt while dragging to ignore them. It lasts as long as the marks do: opening another video clears both."/>
                        </Border.ToolTip>
                        <TextBlock Text="?" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </Border>
                </StackPanel>
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="UseButton" Content="Use selected" Click="Use_Click" IsEnabled="False"
                        Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}" Foreground="{DynamicResource OnAccent}"/>
                <Button Content="Cancel" IsCancel="True" Width="90"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
