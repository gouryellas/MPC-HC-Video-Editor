<Window x:Class="MpcHcVideoEditor.Dialogs.DetectBookmarksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find clips automatically"
        Height="560" Width="520"
        MinHeight="460" MinWidth="460"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4EC9B0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What marks the end of a clip?" Style="{StaticResource Heading}"/>
                <RadioButton x:Name="ModeSilence" GroupName="Mode" IsChecked="True"
                             Content="Silence — for anything speech-driven"
                             Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeBlack" GroupName="Mode"
                             Content="Black frames — for recordings that fade between segments"
                             Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeScene" GroupName="Mode"
                             Content="Scene changes — for edited footage with hard cuts"
                             Checked="Mode_Changed"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="ThresholdLabel" Text="Threshold" FontSize="11"/>
                        <TextBox x:Name="ThresholdBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Min gap (s)" FontSize="11"/>
                        <TextBox x:Name="GapBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Min clip (s)" FontSize="11"/>
                        <TextBox x:Name="MinClipBox"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ThresholdHint" Style="{StaticResource Hint}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ScanButton" Content="Scan video" Click="Scan_Click"
                    Background="#0E639C" BorderBrush="#1177BB" Foreground="White" Margin="0"/>
            <TextBlock x:Name="ScanStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="#888" Text="Nothing scanned yet."/>
        </StackPanel>

        <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="8">
            <DockPanel>
                <!-- Proposals are a starting point, never applied on their own.
                     Detection on real footage is a good first guess, and the
                     user unticking the wrong ones is the whole workflow. -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                    <TextBlock x:Name="ResultsHeading" Text="Proposed clips" Style="{StaticResource Heading}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="All" Click="SelectAll_Click" Padding="8,2"/>
                        <Button Content="None" Click="SelectNone_Click" Padding="8,2"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                         Foreground="#DDDDDD" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Use, Mode=TwoWay}" Content="{Binding Display}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="ReplaceCheck" IsChecked="True"
                      Content="Replace the bookmarks currently loaded"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="UseButton" Content="Use selected" Click="Use_Click" IsEnabled="False"
                        Background="#0E639C" BorderBrush="#1177BB" Foreground="White"/>
                <Button Content="Cancel" IsCancel="True" Width="90"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
