<Window x:Class="MpcHcVideoEditor.Dialogs.CustomizeToolbarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MpcHcVideoEditor.Helpers"
        Title="Customize toolbar" Height="640" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">
    <Window.Resources>
        <helpers:ToolbarKindToVisibilityConverter x:Key="IsSpacer" Kind="Spacer"/>
        <helpers:ToolbarKindToVisibilityConverter x:Key="IsExpander" Kind="Expander"/>
        <helpers:ToolbarKindToVisibilityConverter x:Key="IsRowBreak" Kind="RowBreak"/>
        <helpers:ToolbarKindToVisibilityConverter x:Key="IsAction" Kind="Button"/>
        <!-- Declared here, not borrowed: a Window does not inherit the
             main window's resources, and a template that reaches for one
             throws the moment it is applied. -->
        <helpers:DragOpacityConverter x:Key="DragOpacity"/>
        <helpers:ResourceKeyToStyleConverter x:Key="StyleByKey"/>
        <!-- Needed by the chip, which draws a button's picture the same way the
             toolbar does. Declared here for the reason above: this window sees
             none of the main window's resources. -->
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- One chip. The same template serves both lists and the preview, so a
             button looks the same wherever it is being dragged from or to. -->
        <DataTemplate x:Key="Chip">
            <!-- An action draws as the button it is, with no frame around it:
                 the preview is meant to be the toolbar, and a chip border
                 around every button would be a second rectangle nothing on the
                 toolbar has. The fillers get the frame instead, because they
                 have nothing of their own to show. -->
            <!-- Background, not None: the button inside is IsHitTestVisible
                 false so a press cannot run the command, which leaves this Grid
                 as the only thing that can be under the pointer — and a Grid
                 with no background is not hit-tested at all. Without this the
                 actions could not be picked up, while the fillers, which have a
                 Border of their own, could. -->
            <Grid Margin="3" Background="Transparent" Opacity="{Binding ChipOpacity}">
                <!-- Same content as the real toolbar button, so the preview
                     shows the picture the toolbar will show rather than the
                     emoji the label still carries for this list's benefit. -->
                <Button IsHitTestVisible="False" Focusable="False"
                        Margin="0" MinWidth="{Binding MinWidth}"
                        Padding="{Binding ButtonPadding}"
                        AutomationProperties.Name="{Binding Label}"
                        Style="{Binding StyleKey, Converter={StaticResource StyleByKey}}"
                        Visibility="{Binding Kind, Converter={StaticResource IsAction}}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding IconSource}"
                               Width="{Binding IconSize}" Height="{Binding IconSize}"
                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform" VerticalAlignment="Center"
                               SnapsToDevicePixels="True"/>
                        <TextBlock Text="{Binding Caption}"
                                   Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                            <Setter Property="Margin" Value="6,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource InsetBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8,6"
                        Visibility="{Binding Kind, Converter={StaticResource IsSpacer}}"
                        ToolTip="A fixed gap between two groups of buttons">
                    <TextBlock Text="|      |" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas"/>
                </Border>

                <Border Background="{DynamicResource InsetBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="8,6"
                        Visibility="{Binding Kind, Converter={StaticResource IsExpander}}"
                        ToolTip="Takes up whatever width is left over">
                    <TextBlock Text="&lt; --- &gt;" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>

                <Border Background="{DynamicResource InsetBackground}"
                        BorderBrush="{DynamicResource ValueYellow}" BorderThickness="1"
                        CornerRadius="3" Padding="8,6"
                        Visibility="{Binding Kind, Converter={StaticResource IsRowBreak}}"
                        ToolTip="Drop this on the toolbar to start another line">
                    <TextBlock Text="⏎ New row" Foreground="{DynamicResource ValueYellow}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="YOUR TOOLBAR"/>

        <!-- The preview is the width the window is allowed to shrink to, so a
             row that fits here fits at any size. A row too wide for it wraps,
             which is exactly what the real toolbar does. -->
        <Border Grid.Row="1" x:Name="PreviewFrame"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="6" Margin="0,0,0,4"
                HorizontalAlignment="Left">
            <ItemsControl x:Name="PreviewRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- A row. The border is what lights up while something
                             is being dragged over it, so it is obvious which
                             line will take the drop once there is more than
                             one. -->
                        <Border x:Name="RowFrame" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="3" Padding="2" MinHeight="40" Margin="0,1"
                                Background="Transparent">
                            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource Chip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:ToolbarRowPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Border Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <!-- The heading and the filter belong to this box rather
                         than floating above it: a caption with a gap under it
                         reads as a label for empty space, and the search field
                         on its own read as an empty box nobody could name. -->
                    <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
                        <TextBlock Text="AVAILABLE" Style="{StaticResource Heading}" Margin="0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            <TextBox x:Name="SearchBox" Width="150" Padding="4,3"
                                     TextChanged="Search_TextChanged"
                                     Background="{DynamicResource InsetBackground}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AvailableList" Margin="6,0,6,6">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="2,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="Chip"/>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- The two appearance settings, the same ones Settings shows and
             writing to the same place. They live here because this is the
             window where somebody is looking at the toolbar deciding what it
             should be, and going to Settings to find out what it would look
             like without labels meant closing this and losing the layout. -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SmallIconsCheck" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Content="Small button icons"
                          ToolTip="Draw the toolbar as icons alone, with no labels. The list below stays full-size so the buttons can still be told apart."
                          Checked="Chrome_Changed" Unchecked="Chrome_Changed"/>
                <CheckBox x:Name="FlatIconsCheck" VerticalAlignment="Center" Margin="18,0,0,0"
                          Foreground="{DynamicResource TextPrimary}"
                          Content="No button backgrounds"
                          ToolTip="Show the icons on their own, with no rounded square behind them."
                          Checked="Chrome_Changed" Unchecked="Chrome_Changed"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Reset to default" Click="Reset_Click" Margin="4,4,24,4"/>
                <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click"
                        Background="{DynamicResource PrimaryButton}"
                        BorderBrush="{DynamicResource PrimaryButtonBorder}"
                        Foreground="{DynamicResource OnAccent}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
