<Window x:Class="MpcHcVideoEditor.Dialogs.BulkRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename files"
        Height="660" Width="960"
        MinHeight="440" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        </Style>

        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Templated for the same reason the duplicates dialog is: the
             default chrome paints a disabled button in system colours, which
             is a near-white block in a dark window. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Folder" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>

            <Border Grid.Column="1" Background="{DynamicResource InsetBackground}"
                    CornerRadius="4" Padding="8,6">
                <TextBlock x:Name="FolderText" Text="No folder chosen"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ValueGreen}"/>
            </Border>

            <Button Grid.Column="2" Content="Choose…" Click="ChooseFolder_Click"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <!-- Off by default. A rename reaches into every folder beneath
                 the one chosen, and that is a much larger promise than the
                 person pointing at a folder has necessarily made. -->
            <CheckBox x:Name="RecurseCheck" VerticalAlignment="Center"
                      Content="Include subfolders"
                      Foreground="{DynamicResource TextBody}"/>

            <CheckBox x:Name="VideosOnlyCheck" IsChecked="True" VerticalAlignment="Center"
                      Margin="18,0,0,0" Content="Videos only"
                      Foreground="{DynamicResource TextBody}"/>

            <Button Content="Words…" Click="Words_Click"/>

            <Button Content="Preview" Click="Preview_Click" Margin="18,0,0,0"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <!-- The same work as Preview, named for what it is for: reading
                 the folder again after something has changed outside this
                 window, or after editing the words. -->
            <Button Content="Refresh" Click="Preview_Click"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>

            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="RenameButton" Content="Rename checked"
                    Click="Rename_Click" IsEnabled="False"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}"
                    Foreground="{DynamicResource OnAccent}"/>
            <Button DockPanel.Dock="Right" Content="Deselect all" Click="DeselectAll_Click"/>
            <Button DockPanel.Dock="Right" Content="Select all" Click="SelectAll_Click"/>
        </DockPanel>

        <Border Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="2">
            <Grid>
                <TextBlock x:Name="EmptyText" Margin="14" TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Choose a folder and press Preview. Nothing is renamed until you say so."/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RowList" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="4"
                                        Background="{DynamicResource InsetBackground}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Gone rather than disabled on a
                                             row with nothing to do. A greyed
                                             box still reads as something that
                                             could be ticked; an empty space
                                             says there is no decision here. -->
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Visibility="{Binding ActionVisibility}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Original}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Note}"
                                                       Style="{StaticResource Quiet}"
                                                       Foreground="{DynamicResource StatusWarn}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding NoteVisibility}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="&#x2192;" Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"
                                                   Visibility="{Binding ActionVisibility}"/>

                                        <!-- Editable, and corrected on the way
                                             out: whatever is typed goes through
                                             the same rules, so the field cannot
                                             be used to write a name the rules
                                             would not have produced.

                                             Absent on a row whose name is not
                                             changing — there is nothing to
                                             edit, and an empty half-row makes
                                             the ones that do need attention
                                             easier to pick out. -->
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding Proposed, Mode=TwoWay,
                                                        UpdateSourceTrigger=LostFocus}"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding ActionVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
