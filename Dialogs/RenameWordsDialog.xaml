<Window x:Class="MpcHcVideoEditor.Dialogs.RenameWordsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Rules"
        Height="748" Width="1000"
        MinHeight="520" MinWidth="840"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Templated for the same reason the other dialogs are: the default
             chrome paints in system colours and lights up blue on hover,
             which in a dark window reads as a fault rather than a button. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small ones inside a rule card. Borderless, because a rule
             already has a frame and boxing every control inside it again is
             most of what made this list hard to read. -->
        <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- The ones sitting on a rule's coloured bar. Outlined rather than
             filled, and washed on hover rather than repainted in another of
             the theme's colours, which would fight with the accent under
             it. OnAccentFill rather than OnAccent: the bar is the accent
             itself, not the dark button shade OnAccent was made for. -->
        <!-- Glyphs rather than words on a rule's bar: the save one is the
             same mark the bookmark rows carry, so the one thing here that
             writes to disk is recognised as the action it already is.
             Borderless — an outline box around a glyph reads as a second,
             smaller button inside the first — and washed with white on
             hover rather than repainted in another of the theme's colours,
             which would fight with the accent under it.

             The glyph is given as the button's Content, so one style
             carries all three. -->
        <!-- Like the icon buttons in the main window: the picture and
             nothing else. No chrome and no fill of its own, because a
             small multicoloured bitmap boxed in a second rectangle reads
             as two things rather than one.

             Disabled means unclickable and nothing more. These glyphs are
             already faint against a saturated bar, and dimming them for a
             state is the surest way to make them unreadable — the eye
             says it is unavailable by changing to the struck-out one,
             which is a difference that survives being looked at. -->
        <Style x:Key="BarIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent, not null: a null background is not
                             a hit-test target, so only the glyph's own
                             strokes would answer the pointer. -->
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarGlyph" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <!-- Drawn rather than drawn from a file. The two add lines want the
             same mark in two colours, and a bitmap is the one colour it was
             painted — a vector takes a Fill, and a Fill can be a theme
             brush, so both of them follow the theme instead of being two
             more fixed-colour pictures. -->
        <Style x:Key="PlusGlyph" TargetType="Path">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Data"
                    Value="M 7,0 L 11,0 L 11,7 L 18,7 L 18,11 L 11,11 L 11,18 L 7,18 L 7,11 L 0,11 L 0,7 L 7,7 Z"/>
        </Style>

        <Style x:Key="AddLineText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <!-- The heading, once it is being typed into. Its own style because
             the implicit TextBox in this window is the one the word lists
             use: multi-line, Consolas and scrolling, none of which belongs
             in a one-line name. -->
        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="60"/>
            <!-- Room to type in, taken only while it is on screen. -->
            <Setter Property="MinWidth" Value="180"/>
        </Style>

        <!-- One word slot of a rule, typed into. Its own style because the
             implicit TextBox here is the blacklist's: multi-line, Consolas
             and scrolling, none of which belongs in a box one word wide. -->
        <Style x:Key="SlotBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="60"/>
        </Style>

        <!-- Orange where a line asks something, green where it does
             something. Two colours and no words, so the shape of a rule can
             be taken in without reading it. -->
        <Style x:Key="LineMark" TargetType="Border">
            <Setter Property="Width" Value="3"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,3,10,3"/>
            <Setter Property="Background" Value="{DynamicResource ValueGreen}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCondition}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- Templated, like the scrollbars and the buttons. A ComboBox draws
             its closed face with a system-coloured ToggleButton, so setting
             Background on the control changes almost nothing and leaves a
             white slab in a dark window. -->
        <!-- Narrow enough to fit the column it is given. A minimum wider
             than the slot does not widen the slot: WPF clips the control to
             the space it was allotted, and the first thing off the right
             edge is the arrow that says it is a dropdown at all. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0"/>
            <!-- Stated, not inherited. A control left to the system font
                 comes out a size or two above the 12 everything else in
                 this window is written at. -->
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Opens on release, not on press. A slot can
                                 be dragged onto the row below it, and a
                                 dropdown that opens the instant the button
                                 goes down never lets a drag begin. -->
                            <ToggleButton x:Name="Face" Focusable="False" ClickMode="Release"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource ControlBackground}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,7,0"
                                                  Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="{DynamicResource TextSecondary}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background"
                                                        Value="{DynamicResource ControlHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Nothing stands in for an empty slot. Every
                                 dropdown starts blank and can be set back to
                                 blank, so a prompt painted over the empty
                                 ones would be on screen fifteen times in a
                                 fresh rule and would read as a fault. -->
                            <ContentPresenter Margin="8,0,20,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <!-- So the blank entry at the top of every list is a row big
                 enough to aim at. Left to its own content it would be four
                 pixels of padding and nothing else. -->
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource RowSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Rename options" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Accent}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,2,0,10" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="These will be saved in your settings file and will not be lost when you update the program."/>

        </StackPanel>

        <!-- Save all to the right of Close. Each rule carries its own save
             on its bar; this one is for the whole page at once. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="SavedText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusOk}"/>

            <Button DockPanel.Dock="Right" Click="SaveAll_Click" MinWidth="110"
                    Background="{DynamicResource PrimaryButton}"
                    BorderBrush="{DynamicResource PrimaryButtonBorder}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/icons/icon-quick_save.png"
                           Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Save all" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnAccent}"/>
                </StackPanel>
            </Button>

            <Button DockPanel.Dock="Right" Content="Close" Width="90" Click="Close_Click"
                    Style="{StaticResource CloseButton}"/>
        </DockPanel>

        <!-- One list left of the five this window began with. The rules
             carry their own words now, typed straight into them; the
             blacklist stays because the engine reads it directly — it is
             the one list that acts on every file by itself. -->
        <Grid DockPanel.Dock="Top" Height="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock x:Name="BlacklistHeading" Text="Blacklisted"
                           Style="{StaticResource Heading}"/>
                <ContentControl Style="{StaticResource Qmhp}">
                    <ContentControl.ToolTip>
                        <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                   Text="If any of these words are found, they will be removed from the filename. One per line. Matched exactly as written — a list that deletes words earns that strictness — though the Regex option under Rules reads these lines as expressions too."/>
                    </ContentControl.ToolTip>
                </ContentControl>
            </StackPanel>
			
			
			
            <TextBox   Grid.Row="1" x:Name="BlacklistBox"
                       TextChanged="Words_Changed"/>
        </Grid>

        <!-- Rules below the words they are built from, because the lists have
             to be filled in before a rule can say anything — and given the
             rest of the window, because this is where the work happens and a
             word list is legible in a fixed strip.

             One box, not one per rule. A rule being written needs six
             dropdowns and three rows; a rule already written is a sentence,
             and a column of identical six-row cards was a great deal of
             screen saying very little. So: write it up here, and it joins
             the numbered list below. -->
        <Border Margin="0,12,0,0"
                Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" x:Name="RulesHeading" Text="Rules"
                               Style="{StaticResource Heading}"/>
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource Qmhp}">
                        <ContentControl.ToolTip>
                            <TextBlock MaxWidth="400" TextWrapping="Wrap"
                                       Text="A rule is lines read top to bottom: the questions it asks about the name, then what to do when all of them hold. The questions look at the filename as it was typed — before the cleanup or the blacklist has touched it — so nothing can hide a word from them. Several questions mean all of them — &quot;or&quot; belongs inside one line, between its own words. A word in an ordering that the filename does not have is added, which is how a clip can be made to say what it belongs to without the word ever being typed into it.&#x0a;&#x0a;Rules are tried top to bottom and every rule whose questions hold applies its lines, each seeing what the one above left behind; only the ordering is first-come — the first rule to give one decides it. When the rules have all had their say, the general cleanup finishes the name: the blacklist, the name keeping its slot, and the order the words were found in."/>
                        </ContentControl.ToolTip>
                    </ContentControl>
                </DockPanel>

                <!-- On the page rather than in an explainer, because a
                     right-click is the one thing here that nothing on
                     screen suggests is possible. -->
                <TextBlock DockPanel.Dock="Top" Margin="1,0,0,8" TextWrapping="Wrap"
                           FontSize="11" FontStyle="Italic"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Tip: Right-click a condition, operator, or words box to delete it. To delete the entire row, click the ✕ at the end of it."/>

                <!-- The box. Its DataContext is set in code and replaced
                     outright each time it resets, so nothing can be left
                     behind in a slot that was not walked.

                     Drawn right round in the accent, carrying on from its
                     own heading bar, so the one thing on this page that is
                     worked in is framed as such and the finished rules
                     below read as a list rather than as more of it. -->
                <DockPanel x:Name="RuleEditor" DockPanel.Dock="Top" Margin="0,0,0,14">

                    <!-- Everything that acts on the rule as a whole, above
                         the box rather than inside it. Save sits to the
                         left of the name and the rest to its right, and
                         New rule is pushed to the far end — a word rather
                         than a glyph, nowhere near the + inside the box,
                         because those two are the pair most worth never
                         confusing. -->
                    <DockPanel DockPanel.Dock="Top" Margin="1,0,1,6" LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource BarIconButton}"
                                Margin="0,0,8,0" Click="SaveRule_Click"
                                IsEnabled="{Binding IsTestable}">
                            <Image Style="{StaticResource BarGlyph}"
                                   Source="pack://application:,,,/Assets/icons/icon-quick_save.png"/>
                        </Button>

                        <!-- Always a field, never a label that turns into
                             one. There is no state to discover and nothing
                             to click first: it looks like what it is. -->
                        <TextBox DockPanel.Dock="Left" x:Name="NameField"
                                 Style="{StaticResource NameBox}"
                                 Text="{Binding Name, Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- An eye, because this one only looks: it runs
                             the rule over the folder and reports, and
                             renames nothing. Struck out and dead until the
                             rule says enough to be run. -->
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource BarIconButton}"
                                Click="TestRule_Click"
                                IsEnabled="{Binding IsTestable}">
                            <Image Style="{StaticResource BarGlyph}"
                                   Source="{Binding TestGlyph}"/>
                        </Button>

                        <!-- Puts the box back to the saved version of what
                             it is editing, or empties it. -->
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource BarIconButton}"
                                Click="ClearRule_Click"
                                IsEnabled="{Binding HasInput}">
                            <Image Style="{StaticResource BarGlyph}"
                                   Source="pack://application:,,,/Assets/icons/icon-undo.png"/>
                        </Button>

                        <Button DockPanel.Dock="Right" Content="New rule"
                                Click="NewRule_Click" Padding="12,3" FontSize="11"/>
                    </DockPanel>

                    <Border x:Name="RuleBox"
                            CornerRadius="5"
                            Background="{DynamicResource InsetBackground}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2">
                        <DockPanel>
                            <!-- Under the rows, always, so adding one is
                                 always in the same place — and on an empty
                                 box these two are the only things there,
                                 which makes them the prompt as well
                                 without being controls that come and go.

                                 Two of them, because the two kinds of row
                                 are the two halves of a rule: green asks
                                 something, blue does something, matching
                                 the mark each row carries down its left
                                 edge. The button that added a row is also
                                 what decides which actions its dropdown
                                 offers. -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="13,2,10,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Add (" Style="{StaticResource AddLineText}"/>
                                    <Button Style="{StaticResource BarIconButton}"
                                            Margin="1,0" Padding="2,0"
                                            Click="AddCondition_Click">
                                        <Path Style="{StaticResource PlusGlyph}"
                                              Fill="{DynamicResource StatusOk}"/>
                                    </Button>
                                    <TextBlock Text=") a condition"
                                               Style="{StaticResource AddLineText}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Add (" Style="{StaticResource AddLineText}"/>
                                    <Button Style="{StaticResource BarIconButton}"
                                            Margin="1,0" Padding="2,0"
                                            Click="AddOperator_Click">
                                        <Path Style="{StaticResource PlusGlyph}"
                                              Fill="{DynamicResource TimelinePosition}"/>
                                    </Button>
                                    <TextBlock Text=") an operator"
                                               Style="{StaticResource AddLineText}"/>
                                    <!-- Which line it lands on, said before
                                         it lands there. These buttons are
                                         at the foot of the box and the row
                                         they act on may be anywhere in
                                         it. -->
                                    <TextBlock Text="{Binding Target}"
                                               Style="{StaticResource AddLineText}"
                                               Foreground="{DynamicResource Accent}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- The same word slot, without the and/or
                                     in front of it, for a condition that
                                     is a list rather than a sentence. -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Add (" Style="{StaticResource AddLineText}"/>
                                    <Button Style="{StaticResource BarIconButton}"
                                            Margin="1,0" Padding="2,0"
                                            Click="AddWords_Click">
                                        <Path Style="{StaticResource PlusGlyph}"
                                              Fill="{DynamicResource ValuePurple}"/>
                                    </Button>
                                    <TextBlock Text=") words"
                                               Style="{StaticResource AddLineText}"/>
                                    <TextBlock Text="{Binding Target}"
                                               Style="{StaticResource AddLineText}"
                                               Foreground="{DynamicResource Accent}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Lines}" Margin="12,9,10,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A row grows as it is filled in: the
                                         action dropdown alone, then the
                                         first word, then the next once that
                                         one holds something.

                                         Stacked at fixed widths rather than
                                         laid out in a grid of star columns.
                                         A collapsed child of a StackPanel
                                         takes no room, where a star column
                                         holds its share open whether or not
                                         anything is in it — so the rows
                                         still line up with each other, and
                                         a short row is short. -->
                                    <!-- Lit while this is the line being
                                         worked on. Transparent otherwise
                                         rather than unset: a null
                                         background answers no pointer, and
                                         the strip either side of the row
                                         is part of what can be clicked to
                                         come here. -->
                                    <Border CornerRadius="4" Padding="4,0,2,0" Margin="0,0,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource PanelBackground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <DockPanel Background="Transparent"
                                               PreviewMouseDown="Row_MouseDown"
                                               GotFocus="Row_GotFocus">
                                        <!-- Red, because it deletes. Same
                                             size as it was: it is the
                                             colour doing the warning, not
                                             the weight. -->
                                        <Button DockPanel.Dock="Right" Content="&#x2715;"
                                                Style="{StaticResource Quiet}"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource StatusError}"
                                                Click="RemoveLine_Click" Tag="{Binding}"/>

                                        <StackPanel Orientation="Horizontal">
                                            <!-- The line's number, so the
                                                 buttons under the box can
                                                 name the line they are
                                                 about to act on and be
                                                 believed. Filled in the
                                                 accent on the line being
                                                 worked on. -->
                                            <Border Width="19" Height="17" CornerRadius="3"
                                                    VerticalAlignment="Top" Margin="0,6,7,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource ControlBackground}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Number}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource OnAccentFill}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Border Style="{StaticResource LineMark}"/>

                                            <!-- Wide enough for the longest
                                                 of the phrases, so none of
                                                 them reads as a different
                                                 one cut short. -->
                                            <!-- Deleting the condition box
                                                 clears it — the row and its
                                                 words stay. The whole row is
                                                 the ✕'s job, and only the
                                                 ✕'s. -->
                                            <ComboBox Width="220" Margin="0,3,10,3"
                                                      ItemsSource="{Binding Action.Choices}"
                                                      SelectedItem="{Binding Action.Word, Mode=TwoWay}">
                                                <ComboBox.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                 RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Delete this condition"
                                                                  Click="DeleteCondition_Click"/>
                                                    </ContextMenu>
                                                </ComboBox.ContextMenu>
                                            </ComboBox>

                                            <!-- Whatever was added after it,
                                                 in the order it was added.
                                                 A word is typed; an
                                                 operator is still a
                                                 dropdown, because it
                                                 offers "and" and "or" and
                                                 nothing else. One template
                                                 holds both controls and
                                                 the slot says which is on
                                                 screen.

                                                 Right-click deletes a
                                                 slot. The menu is handed
                                                 the slot's own
                                                 DataContext — a
                                                 ContextMenu is not in the
                                                 visual tree and inherits
                                                 nothing from the row. -->
                                            <ItemsControl ItemsSource="{Binding Parts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="{Binding Width}" Margin="0,3,5,3"
                                                              VerticalAlignment="Top">
                                                            <TextBox Height="24"
                                                                     Visibility="{Binding WordBoxVisibility}"
                                                                     Style="{StaticResource SlotBox}"
                                                                     Text="{Binding Word, Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                                 RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Header="{Binding DeleteLabel}"
                                                                                  Click="DeleteSlot_Click"/>
                                                                    </ContextMenu>
                                                                </TextBox.ContextMenu>
                                                            </TextBox>

                                                            <!-- MinWidth zeroed: the
                                                                 shared style asks for
                                                                 84, an operator's cell
                                                                 is 76, and the first
                                                                 thing clipped past the
                                                                 edge would be the
                                                                 arrow. -->
                                                            <ComboBox Height="24" Margin="0" MinWidth="0"
                                                                      Visibility="{Binding PickerVisibility}"
                                                                      ItemsSource="{Binding Choices}"
                                                                      SelectedItem="{Binding Word, Mode=TwoWay}">
                                                                <ComboBox.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                                 RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Header="{Binding DeleteLabel}"
                                                                                  Click="DeleteSlot_Click"/>
                                                                    </ContextMenu>
                                                                </ComboBox.ContextMenu>
                                                            </ComboBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- Between the editor and the saved list, because they
                     govern both: how every rule's words meet a filename,
                     and — for Regex — how the blacklist's lines do too. -->
                <DockPanel DockPanel.Dock="Top" Margin="1,0,0,10" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Word match mode:"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <ComboBox DockPanel.Dock="Left" x:Name="MatchModeBox" Width="112"
                              VerticalAlignment="Center" Margin="7,0,0,0"
                              SelectionChanged="MatchMode_Changed">
                        <ComboBoxItem Content="Precise"/>
                        <ComboBoxItem Content="Variant"/>
                        <ComboBoxItem Content="Irregular"/>
                    </ComboBox>

                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource Qmhp}">
                        <ContentControl.ToolTip>
                            <TextBlock MaxWidth="420" TextWrapping="Wrap"
                                       Text="Applies to the words written in rules — all of them: it is one setting for every saved rule, read when a rename runs, not remembered per rule. The blacklist is not affected by this mode; it matches exactly as written, unless Regex is checked, which reads its lines as expressions too.&#x0a;&#x0a;Precise: words will only match exactly as you write them.&#x0a;&#x0a;Variant: words will match variants of the base word. For example, the word &quot;wave&quot; will match the following: wave, waves, waved, waving.&#x0a;&#x0a;Irregular: words will match precise, variant, and irregular versions of the word. For example, the word &quot;go&quot; will match the following: go, goes, going, gone, went. Another example, the word &quot;be&quot; will match the following: be, am, is, are, was, were, being, been."/>
                        </ContentControl.ToolTip>
                    </ContentControl>

                    <CheckBox DockPanel.Dock="Left" x:Name="RegexCheck"
                              VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0"
                              Content="Regex"
                              Foreground="{DynamicResource TextSecondary}"/>

                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource Qmhp}">
                        <ContentControl.ToolTip>
                            <TextBlock MaxWidth="400" TextWrapping="Wrap"
                                       Text="Reads every word written in a rule — and every line of the blacklist — as a regular expression instead of a word, matched against one word of a filename at a time and anchored, so beach is still only beach. The match mode beside it does not apply — an expression says for itself what it will and will not match. An expression that will not compile matches nothing rather than stopping the rename."/>
                        </ContentControl.ToolTip>
                    </ContentControl>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="Saved rules" Margin="2,0,0,6"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"/>

                <TextBlock x:Name="NoRulesText" DockPanel.Dock="Top" Margin="2,0,0,0"
                           Foreground="{DynamicResource TextMuted}" FontSize="12"
                           TextWrapping="Wrap"
                           Text="None yet. Fill in the box above and press its save icon."/>

                <!-- Numbered, and the numbers mean something: rules are
                     tried top to bottom, and the first one to give an
                     ordering decides. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RuleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One line per rule. A rule's rows laid
                                     out in a block read beautifully and
                                     cost five lines each, which is four
                                     rules to a screen; as segments with a
                                     dot between them the shape still shows
                                     and twenty fit. -->
                                <Border Margin="0,0,0,3" Padding="7,3" CornerRadius="3"
                                        Background="{DynamicResource InsetBackground}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <!-- The one open in the box.
                                                     It stays in the list
                                                     while being edited, so
                                                     abandoning the edit
                                                     leaves it where it
                                                     was. -->
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" MinWidth="22"
                                                CornerRadius="3" Padding="5,0" Margin="0,0,9,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Accent}">
                                            <TextBlock Text="{Binding Number}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentFill}"/>
                                        </Border>

                                        <!-- A fixed column, so the names
                                             make a column to read down and
                                             the summaries all start in the
                                             same place. -->
                                        <TextBlock DockPanel.Dock="Left" Width="140"
                                                   Text="{Binding Name}"
                                                   Visibility="{Binding NameVisibility}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>

                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource BarIconButton}"
                                                Click="RemoveRule_Click" Tag="{Binding}">
                                            <Image Style="{StaticResource BarGlyph}"
                                                   Source="pack://application:,,,/Assets/icons/icon-menu-x.png"/>
                                        </Button>

                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource BarIconButton}"
                                                Click="EditRule_Click" Tag="{Binding}">
                                            <Image Style="{StaticResource BarGlyph}"
                                                   Source="pack://application:,,,/Assets/icons/icon-edit_bookmarks.png"/>
                                        </Button>

                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource BarIconButton}"
                                                Click="TestRule_Click" Tag="{Binding}">
                                            <Image Style="{StaticResource BarGlyph}"
                                                   Source="pack://application:,,,/Assets/icons/icon-eye_show.png"/>
                                        </Button>

                                        <!-- Trimmed rather than wrapped: a
                                             rule too long to fit is read in
                                             the box above, which is what
                                             the pencil is for. -->
                                        <TextBlock Text="{Binding Summary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0" FontSize="12"
                                                   Foreground="{DynamicResource TextBody}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </DockPanel>
</Window>
