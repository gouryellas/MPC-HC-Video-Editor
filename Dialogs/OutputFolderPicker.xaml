<UserControl x:Class="MpcHcVideoEditor.Dialogs.OutputFolderPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OptionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="WRITE THEM" Foreground="{DynamicResource Accent}"
                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

        <RadioButton x:Name="BesideSource" GroupName="Where" IsChecked="True" Checked="Choice_Changed">
            <StackPanel>
                <TextBlock Text="Beside each picture"/>
                <TextBlock Style="{StaticResource OptionNote}"
                           Text="Each file lands in the folder its original came from, so a selection spanning several folders stays where it was."/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="SaveToFolder" GroupName="Where" Checked="Choice_Changed">
            <StackPanel>
                <TextBlock Text="In the Save to folder"/>
                <TextBlock x:Name="SaveToNote" Style="{StaticResource OptionNote}"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="OtherFolder" GroupName="Where" Checked="Choice_Changed">
            <StackPanel>
                <TextBlock Text="Somewhere else"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="Choose folder…" Click="Browse_Click" Margin="0,0,8,0"/>
                    <TextBlock x:Name="OtherNote" VerticalAlignment="Center"
                               Style="{StaticResource OptionNote}" Margin="0"/>
                </StackPanel>
            </StackPanel>
        </RadioButton>
    </StackPanel>
</UserControl>
