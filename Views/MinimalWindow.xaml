<Window x:Class="MpcHcVideoEditor.Views.MinimalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmarks"
        Width="380" MinWidth="380" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        xmlns:helpers="clr-namespace:MpcHcVideoEditor.Helpers">

    <!-- A fixed Height, not SizeToContent. PositionInCorner replaces the value
         below with the monitor height less a small reserve; 300 is only what
         the designer shows.

         This window is layered (AllowsTransparency gives it per-pixel alpha),
         and a layered window that changes height does not reliably repaint the
         region it vacated. With SizeToContent the height moved every time the
         bookmark list did, leaving the previous, taller frame painted
         underneath the new one — two "Press X" lines, two separator rules, and
         two copies of a row with different end times. The 700 ms topmost
         re-assertion then swapped which frame was on top, so it read as a
         flicker between two states rather than as a stale frame.

         So the window is a pane the height of the screen, allocated once and
         only ever redrawn in place, and the card inside it is what grows with
         the bookmark list. Every pair is visible without the layer ever being
         resized, and the list scrolls only once the card runs out of screen. -->

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="MinimalBoolToVis"/>
    </Window.Resources>

    <!-- Opaque, with a border. Over bright video a translucent panel left the
         text competing with whatever was behind it; the alpha channel bought
         nothing here, since the point of the overlay is to be read. The
         opacity setting can still take it back down. -->
    <!-- Top-aligned, so the card is only as tall as its content instead of
         filling the pane. PositionInCorner flips this to Bottom when the
         overlay is parked in a bottom corner. -->
    <Border x:Name="Panel" Background="{DynamicResource ToastBackground}" CornerRadius="8" Padding="14" Margin="8"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Border.Effect>
            <!-- Separates the card from the video underneath it, which a flat
                 rectangle of near-black does not do on a dark scene. -->
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <DockPanel HorizontalAlignment="Stretch" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Session.VideoFileName}" Foreground="{DynamicResource AccentBright}"
                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,2"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BookmarksFileName}" Foreground="{DynamicResource ValueGreen}"
                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

            <!-- Docked to the bottom before the list is added, so the hint and
                 its rule keep their place and the list takes what is left. -->
            <TextBlock DockPanel.Dock="Bottom" Text="Press  X  —  back to the full window"
                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource ControlHover}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,6"/>

            <TextBlock DockPanel.Dock="Bottom" Text="(no bookmarks yet)" Foreground="{DynamicResource TextSecondary}"
                       FontStyle="Italic" FontSize="12"
                       Visibility="{Binding HasNoBookmarks, Converter={StaticResource MinimalBoolToVis}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Session.Bookmarks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Index, StringFormat=[{0}]}" Foreground="{DynamicResource LinkBlue}"
                                           FontWeight="Bold" FontFamily="Consolas" FontSize="13" MinWidth="34"/>
                                <TextBlock Text="{Binding StartDisplay}" Foreground="{DynamicResource AccentBright}"
                                           FontFamily="Consolas" FontSize="13"/>
                                <!-- Was #666, which on a dark card was very nearly
                                     the background. -->
                                <TextBlock Text=" → " Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas" FontSize="13"/>
                                <TextBlock Text="{Binding EndDisplay}" Foreground="{DynamicResource AccentBright}"
                                           FontFamily="Consolas" FontSize="13"/>
                                <TextBlock Text="{Binding DurationDisplay, StringFormat=  ({0})}"
                                           Foreground="{DynamicResource ValueYellow}" FontFamily="Consolas" FontSize="13"/>
                                <TextBlock Text="{Binding Prefix}" Foreground="{DynamicResource StatusWarn}"
                                           FontFamily="Consolas" FontSize="13" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
