<Window x:Class="MpcHcVideoEditor.Views.MinimalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmarks"
        Width="380" MinWidth="380" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        xmlns:helpers="clr-namespace:MpcHcVideoEditor.Helpers">

    <!-- A fixed Height, not SizeToContent. PositionInCorner replaces the value
         below with the monitor height less a small reserve; 300 is only what
         the designer shows.

         This window is layered (AllowsTransparency gives it per-pixel alpha),
         and a layered window that changes height does not reliably repaint the
         region it vacated. With SizeToContent the height moved every time the
         bookmark list did, leaving the previous, taller frame painted
         underneath the new one — two "Press X" lines, two separator rules, and
         two copies of a row with different end times. The 700 ms topmost
         re-assertion then swapped which frame was on top, so it read as a
         flicker between two states rather than as a stale frame.

         So the window is a pane the height of the screen, allocated once and
         only ever redrawn in place, and the card inside it is what grows with
         the bookmark list. Every pair is visible without the layer ever being
         resized, and the list scrolls only once the card runs out of screen. -->

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="MinimalBoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="NotBoolToVis"/>

        <!-- A bookmark's start or end time. Seeks the player when the overlay
             is clickable (the OverlayClickable setting), and is inert
             otherwise.

             One style covers both cases, with no switch on the setting: while
             the overlay is click-through the window is not hit-tested at all,
             so the cursor never changes and the hover trigger never fires. The
             affordance appears exactly when it means something.

             Tag carries the time to seek to, per-instance, the way the main
             window's timestamp hyperlinks carry theirs.

             Colored and lit on hover exactly like TimestampLink in the main
             window: Accent at rest, AccentBright and underlined under the
             pointer. It is a TextBlock rather than a Hyperlink because the
             overlay is click-through until the OverlayClickable setting turns
             it on, and a Hyperlink in a window that is not hit-tested still
             draws itself as one. -->
        <Style x:Key="OverlayTimestamp" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="Timestamp_Click"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One space, the only separator the main window's rows use between
             the index, the timestamps, the dash and the length. Same style,
             same name, so the two lists stay in step. -->
        <Style x:Key="RowGap" TargetType="TextBlock">
            <Setter Property="Text" Value="&#32;"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Opaque, with a border. Over bright video a translucent panel left the
         text competing with whatever was behind it; the alpha channel bought
         nothing here, since the point of the overlay is to be read. The
         opacity setting can still take it back down. -->
    <!-- Top-aligned, so the card is only as tall as its content instead of
         filling the pane. PositionInCorner flips this to Bottom when the
         overlay is parked in a bottom corner. -->
    <Border x:Name="Panel" Background="{DynamicResource ToastBackground}" CornerRadius="8" Padding="14" Margin="8"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Border.Effect>
            <!-- Separates the card from the video underneath it, which a flat
                 rectangle of near-black does not do on a dark scene. -->
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <DockPanel HorizontalAlignment="Stretch" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Session.VideoFileName}" Foreground="{DynamicResource AccentBright}"
                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,2"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BookmarksFileName}" Foreground="{DynamicResource ValueGreen}"
                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

            <!-- Docked to the bottom before the list is added, so the hint and
                 its rule keep their place and the list takes what is left. -->
            <!-- Names whichever way out applies to how the player is presented
                 right now — X while it is fullscreen, clicking away while it is
                 windowed. See MainViewModel.MinimalHint. -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding MinimalHint}"
                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource ControlHover}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,6"/>

            <TextBlock DockPanel.Dock="Bottom" Text="(no bookmarks yet)" Foreground="{DynamicResource TextSecondary}"
                       FontStyle="Italic" FontSize="12"
                       Visibility="{Binding HasNoBookmarks, Converter={StaticResource MinimalBoolToVis}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Session.Bookmarks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Laid out to read identically to a row in the main
                                 window's list: the same colors, the same
                                 inherited font, one space between each part, and
                                 the same 4px above and below that the list's
                                 ListViewItem padding gives it.

                                 Nothing here sets a font. The main window's rows
                                 do not either, so both inherit the same one; the
                                 fixed-width column the index used to sit in is
                                 gone for the same reason, since the main list
                                 sizes it to the number and follows it with a
                                 space rather than padding "[1]" out to the width
                                 of "[10]". -->
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{Binding Index, StringFormat=[{0}]}" Foreground="{DynamicResource LinkBlue}"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource RowGap}"/>
                                <TextBlock Text="{Binding StartDisplay}" Tag="{Binding StartSeconds}"
                                           Style="{StaticResource OverlayTimestamp}"/>
                                <!-- Hidden on an open bookmark, which has no end
                                     and no length: showing them anyway rendered
                                     "11s - 0s (0s)". Same rule as the full
                                     window's list. -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsIncomplete, Converter={StaticResource NotBoolToVis}}">
                                    <!-- Not part of either timestamp: the dash sits
                                         between the two click targets, so giving it
                                         the clickable style would make the gap seek
                                         to whichever time the pointer happened to
                                         be nearer. -->
                                    <TextBlock Style="{StaticResource RowGap}"/>
                                    <TextBlock Text="-" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource RowGap}"/>
                                    <TextBlock Text="{Binding EndDisplay}" Tag="{Binding EndSeconds}"
                                               Style="{StaticResource OverlayTimestamp}"/>
                                    <TextBlock Style="{StaticResource RowGap}"/>
                                    <TextBlock Text="{Binding DurationDisplay, StringFormat=({0})}"
                                               Foreground="{DynamicResource ValueGreen}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- The word the main window puts after a lone
                                     opening timestamp, saying why the rest of the
                                     row is absent. The overlay hid the end and the
                                     length and said nothing in their place. -->
                                <TextBlock Style="{StaticResource RowGap}"/>
                                <TextBlock Text="incomplete" Foreground="{DynamicResource StatusError}" FontStyle="Italic"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsIncomplete, Converter={StaticResource MinimalBoolToVis}}"/>
                                <!-- Flip, rotation, mute and speed, combined into
                                     one string because the overlay has no columns
                                     to put them in. Styled like the main window's
                                     marker column. -->
                                <TextBlock Style="{StaticResource RowGap}"/>
                                <TextBlock Text="{Binding Prefix}" Foreground="{DynamicResource StatusWarn}"
                                           FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
