<Window x:Class="MpcHcVideoEditor.Views.MinimalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmarks"
        Width="360" MinWidth="360" SizeToContent="Height" MinHeight="90" MaxHeight="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        xmlns:helpers="clr-namespace:MpcHcVideoEditor.Helpers">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="MinimalBoolToVis"/>
    </Window.Resources>

    <!-- HorizontalAlignment=Stretch throughout: with an empty session every
         bound string is empty and the item list has no rows, so a panel that
         sizes to its content collapsed the whole overlay to a sliver — which
         looked exactly like it had failed to open. -->
    <Border Background="#C0101010" CornerRadius="8" Padding="14" Margin="8"
            HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Session.VideoFileName}" Foreground="#4EC9B0"
                       FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,2"/>
            <TextBlock Text="{Binding BookmarksFileName}" Foreground="#B5CEA8"
                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding Session.Bookmarks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Index, StringFormat=[{0}]}" Foreground="#569CD6"
                                       FontWeight="Bold" FontFamily="Consolas" MinWidth="34"/>
                            <TextBlock Text="{Binding StartDisplay}" Foreground="#4EC9B0" FontFamily="Consolas"/>
                            <TextBlock Text=" → " Foreground="#666" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding EndDisplay}" Foreground="#4EC9B0" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding DurationDisplay, StringFormat=  ({0})}"
                                       Foreground="#DCDCAA" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding Prefix}" Foreground="#CE9178"
                                       FontFamily="Consolas" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="(no bookmarks yet)" Foreground="#777" FontStyle="Italic" FontSize="11"
                       Visibility="{Binding HasNoBookmarks, Converter={StaticResource MinimalBoolToVis}}"/>

            <Border BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Margin="0,10,0,6"/>
            <TextBlock Text="Press  X  —  back to the full window"
                       Foreground="#888" FontSize="11"/>
        </StackPanel>
    </Border>
</Window>
