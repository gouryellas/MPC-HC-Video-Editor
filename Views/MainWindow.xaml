<!-- Title is set in the constructor from the assembly version — see AppVersion.
     The literal that used to be on the Title attribute below is why 3.0.1
     shipped with a window still captioned 3.0; what is left there is only what
     the XAML designer shows. -->
<Window x:Class="MpcHcVideoEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MpcHcVideoEditor.ViewModels"
        xmlns:helpers="clr-namespace:MpcHcVideoEditor.Helpers"
        xmlns:services="clr-namespace:MpcHcVideoEditor.Services"
        Title="MPC-HC Video Editor"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="780" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Ctrl+Z / Ctrl+Y reach the same commands as the Edit menu. Bound on the
         window so they work wherever focus happens to be — except inside a text
         box, where the TextBox's own undo handles the keystroke first, which is
         what someone editing a cut's name would expect. -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoEditCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoEditCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="NotBoolToVis"/>
        <helpers:ProgressToBrushConverter x:Key="ProgressBrush"/>
        <helpers:RotationToAngleConverter x:Key="RotationToAngle"/>
        <helpers:ResourceKeyToStyleConverter x:Key="StyleByKey"/>
        <helpers:PositiveToWidthConverter x:Key="WidthOrAuto"/>
        <helpers:DragOpacityConverter x:Key="DragOpacity"/>
        <helpers:ToolbarKindToVisibilityConverter x:Key="SpacerVis" Kind="Spacer"/>
        <helpers:ToolbarKindToVisibilityConverter x:Key="ExpanderVis" Kind="Expander"/>
        <helpers:BoolToFlipScaleConverter x:Key="FlipScale"/>
        <helpers:PositiveToVisibilityConverter x:Key="PositiveToVis"/>
        <helpers:SpeedToBadgeConverter x:Key="SpeedBadge"/>
        <helpers:AlteredSpeedToVisibilityConverter x:Key="AlteredSpeedToVis"/>
        <helpers:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
        <helpers:SpeedIsConverter x:Key="SpeedIs"/>

        <!-- See JobCompleteGlow. A quick rise and fall rather than a flat
             hold: a held flash reads as a colour change, a rise-and-fall
             reads as an event, which is what a finished job actually is. -->
        <Storyboard x:Key="JobCompletePulse">
            <DoubleAnimation Storyboard.TargetName="JobCompleteGlow" Storyboard.TargetProperty="Opacity"
                              From="0" To="0.35" Duration="0:0:0.2" AutoReverse="True"/>
        </Storyboard>

        <!-- The status strip says what just happened; these say how it went.
             Up fast, held for most of three seconds, then faded out rather
             than switched off — the arrival is the event worth noticing and
             the departure is not, so only one of them is abrupt.

             Three seconds is also what the ViewModel's timer waits before
             putting the level back to Normal. The two have to agree: the
             trigger below fires on the level changing, so a flash that
             outlasted the reset would be cut off, and one that ended early
             would leave a dead gap before the strip was ready to flash
             again. -->
        <Storyboard x:Key="StatusFlashOk">
            <DoubleAnimation Storyboard.TargetName="StatusOkFlash" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="StatusOkFlash" Storyboard.TargetProperty="Opacity"
                             To="0" BeginTime="0:0:2.3" Duration="0:0:0.7"/>
        </Storyboard>

        <Storyboard x:Key="StatusFlashFailed">
            <DoubleAnimation Storyboard.TargetName="StatusFailFlash" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="StatusFailFlash" Storyboard.TargetProperty="Opacity"
                             To="0" BeginTime="0:0:2.3" Duration="0:0:0.7"/>
        </Storyboard>

        <!-- The preview frames are shown as the clip will be written, not as
             the file holds it: turned the way Rotate is set, mirrored if Flip
             is on. It costs nothing — the picture is already on screen, and
             re-rendering it through ffmpeg for a 76-pixel thumbnail would be
             an encode per click of a toggle.

             LayoutTransform rather than RenderTransform, so a quarter turn is
             measured in its new shape and the Uniform stretch fits it to the
             box. Under RenderTransform the image would keep its old footprint
             and hang out of the border. -->
        <Style TargetType="Image" x:Key="PreviewFrame">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleY="{Binding PreviewedBookmark.IsFlipped,
                                                 Converter={StaticResource FlipScale}}"/>
                        <RotateTransform Angle="{Binding PreviewedBookmark.Rotation,
                                                 Converter={StaticResource RotationToAngle}}"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The clip's speed, in the opposite corner to the mute badge so both
             can show at once. Nothing at all at normal speed: that is the
             absence of a setting, and a "1x" on most clips would be a label for
             the thing not happening.

             The text colour is fixed rather than themed. It sits on a dark pill
             that is the same in all five themes, so a theme's own foreground —
             near-black in the light ones — would be unreadable on it. -->
        <Style TargetType="ContentControl" x:Key="PreviewSpeedBadge">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="3,3,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ToolTip" Value="{Binding PreviewedBookmark.SpeedDisplay}"/>
            <Setter Property="Visibility"
                    Value="{Binding PreviewedBookmark.Speed, Converter={StaticResource AlteredSpeedToVis}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="#CC000000" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="{Binding PreviewedBookmark.Speed, Converter={StaticResource SpeedBadge}}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#F2F2F2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sits over the corner of a frame when the clip is muted. Outside the
             transform above, so it stays the right way up on a rotated clip —
             an upside-down icon reads as part of the picture. -->
        <Style TargetType="ContentControl" x:Key="PreviewMuteBadge">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,3,3,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ToolTip" Value="This clip is muted"/>
            <Setter Property="Visibility"
                    Value="{Binding PreviewedBookmark.IsMuted, Converter={StaticResource BoolToVis}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="#CC000000" CornerRadius="3" Padding="3,1">
                            <TextBlock Text="&#128263;" FontSize="12"
                                       Foreground="{DynamicResource StatusError}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="Button" x:Key="DarkButton">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Three seconds, as the menus wait. A tooltip that appears the
                 moment the pointer crosses a button pops up while you are on
                 your way to a different one; at three seconds only resting on
                 one asks for its explanation. Set here rather than on each
                 button, so every button in the window shares it — and
                 inherited by the four coloured ones, which are BasedOn this. -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="3000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>

                            <!-- "Show the graphic, not the square." Bound to the
                                 item rather than to a property of the button,
                                 because the style is picked per item by its
                                 family and there is no second style to switch
                                 to that would not have to be written four more
                                 times.

                                 FallbackValue matters: this template is the
                                 implicit one for every Button in the window,
                                 and the rest have no ToolbarItem behind them.
                                 Without it each of those logs a binding failure
                                 on load. -->
                            <DataTrigger Binding="{Binding IsFlat, FallbackValue=False, TargetNullValue=False}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="0"/>

                                <!-- And the text back to the ordinary colour.
                                     The four coloured families set a Foreground
                                     picked to read against their own fill —
                                     near-black on yellow for the video one —
                                     so with the fill not drawn they were
                                     near-black on the toolbar instead, which
                                     is to say invisible.

                                     A template trigger outranks the style
                                     setter that put the family colour there,
                                     which is what makes this possible without
                                     a second style per family. -->
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </DataTrigger>

                            <!-- Except the naming tag that is in use. Exactly
                                 one of those buttons is the true one, and the
                                 only thing that ever said which was the accent
                                 fill the trigger above has just removed — so
                                 flat, they all looked alike and pressing one
                                 looked like pressing none.

                                 After the flat trigger on purpose: both set
                                 Foreground, and the last matching trigger in a
                                 collection is the one that wins. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFlat, FallbackValue=False, TargetNullValue=False}" Value="True"/>
                                    <Condition Binding="{Binding StyleKey}" Value="ActiveTagButton"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource StatusOk}"/>
                            </MultiDataTrigger>

                            <!-- And "no tag" in red rather than green, since
                                 it is the one tag that says output keeps the
                                 source's own name. Green reads as "a tag is
                                 on"; this is the state where none is, and it
                                 is worth being able to tell at a glance.

                                 Last of the three on purpose, for the same
                                 reason as the one above it. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFlat, FallbackValue=False, TargetNullValue=False}" Value="True"/>
                                    <Condition Binding="{Binding StyleKey}" Value="ActiveTagButton"/>
                                    <Condition Binding="{Binding Key}" Value="tag:none"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}"/>

        <!-- One style per family of operations, not one per button. The three
             brushes behind each are pushed by ButtonColors, which is the only
             thing that decides what a family looks like — the squares beside
             the menu entries read the same keys, so the two cannot drift apart.

             DynamicResource throughout: the colours move when the theme changes
             and when the user recolours a family, and both have to reach
             buttons that are already on screen. -->
        <Style x:Key="VideoButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource VideoFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VideoEdge}"/>
            <Setter Property="Foreground" Value="{DynamicResource VideoInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="AudioButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource AudioFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AudioEdge}"/>
            <Setter Property="Foreground" Value="{DynamicResource AudioInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ImageButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource ImageFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ImageEdge}"/>
            <Setter Property="Foreground" Value="{DynamicResource ImageInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="OtherButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource OtherFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OtherEdge}"/>
            <Setter Property="Foreground" Value="{DynamicResource OtherInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- The glyph beside a menu entry. The same picture the toolbar button
             shows with Small button icons on, and nothing else: it was a filled
             square in the operation's family colour, which made the four
             coloured squares in the Actions menu louder than the words they
             belonged to, and gave every other menu nothing at all.

             The ink is MenuBarForeground — the colour the entry's own words are
             in, which is near-black in every theme including the dark ones:
             the menu bar and its dropdowns are light in all five palettes.
             TextPrimary would have been the wrong answer and a silent one, as
             it is near-white on a dark theme and the menu underneath it is not
             dark. -->
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuBarForeground}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Several of these are emoji, which Segoe UI Emoji draws in
                 colour whatever the Foreground says. Monochrome where the font
                 offers it: the text presentation selector asks for the glyph
                 rather than the picture. -->
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI"/>
        </Style>

        <!-- The naming tag currently in use. One of the tag buttons is always
             the true one — including "no tag" — and nothing on the toolbar said
             which, so pressing [done] looked exactly like not pressing it.
             Follows the theme, unlike the four operation buttons: this is a
             state rather than an identity, and the accent is what the rest of
             the window already uses to mean "this one". -->
        <Style x:Key="ActiveTagButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- The menu strip keeps system-like chrome rather than following the
             app's canvas, so its two colors are their own palette roles. -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource MenuBarBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuBarForeground}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <!-- A caption inside a menu, naming the group of entries under it.
             Separators say "these are different things" and nothing about
             what either group is; a long Options menu was three unlabelled
             runs of entries.

             A MenuItem rather than anything else, because only a MenuItem is
             a legal child of a menu and lays out in its column. The template
             is replaced outright, so none of the chrome arrives — no icon
             gutter, no highlight, no submenu arrow — and what is left is text
             that happens to live in a menu.

             IsEnabled false as well as unfocusable: a disabled item is what
             WPF's own keyboard navigation skips over, so arrowing down a menu
             steps past these rather than landing on something that cannot be
             pressed. The implicit style's disabled-foreground trigger cannot
             reach it either, the template naming its own colour.

             PrimaryButton for the colour, which is the status strip's fill.
             Not Accent: the menus keep light system chrome while the rest of
             the window is dark, and every theme's Accent is a pale tint meant
             to sit on that dark — on near-white it barely shows. PrimaryButton
             is the saturated mid-dark of each theme, it reads on all five
             menu backgrounds, and it already means "the program talking"
             everywhere else it appears.

             Deliberately not BasedOn the implicit style below. A keyed style
             does not inherit one automatically, and there is nothing in it
             this wants. -->
        <Style x:Key="MenuSectionHeader" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <TextBlock Text="{TemplateBinding Header}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryButton}"
                                   Margin="12,7,12,2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuBarForeground}"/>
            <Setter Property="Background" Value="{DynamicResource MenuBarBackground}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <!-- A highlighted item pops its own tooltip, which lands on top of
                 the item below it — every menu opened with its second entry
                 covered up. Set here rather than on the Menu: the dropdown is a
                 Popup, its own visual tree, and the attached property does not
                 reach across from the parent. Hovering still shows them. -->
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="False"/>
            <!-- Three seconds before a menu tooltip appears, against a default
                 of about half a second. Reading down a menu means passing over
                 several items on the way to the one you want, and at the
                 default each of those pops a panel of text over the ones below
                 it. At three seconds only resting on an item asks for its
                 explanation. -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="3000"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LinkBlue}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MenuBarForeground}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource TextDim}"/>
        </Style>

        <!-- Clickable timestamp look: teal, no underline by default,
             underline + brighter color on hover, hand cursor.
             Used for the bookmark timestamp hyperlinks. -->
        <Style x:Key="TimestampLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to seek MPC-HC to this time"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A bare glyph acting on the file named under a right-panel heading:
             the pencil that opens the bookmark CSV, the folder that shows the
             video in Explorer.

             Visibility follows IsEnabled, which the bound command's CanExecute
             already drives, so "only shown when there is something to act on"
             and "only clickable when there is something to act on" cannot
             drift apart — there is one answer and the command owns it. -->
        <Style x:Key="HeaderIcon" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- As the toolbar waits. These are bare glyphs, so the tooltip is
                 the only thing that names them — all the more reason it should
                 appear when asked for rather than in passing. -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="3000"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent, not null: a null background is not a
                             hit-test target, and the icon would only be
                             clickable on the glyph's own strokes. -->
                        <Border Background="Transparent" Padding="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One effect mark. Each is drawn on its own rather than as one line
             of text, because mute is red and the rest are not, and a single
             TextBlock can only be one colour. -->
        <ItemsPanelTemplate x:Key="EffectMarksPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="EffectMarkTemplate">
            <TextBlock Text="{Binding Glyph}" Margin="0,0,3,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource StatusWarn}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Alert}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- The turn a clip is given, drawn as the arc it describes: a quarter
             circle for a quarter turn, a half for a half, three quarters for
             the other way round. Direction is clockwise in every case, since a
             three-quarter turn clockwise is a quarter turn anticlockwise and
             the arc says which it is by how far it goes.

             Drawn rather than typed because there is no third rotation arrow
             in any font that reads as "half turn" beside ⟳ and ⟲ — and a
             number set inside a twelve-pixel circle, which is how the printed
             icons do it, is not legible at this size. The arc alone carries
             it, and the tooltip carries the words.

             Geometry is a 12×12 box, centre (6,6), radius 4.5, starting at
             twelve o'clock. Each ends in two short strokes for an arrowhead
             rather than a filled triangle, so the whole mark is one stroked
             path in one colour. -->
        <Style x:Key="RotationMark" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource StatusWarn}"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rotation}" Value="Clockwise">
                    <Setter Property="Data" Value="M 6,1.5 A 4.5,4.5 0 0 1 10.5,6 M 9.35,4.36 L 10.5,6 M 11.65,4.36 L 10.5,6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rotation}" Value="UpsideDown">
                    <Setter Property="Data" Value="M 6,1.5 A 4.5,4.5 0 0 1 6,10.5 M 7.64,9.35 L 6,10.5 M 7.64,11.65 L 6,10.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rotation}" Value="Counterclockwise">
                    <Setter Property="Data" Value="M 6,1.5 A 4.5,4.5 0 1 1 1.5,6 M 0.35,7.64 L 1.5,6 M 2.65,7.64 L 1.5,6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One of the five little view switches above the cut list. Bare
             glyphs, so the tooltip is the only thing that names them — and,
             as with HeaderIcon, it is made to wait rather than appear on the
             way past.

             A ToggleButton rather than a Button because the set says which
             view is current as well as offering the others; the checked one
             is lit in the accent colour and the rest sit back in the panel's
             own quiet grey. -->
        <Style x:Key="ViewToggle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="800"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- Transparent rather than null, for the same reason
                             HeaderIcon's is: a null background is not a
                             hit-test target, so only the glyph's own strokes
                             would answer a click. -->
                        <Border x:Name="Chip" Background="Transparent" CornerRadius="3" Padding="5,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One space. Every gap in a bookmark row is one of these, so the
             row reads as though it were a single line of text:

                 [1] < 4s > - < 12s > (8s)

             A literal space rather than a margin in pixels — a margin would be
             a guess at the width of a space in whatever font and size the row
             ends up using, and would stop matching the moment either changed.
             Written as &#32; because a space is the one attribute value that
             cannot be read back from the file with any confidence. -->
        <Style x:Key="RowGap" TargetType="TextBlock">
            <Setter Property="Text" Value="&#32;"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The nudge arrows flanking each timestamp in the bookmark
             list. Hidden rather than collapsed off-hover: they keep their
             width, so the row reads the same whether or not the pointer is
             over it, and hovering reveals the arrows instead of shoving the
             timestamps sideways to make room for them. Off-hover the row is

                 [1]   4s   -   12s   (8s)

             where each of those runs is a space, an arrow's width, a space.

             The glyphs size to themselves and every gap is one space, so the
             only thing that can change a row's shape is the timestamps — which
             do change shape, at 59s → 1:00 and again at 59:59 → 1:00:00.
             Everything to the right of a nudged timestamp shifts to suit it;
             nothing between the arrows and the numbers ever moves. -->
        <Style x:Key="NudgeArrow" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <!-- White, but by way of the palette: a hardcoded #FFF would
                 disappear against the light theme's pale rows. -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="3000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent, not null: a null background is not a
                             hit-test target, and the arrow would only be
                             clickable on the glyph's own strokes. -->
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One style per arrow, because each asks a different question before
             showing itself: pointing over the row is necessary but not enough,
             the arrow also has to have somewhere left to go. An arrow that
             refuses the click reads as a broken button, so it is taken off the
             row instead — which is also how you can see, without pressing
             anything, that a timestamp is up against its limit. -->
        <Style x:Key="NudgeStartBack" TargetType="Button" BasedOn="{StaticResource NudgeArrow}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"/>
                        <Condition Binding="{Binding CanNudgeStartBack}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NudgeStartForward" TargetType="Button" BasedOn="{StaticResource NudgeArrow}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"/>
                        <Condition Binding="{Binding CanNudgeStartForward}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NudgeEndBack" TargetType="Button" BasedOn="{StaticResource NudgeArrow}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"/>
                        <Condition Binding="{Binding CanNudgeEndBack}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NudgeEndForward" TargetType="Button" BasedOn="{StaticResource NudgeArrow}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"/>
                        <Condition Binding="{Binding CanNudgeEndForward}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The one-click quick save at the head of each bookmark row. A save
             icon that becomes a check mark once the clip has been written.

             It was a radio button, which was wrong in two ways at once: a
             radio button promises a choice between the rows, and nothing here
             is being chosen — pressing it writes a file. And it had no way to
             say it had already been pressed, because a radio button in a group
             of its own stays filled whether it did anything or not. The icons
             carry both: what it does, and whether it has done it.

             Both sources are set on the same Image rather than one per state.
             Two images with their visibility swapped would each have to agree
             about size and position, and the one underneath would still be
             taking up layout. -->
        <Style x:Key="RowQuickSave" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <!-- The size of the box on the check box beside it, so the two
                 marks at the head of a row are the same weight. Measured off
                 the default WPF CheckBox template rather than guessed: its
                 "checkBoxBorder" draws 14 wide by 13 high inside a control
                 whose own footprint is 16 by 15. Not square, which is why the
                 icon below is Uniform and not Fill — it draws 13 by 13,
                 centered, rather than being squashed by a pixel. -->
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent for the same reason as the nudge
                             arrows: a null background is not a hit-test
                             target, so only the icon's own pixels would
                             answer the click, and a save glyph is mostly
                             empty space. -->
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="3"
                                ToolTip="Click to save this clip now — goes to the quick save folder, or next to the source video if none is set">
                            <Image x:Name="Glyph" Stretch="Uniform"
                                   Source="pack://application:,,,/Assets/icons/icon-quick_save.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Bound to the bookmark, which is this button's
                                 own DataContext inside the row template. -->
                            <DataTrigger Binding="{Binding QuickSaved}" Value="True">
                                <Setter TargetName="Glyph" Property="Source"
                                        Value="pack://application:,,,/Assets/icons/icon-check_mark.png"/>
                                <!-- Still live, and says so. Saving the same
                                     range twice is a reasonable thing to want
                                     — the first clip may have been moved or
                                     deleted — so the check mark reports, it
                                     does not refuse. -->
                                <Setter TargetName="Chrome" Property="ToolTip"
                                        Value="Already saved — click to save this clip again"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource ControlBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <!-- No access keys on any of these headers — no "_" in a Header below.
             Alt+<letter> would open a menu, and the timestamp hotkey is free to
             be any combination the user likes: binding one that collided meant
             the press went to the menu bar instead of to the bookmark, which is
             a strange thing to have to know. Everything here is reachable with
             the mouse, and the one keyboard action worth having — the hotkey
             itself — is global and configurable. -->
        <Menu x:Name="HeaderMenu" DockPanel.Dock="Top" Background="{DynamicResource MenuBarBackground}" Foreground="{DynamicResource MenuBarForeground}" FlowDirection="LeftToRight" Padding="4">
            <!-- x:Name, and not the header text, is what the code-behind finds
                 these by. Four menus are filled in at runtime, and looking them
                 up by header meant any change to the wording — a rename, an
                 icon — silently emptied them. -->
            <MenuItem x:Name="FileMenu" Header="&#128193; File">
                <MenuItem Header="Open…" Command="{Binding OpenFileCommand}"
                          ToolTip="Open a video file, bookmark CSV, or .pls playlist (auto-detected by extension)">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Where every action except the one-click row button writes.
                     Defaults to the loaded video's own folder and stays that
                     way until the user picks a folder, after which it is
                     pinned for the rest of the session. -->
                <MenuItem Header="{Binding SaveToFolderDisplay}" Command="{Binding SetSaveToFolderCommand}"
                          ToolTip="Destination for merge, split, convert, strip audio and bulk merge">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Quick save" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="{Binding QuickSaveFolderDisplay}" Command="{Binding SetQuickSaveFolderCommand}"
                          ToolTip="Destination for the one-click save button on each bookmark row">
                    <MenuItem.Icon>
                        <TextBlock Text="⚡" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Add quick save shortcut…" Command="{Binding AddQuickSaveShortcutCommand}"
                          ToolTip="Pick a folder to add to the quick save shortcut list above">
                    <MenuItem.Icon>
                        <TextBlock Text="➕" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator x:Name="ShortcutsStartSeparator" Visibility="Collapsed"/>
                <!-- Dynamic quick save shortcuts inserted here at runtime from
                     the ViewModel's QuickSaveShortcuts collection. Each has a
                     "Set" / "Remove" submenu; Set points the quick save folder
                     at it. ShortcutsEndSeparator stays visible at all times —
                     it doubles as the divider before the items below, so we
                     never end up with two consecutive separators. -->
                <Separator x:Name="ShortcutsEndSeparator" Visibility="Collapsed"/>
                <!-- An action, not a setting: there is nothing about it to
                     configure, and it is only useful just after something has
                     been written. Disabled until there is a file to show. -->
                <MenuItem Header="Program" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}"
                          ToolTip="Output format, view switching, and what happens to source files after an operation">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reset everything…" Command="{Binding ResetEverythingCommand}"
                          ToolTip="Restart the application (settings, history, naming tags, and shortcuts are preserved)">
                    <MenuItem.Icon>
                        <TextBlock Text="♻" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Exit" Click="Exit_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="✕" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem x:Name="EditMenu" Header="&#9998; Edit">
                <!-- The header names what will be reversed — "Undo the speed"
                     rather than a bare "Undo" — so the entry says what it is
                     about to do before it does it.

                     The stack hangs off it as a submenu, newest first. Undo on
                     its own only ever offers the one step, so stepping back six
                     changes meant pressing it six times and watching the list
                     jump with no way to see where it was going; here every step
                     is named and one click crosses all of them.

                     No marker for the present. Each row already says which way
                     it goes — "Undo the crop" above, "Redo the fade" below —
                     so a row saying "where you are now" told the reader what
                     the rows either side of it had already said.

                     A parent opens its submenu rather than running its own
                     command, so this one no longer undoes a step when clicked.
                     The first row in the list does exactly that, and Ctrl+Z is
                     untouched. -->
                <MenuItem Header="{Binding UndoEditHeader}"
                          ItemsSource="{Binding HistoryEntries}"
                          IsEnabled="{Binding HasHistory}"
                          InputGestureText="Ctrl+Z"
                          ToolTip="Every change to the bookmarks still on the stack, newest first. Click one to jump straight to it, however many steps away it is.">
                    <MenuItem.Icon>
                        <TextBlock Text="↶" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Display}"/>
                            <Setter Property="ToolTip" Value="{Binding Hint}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{Binding RedoEditHeader}" Command="{Binding RedoEditCommand}"
                          InputGestureText="Ctrl+Y">
                    <MenuItem.Icon>
                        <TextBlock Text="↷" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <!-- Grouped by what each operation acts on, in the same four
                 families the toolbar is coloured by — video, then audio, then
                 images, then everything else — with a separator between the
                 groups. The order used to follow how the operations were added
                 over time, which put Convert video between two image
                 operations and the frame grab on its own between them.

                 Every item carries the chip its family is painted, which is
                 also the icon the toolbar shows that operation as under Small
                 button icons. The family a chip is painted from is
                 ButtonColors.Membership, not a judgement made here: Mute reads
                 as an audio operation but it is a property of a cut rather than
                 something written out of a sound track, and it is in the
                 catch-all on the toolbar for the same reason. A pink chip here
                 beside a plain button there would be the menu and the toolbar
                 disagreeing. -->
            <MenuItem Header="&#9889; Actions">
                <MenuItem Header="Video" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Merge selected / all / any" Command="{Binding MergeSelectedCommand}"
                          ToolTip="Merges the checked bookmarks, or every bookmark, or — with no video loaded — files you pick. A single bookmark is written out on its own as a trim.">
                    <MenuItem.Icon>
                        <TextBlock Text="🎬" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Split selected / all" Command="{Binding SplitSelectedCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="✂" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Not gated like the modifiers further down: a crop needs a
                     picture and nothing else, so with no video loaded it asks
                     for one and with no cuts it offers the whole video. -->
                <MenuItem Header="Crop…" Command="{Binding CropSelectedCommand}"
                          ToolTip="Draw the part of the frame to keep — on the chosen bookmarks, or on a whole video">
                    <MenuItem.Icon>
                        <TextBlock Text="⬚" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Convert files to MP4…" Command="{Binding ConvertFilesCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- The alternative to cutting: keep the file whole and make
                     the bookmarks navigable inside it. Streams are copied, so
                     it is lossless regardless of the cut-accuracy setting. -->


                <MenuItem Header="Audio" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Strip audio…" Command="{Binding StripAudioCommand}"
                          ToolTip="Pulls the sound out of files you pick: an MP3 of the audio, a silent copy of the video, or both. The file you pick is not changed.">
                    <MenuItem.Icon>
                        <TextBlock Text="🔊" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>


                <MenuItem Header="Images" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Save the frame on screen…" Command="{Binding SaveCurrentFrameCommand}"
                          ToolTip="Write the frame MPC-HC is showing to a PNG at its own size. The time is part of the filename, so a run of them does not collide.">
                    <MenuItem.Icon>
                        <TextBlock Text="📷" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Works off a file rather than off the session, so it is
                     never disabled: with a video loaded it acts on that one,
                     and with nothing loaded it asks for one. -->
                <MenuItem Header="Save thumbnails…" Command="{Binding SaveThumbnailsCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="▦" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export bookmarks as GIF / WebP…" Command="{Binding ExportAnimationCommand}"
                          ToolTip="Write each checked bookmark as an animated GIF or WebP, with no sound. Asks for the frame rate and width, which are what decide the size.">
                    <MenuItem.Icon>
                        <TextBlock Text="🎞" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Target format is the CommandParameter, so picking one is a
                     single gesture rather than a menu click then a dialog. -->
                <MenuItem Header="Image conversion" ToolTip="Convert image files to another format">
                    <MenuItem.Icon>
                        <TextBlock Text="🖼" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                    <MenuItem Header="To PNG…" Command="{Binding ConvertImagesCommand}" CommandParameter="png">
                        <MenuItem.Icon>
                            <TextBlock Text="🖼" Style="{StaticResource MenuGlyph}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="To JPG…" Command="{Binding ConvertImagesCommand}" CommandParameter="jpg">
                        <MenuItem.Icon>
                            <TextBlock Text="🖼" Style="{StaticResource MenuGlyph}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="To JPEG…" Command="{Binding ConvertImagesCommand}" CommandParameter="jpeg">
                        <MenuItem.Icon>
                            <TextBlock Text="🖼" Style="{StaticResource MenuGlyph}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="To BMP…" Command="{Binding ConvertImagesCommand}" CommandParameter="bmp">
                        <MenuItem.Icon>
                            <TextBlock Text="🖼" Style="{StaticResource MenuGlyph}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="To GIF…" Command="{Binding ConvertImagesCommand}" CommandParameter="gif">
                        <MenuItem.Icon>
                            <TextBlock Text="🖼" Style="{StaticResource MenuGlyph}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="To TIFF…" Command="{Binding ConvertImagesCommand}" CommandParameter="tiff">
                        <MenuItem.Icon>
                            <TextBlock Text="🖼" Style="{StaticResource MenuGlyph}"/>
