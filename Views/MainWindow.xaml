                    <MenuItem.Icon>
                        <TextBlock Text="↕" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rotate" Command="{Binding RotateSelectedCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="⟳" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Mute" Command="{Binding ToggleMuteCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="🔇" Style="{StaticResource MenuGlyph}"/>
