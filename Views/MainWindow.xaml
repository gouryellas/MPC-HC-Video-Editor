                </MenuItem>
                <MenuItem Header="Play" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Play all bookmarks" Command="{Binding PlayAllCommand}"
                          ToolTip="Seek MPC-HC to each bookmark and play it for its full duration, sequentially">
                    <MenuItem.Icon>
