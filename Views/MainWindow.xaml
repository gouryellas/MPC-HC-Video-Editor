<!-- Title is set in the constructor from the assembly version — see AppVersion.
     The literal that used to be on the Title attribute below is why 3.0.1
     shipped with a window still captioned 3.0; what is left there is only what
     the XAML designer shows. -->
<Window x:Class="MpcHcVideoEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MpcHcVideoEditor.ViewModels"
        xmlns:helpers="clr-namespace:MpcHcVideoEditor.Helpers"
        Title="MPC-HC Video Editor"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="780" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Ctrl+Z / Ctrl+Y reach the same commands as the Edit menu. Bound on the
         window so they work wherever focus happens to be — except inside a text
         box, where the TextBox's own undo handles the keystroke first, which is
         what someone editing a cut's name would expect. -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoEditCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoEditCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:ProgressToBrushConverter x:Key="ProgressBrush"/>


        <Style TargetType="Button" x:Key="DarkButton">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}"/>

        <!-- The menu strip keeps system-like chrome rather than following the
             app's canvas, so its two colors are their own palette roles. -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource MenuBarBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuBarForeground}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuBarForeground}"/>
            <Setter Property="Background" Value="{DynamicResource MenuBarBackground}"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LinkBlue}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MenuBarForeground}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource TextDim}"/>
        </Style>

        <!-- Clickable timestamp look: teal, no underline by default,
             underline + brighter color on hover, hand cursor.
             Used for the bookmark timestamp hyperlinks. -->
        <Style x:Key="TimestampLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to seek MPC-HC to this time"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A bare glyph acting on the file named under a right-panel heading:
             the pencil that opens the bookmark CSV, the folder that shows the
             video in Explorer.

             Visibility follows IsEnabled, which the bound command's CanExecute
             already drives, so "only shown when there is something to act on"
             and "only clickable when there is something to act on" cannot
             drift apart — there is one answer and the command owns it. -->
        <Style x:Key="HeaderIcon" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent, not null: a null background is not a
                             hit-test target, and the icon would only be
                             clickable on the glyph's own strokes. -->
                        <Border Background="Transparent" Padding="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One space. Every gap in a bookmark row is one of these, so the
             row reads as though it were a single line of text:

                 [1] < 4s > - < 12s > (8s)

             A literal space rather than a margin in pixels — a margin would be
             a guess at the width of a space in whatever font and size the row
             ends up using, and would stop matching the moment either changed.
             Written as &#32; because a space is the one attribute value that
             cannot be read back from the file with any confidence. -->
        <Style x:Key="RowGap" TargetType="TextBlock">
            <Setter Property="Text" Value="&#32;"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The frame-nudge arrows flanking each timestamp in the bookmark
             list. Hidden rather than collapsed off-hover: they keep their
             width, so the row reads the same whether or not the pointer is
             over it, and hovering reveals the arrows instead of shoving the
             timestamps sideways to make room for them. Off-hover the row is

                 [1]   4s   -   12s   (8s)

             where each of those runs is a space, an arrow's width, a space.

             The glyphs size to themselves and every gap is one space, so the
             only thing that can change a row's shape is the timestamps — which
             do change shape, at 59s → 1:00 and again at 59:59 → 1:00:00.
             Everything to the right of a nudged timestamp shifts to suit it;
             nothing between the arrows and the numbers ever moves. -->
        <Style x:Key="NudgeArrow" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <!-- White, but by way of the palette: a hardcoded #FFF would
                 disappear against the light theme's pale rows. -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent, not null: a null background is not a
                             hit-test target, and the arrow would only be
                             clickable on the glyph's own strokes. -->
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBright}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu x:Name="HeaderMenu" DockPanel.Dock="Top" Background="{DynamicResource MenuBarBackground}" Foreground="{DynamicResource MenuBarForeground}" FlowDirection="LeftToRight" Padding="4">
            <!-- x:Name, and not the header text, is what the code-behind finds
                 these by. Four menus are filled in at runtime, and looking them
                 up by header meant any change to the wording — a rename, an
                 icon — silently emptied them. -->
            <MenuItem x:Name="FileMenu" Header="&#128193; _File">
                <MenuItem Header="Open…" Command="{Binding OpenFileCommand}"
                          ToolTip="Open a video file, bookmark CSV, or .pls playlist (auto-detected by extension)"/>
                <!-- Where every action except the one-click row button writes.
                     Defaults to the loaded video's own folder and stays that
                     way until the user picks a folder, after which it is
                     pinned for the rest of the session. -->
                <MenuItem Header="{Binding SaveToFolderDisplay}" Command="{Binding SetSaveToFolderCommand}"
                          ToolTip="Destination for merge, split, convert, strip audio and bulk merge"/>
                <MenuItem Header="{Binding QuickSaveFolderDisplay}" Command="{Binding SetQuickSaveFolderCommand}"
                          ToolTip="Destination for the one-click save button on each bookmark row"/>
                <Separator x:Name="ShortcutsStartSeparator"/>
                <!-- Dynamic quick save shortcuts inserted here at runtime from
                     the ViewModel's QuickSaveShortcuts collection. Each has a
                     "Set" / "Remove" submenu; Set points the quick save folder
                     at it. ShortcutsEndSeparator stays visible at all times —
                     it doubles as the divider before the items below, so we
                     never end up with two consecutive separators. -->
                <Separator x:Name="ShortcutsEndSeparator"/>
                <MenuItem Header="Add quick save shortcut…" Command="{Binding AddQuickSaveShortcutCommand}"
                          ToolTip="Pick a folder to add to the quick save shortcut list above"/>
                <Separator/>
                <!-- An action, not a setting: there is nothing about it to
                     configure, and it is only useful just after something has
                     been written. Disabled until there is a file to show. -->
                <MenuItem Header="Reveal last output in Explorer" Command="{Binding RevealOutputCommand}"
                          ToolTip="Open Explorer with the file this program last wrote selected"/>
                <Separator/>
                <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}"
                          ToolTip="Output format, view switching, and what happens to source files after an operation"/>
                <MenuItem Header="Reset everything…" Command="{Binding ResetEverythingCommand}"
                          ToolTip="Restart the application (settings, history, naming tags, and shortcuts are preserved)"/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="&#9998; _Edit">
                <!-- The headers name what will be reversed — "Undo the speed"
                     rather than a bare "Undo" — so the entry says what it is
                     about to do before it does it. -->
                <MenuItem Header="{Binding UndoEditHeader}" Command="{Binding UndoEditCommand}"
                          InputGestureText="Ctrl+Z"
                          ToolTip="Step back through changes to the cuts. Operations that have already written a file are not included — see the note in the manual."/>
                <MenuItem Header="{Binding RedoEditHeader}" Command="{Binding RedoEditCommand}"
                          InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="&#9889; _Actions">
                <MenuItem Header="Merge selected / all / any" Command="{Binding MergeSelectedCommand}"
                          ToolTip="Merges the checked cuts, or every cut, or — with no video loaded — files you pick. A single cut is written out on its own as a trim.">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="{DynamicResource PrimaryButton}" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Split selected / all" Command="{Binding SplitSelectedCommand}">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="{DynamicResource SplitBackground}" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Convert files to MP4…" Command="{Binding ConvertFilesCommand}">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="{DynamicResource ConvertBackground}" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Strip audio to MP3…" Command="{Binding StripAudioCommand}">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="{DynamicResource AudioBackground}" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- Target format is the CommandParameter, so picking one is a
                     single gesture rather than a menu click then a dialog. -->
                <MenuItem Header="Image conversion" ToolTip="Convert image files to another format">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="{DynamicResource SplitBorder}" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                    <MenuItem Header="To PNG…"  Command="{Binding ConvertImagesCommand}" CommandParameter="png"/>
                    <MenuItem Header="To JPG…"  Command="{Binding ConvertImagesCommand}" CommandParameter="jpg"/>
                    <MenuItem Header="To JPEG…" Command="{Binding ConvertImagesCommand}" CommandParameter="jpeg"/>
                    <MenuItem Header="To BMP…"  Command="{Binding ConvertImagesCommand}" CommandParameter="bmp"/>
                    <MenuItem Header="To GIF…"  Command="{Binding ConvertImagesCommand}" CommandParameter="gif"/>
                    <MenuItem Header="To TIFF…" Command="{Binding ConvertImagesCommand}" CommandParameter="tiff"/>
                    <MenuItem Header="To ICO…"  Command="{Binding ConvertImagesCommand}" CommandParameter="ico"
                              ToolTip="Scaled to 256px if larger — the ICO format cannot express more"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Find clips automatically…" Command="{Binding DetectBookmarksCommand}"
                          ToolTip="Scans the video for silence, black frames or scene cuts and proposes bookmarks you can review before accepting"/>
                <Separator/>
                <!-- The alternative to cutting: keep the file whole and make
                     the bookmarks navigable inside it. Streams are copied, so
                     it is lossless regardless of the cut-accuracy setting. -->
                <MenuItem Header="Export as chapters…" Command="{Binding ExportChaptersCommand}"
                          ToolTip="Writes the video out once with the bookmarks as chapter marks, instead of cutting it into separate clips"/>
            </MenuItem>
            <MenuItem Header="&#9000; _Hotkey">
                <!-- Header shows the current binding live (e.g. "Hotkey: MButton",
                     "Hotkey: Ctrl+Shift+T", "Hotkey: OFF"). Bound to the
                     ViewModel's HotkeyMenuLabel which is updated whenever the
                     binding changes. -->
                <MenuItem Header="{Binding HotkeyMenuLabel}" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Set timestamp hotkey…" Command="{Binding SetTimestampHotkeyCommand}"
                          ToolTip="Pick a mouse button or capture a keyboard combination"/>
                <MenuItem Header="Disable hotkey" Command="{Binding DisableTimestampHotkeyCommand}"/>
            </MenuItem>
            <MenuItem Header="&#128278; _Bookmarks">
                <!-- Header carries the live hotkey binding, e.g.
                     "Set timestamp: MButton". Bound to SetTimestampMenuLabel. -->
                <MenuItem Header="{Binding SetTimestampMenuLabel}" Command="{Binding SetTimestampCommand}"
                          ToolTip="Set a timestamp at the current MPC-HC position — toggles open/close automatically"/>
                <MenuItem Header="Undo last bookmark" Command="{Binding UndoLastBookmarkCommand}"
                          ToolTip="Remove the most recently added bookmark from the GUI and CSV"/>
                <Separator/>
                <MenuItem Header="Edit bookmarks" Command="{Binding EditBookmarksCommand}"
                          ToolTip="Open the bookmark CSV in a text editor — changes are picked up when this window regains focus"/>
                <MenuItem Header="Enter time / range…" Command="{Binding EnterTimeManualCommand}"/>
                <MenuItem Header="Delete bookmarks" Command="{Binding DeleteBookmarksCommand}"
                          ToolTip="Delete the bookmark file from disk"/>
                <MenuItem Header="Remove selected timestamps" Command="{Binding DeleteSelectedCommand}"
                          ToolTip="Remove the checked timestamps from the list and from the bookmark file"/>
                <Separator/>
                <MenuItem Header="Play all cuts" Command="{Binding PlayAllCommand}"
                          ToolTip="Seek MPC-HC to each bookmark and play it for its full duration, sequentially"/>
                <MenuItem Header="Play selected cuts" Command="{Binding PlaySelectedCommand}"
                          ToolTip="Same as Play all, but only the cuts you've checked"/>
                <Separator/>
                <MenuItem Header="Select all" Command="{Binding SelectAllCommand}"/>
                <MenuItem Header="Select none" Command="{Binding SelectNoneCommand}"/>
                <Separator/>
            </MenuItem>
            <MenuItem x:Name="PlaylistMenu" Header="&#127902; _Playlist">
                <MenuItem Header="{Binding PlaylistFolderDisplay}" Command="{Binding SetPlaylistFolderCommand}"
                          ToolTip="Folder scanned for playlists (.pls, .m3u8)"/>
                <!-- These three are Click handlers rather than commands, so
                     they cannot be gated by CanExecute — IsEnabled binds to
                     the equivalent ViewModel predicate instead. -->
                <MenuItem Header="Refresh list" Click="RefreshPlaylists_Click"
                          IsEnabled="{Binding HasPlaylistFiles}"
                          ToolTip="Re-read the playlist folder and rebuild this menu"/>
                <MenuItem Header="Load playlist…" Click="LoadPlaylist_Click"
                          ToolTip="Load a .pls playlist — subsequent Add-to-playlist actions route to it directly"/>
                <!-- Gated on a playlist simply being loaded. It used to key off
                     the loaded playlist still having entries, which was cached
                     and went stale — leaving this grayed out with a playlist
                     plainly loaded. An empty playlist can no longer be loaded
                     at all, so the entry count adds nothing here. -->
                <MenuItem Header="Unload playlist" Click="ClearLoadedPlaylist_Click"
                          IsEnabled="{Binding HasLoadedPlaylist}"
                          ToolTip="Forget the currently-loaded playlist — Add-to-playlist will prompt again"/>
                <Separator x:Name="PlaylistStartSeparator" Visibility="Collapsed"/>
                <!-- Dynamic per-playlist entries inserted here at runtime
                     by MainWindow.xaml.cs. Each playlist is headed by its
                     name and the number of entries it lists — "clips.pls (50)"
                     — and expands to show those entries (numbered 1, 2, 3, …)
                     plus actions: View playlist content / Load this playlist /
                     Add current video / Remove missing entries / Delete playlist.
                     PlaylistEndSeparator doubles as the divider before
                     "New playlist…" — no extra static separator needed. -->
                <MenuItem Header="(no playlist folder set)" IsEnabled="False" x:Name="PlaylistEmptyPlaceholder"/>
                <Separator x:Name="PlaylistEndSeparator" Visibility="Collapsed"/>
                <MenuItem Header="New playlist…" Click="NewPlaylist_Click"
                          ToolTip="Create a new empty .pls file in the playlist folder"/>
                <MenuItem Header="{Binding AddToPlaylistMenuLabel}" Command="{Binding AddCurrentToPlaylistCommand}"
                          ToolTip="{Binding AddToPlaylistToolTip}"/>
            </MenuItem>

            <!-- History — the recently-played videos, promoted out of the File
                 menu to a top-level menu of its own. Entries between the two
                 named separators are inserted at runtime from RecentVideos. -->
            <MenuItem Header="&#128336; H_istory" x:Name="RecentMenuItem" ToolTip="Recently played videos">
                <MenuItem Header="(no recent videos)" IsEnabled="False" x:Name="RecentEmptyPlaceholder"/>
                <Separator x:Name="RecentStartSeparator" Visibility="Collapsed"/>
                <!-- Dynamic per-video entries inserted here at runtime -->
                <Separator x:Name="RecentEndSeparator" Visibility="Collapsed"/>
                <MenuItem Header="Clear history" Click="ClearRecentList_Click" x:Name="RecentClearItem" IsEnabled="False"/>
            </MenuItem>
            <!-- Shortcuts menu — lets the user add folder shortcuts that then
                 appear as clickable items at the bottom of the File menu. -->
            <MenuItem x:Name="ShortcutsMenu" Header="&#128279; Sho_rtcuts">
                <MenuItem Header="Add shortcut…" Command="{Binding AddShortcutCommand}"/>
                <MenuItem Header="Manage shortcuts…" Command="{Binding ManageShortcutsCommand}"/>
                <Separator x:Name="ShortcutsMenuStartSeparator"/>
                <!-- Dynamic per-shortcut "Open" + "Rename…" + "Remove" entries
                     appended here at runtime by MainWindow.xaml.cs. These open
                     a folder in Explorer and have nothing to do with the
                     quick save shortcuts in the File menu. -->
            </MenuItem>
            <!-- Suffix menu — manages filename suffixes appended to all video
                 outputs (merge, split, convert, strip audio, bulk merge).
                 The first item shows the currently-active suffix; the dynamic
                 list below lets the user switch by clicking. -->
            <MenuItem x:Name="OptionsMenu" Header="&#9881; _Options">
                <!-- Not IsEnabled="False", unlike the example line below it: the
                     MenuItem style grays disabled items to #888888, and this is
                     the one line here that says which tag is actually in use, so
                     it stays at full contrast. It has no Command, so it is still
                     a label — clicking it just closes the menu. -->
                <MenuItem Header="{Binding ActiveSuffixDisplay}"/>
                <MenuItem Header="{Binding SuffixExampleDisplay}" IsEnabled="False"/>
                <Separator x:Name="SuffixListStartSeparator"/>
                <!-- Dynamic per-suffix entries inserted here at runtime by
                     MainWindow.xaml.cs. The active one gets a ✓ prefix;
                     clicking any entry sets it as active. SuffixListEndSeparator
                     doubles as the divider before "Add suffix…" — no extra
                     static separator needed. -->
                <Separator x:Name="SuffixListEndSeparator"/>
                <MenuItem Header="Add new naming tag…" Command="{Binding AddSuffixCommand}"/>
                <MenuItem Header="Manage naming tags…" Command="{Binding ManageSuffixesCommand}"/>
            </MenuItem>
            <MenuItem Header="&#128421; _View">
                <MenuItem Header="Bring MPC-HC to front" Command="{Binding BringMpcToFrontCommand}"/>
                <Separator/>
                <!-- The whole of the view control, and on by default. Picking
                     the view by hand is gone: Minimal and Full were a mode the
                     user had to keep in their head, with nothing on screen
                     saying which one was in force, and the automatic behavior
                     is what both of them were usually being used to get.

                     Off leaves this window up permanently. The hotkey still
                     works there — it says what it recorded in a toast, since
                     this window is behind the player at the time. -->
                <MenuItem Header="Switch views automatically" IsCheckable="True"
                          IsChecked="{Binding AutoSwitchViews, Mode=TwoWay}"
                          ToolTip="Drop to the minimal overlay whenever MPC-HC becomes the active window. Either way, this window returns as soon as MPC-HC stops being active. Press X over the overlay to bring this window back."/>
            </MenuItem>

            <MenuItem Header="&#10067; _Help">
                <MenuItem Header="About…" Command="{Binding ShowAboutCommand}"
                          ToolTip="Version, licensing and third-party components"/>
                <MenuItem Header="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                          ToolTip="Ask GitHub whether a newer release has been published. Works whether or not the startup check is turned on."/>
                <Separator/>
                <MenuItem Header="GitHub repository" Command="{Binding OpenRepositoryCommand}"
                          ToolTip="https://github.com/gouryellas/MPC-HC-Video-Editor"/>
                <MenuItem Header="Report an issue" Command="{Binding OpenIssuesCommand}"
                          ToolTip="Open the issue tracker in your browser"/>
                <Separator/>
                <MenuItem Header="Licenses" Command="{Binding ShowAboutCommand}"
                          ToolTip="License terms for this app and the components it uses"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PrimaryButton}" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Marquee rather than TextBlock: "Created <name> — <warning>"
                     runs past the end of the bar on a long file name, and the
                     warning is the half that gets clipped. -->
                <helpers:MarqueeText Text="{Binding StatusText}" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="{Binding HotkeyStatus}" Foreground="{DynamicResource ValueYellow}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMpcRunning, Converter={StaticResource BoolToVis}}" Margin="16,0,0,0">
                        <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="{DynamicResource StatusOk}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " Foreground="{DynamicResource AccentBright}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DurationDisplay}" Foreground="{DynamicResource AccentBright}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <ProgressBar Grid.Column="2" Width="160" Height="8"
                             Value="{Binding ProgressPercent}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             Background="{DynamicResource PrimaryButton}" Foreground="{DynamicResource OnAccent}"/>
            </Grid>
        </Border>

        <!-- Job progress. Sits above the status bar and only takes space while
             an operation is running. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackground}" Padding="12,8"
                Visibility="{Binding Job.IsRunning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Job.Action}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Job.FileCountDisplay}" Foreground="{DynamicResource TextSecondary}"
                               Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Job.PercentDisplay}" Foreground="{DynamicResource TextPrimary}"
                               FontWeight="SemiBold"/>
                </Grid>

                <TextBlock Text="{Binding Job.CurrentFile}" Foreground="{DynamicResource Accent}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding Job.Step}" Foreground="{DynamicResource ValueYellow}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                <!-- Color comes from the percentage itself, ramping black →
                     red → orange → yellow → green. -->
                <Border Background="{DynamicResource TimelineTrack}" CornerRadius="3" Height="14" Padding="2">
                    <Grid>
                        <Rectangle HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                   Fill="{Binding Job.Percent, Converter={StaticResource ProgressBrush}}"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Job.PercentFraction}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>

                <Grid Margin="0,6,0,0">
                    <TextBlock Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left">
                        <Run Text="Elapsed"/><Run Text="  "/><Run Text="{Binding Job.ElapsedDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right">
                        <Run Text="Remaining"/><Run Text="  "/><Run Text="{Binding Job.RemainingDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar. WrapPanel, not StackPanel: a horizontal StackPanel
                 keeps laying out past the right edge, so at narrow widths the
                 last buttons were cut off rather than moving to a second row. -->
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="📍 Set timestamp" Command="{Binding SetTimestampCommand}" ToolTip="Set a timestamp at the current MPC-HC position"/>
                <Button Content="🗑" Command="{Binding DeleteSelectedCommand}" Width="36" ToolTip="Delete selected"/>
                <Button Content="↕ Flip" Command="{Binding ToggleFlipCommand}" ToolTip="Toggle vertical flip"/>
                <!-- Cycles rather than toggles: one button reaching four states
                     beats three buttons, and the order matches the way someone
                     correcting sideways footage would try them. -->
                <Button Content="⟳ Rotate" Command="{Binding RotateSelectedCommand}"
                        ToolTip="Turn the selected cuts a quarter further round — right, upside down, left, then back to normal"/>
                <Button Content="🔇 Mute" Command="{Binding ToggleMuteCommand}"
                        ToolTip="Write the selected cuts without sound. The audio track stays in place carrying silence, so a merge of muted and unmuted cuts still joins cleanly."/>
                <Rectangle Width="12"/>
                <Button Content="Select All" Command="{Binding SelectAllCommand}"/>
                <Button Content="None" Command="{Binding SelectNoneCommand}"/>
                <Rectangle Width="12"/>
                <!-- Bulk merge sits next to Merge; the rest keep their order.
                     None of these set an explicit Width — the button style
                     pads around the content, so each one is as wide as its
                     text needs. A fixed width was clipping "Convert video". -->
                <Button Content="🎬 Merge" Command="{Binding MergeSelectedCommand}"
                        Background="{DynamicResource PrimaryButton}" BorderBrush="{DynamicResource PrimaryButtonBorder}" FontWeight="SemiBold"/>
                <Button Content="✂ Split" Command="{Binding SplitSelectedCommand}"
                        Background="{DynamicResource SplitBackground}" BorderBrush="{DynamicResource SplitBorder}"/>
                <Button Content="🔄 Convert video" Command="{Binding ConvertFilesCommand}"
                        Background="{DynamicResource ConvertBackground}" BorderBrush="{DynamicResource ConvertBorder}"/>
                <Button Content="🔊 Strip audio" Command="{Binding StripAudioCommand}"
                        Background="{DynamicResource AudioBackground}" BorderBrush="{DynamicResource AudioBorder}"/>
                <!-- "Edit bookmarks" is the pencil beside CURRENT BOOKMARKS in
                     the right panel now, next to the file it opens. "Enter
                     time" keeps its Actions menu entry; neither was earning a
                     button across the top. -->
            </WrapPanel>

            <!-- Timeline. Bottom to top: track, playback position, then the
                 bookmark ranges drawn across the upper half so they read as
                 marks on the bar rather than competing with the position. -->
            <Grid Grid.Row="1" Margin="0,0,0,8" Height="18">
                <Border Background="{DynamicResource TimelineTrack}" CornerRadius="3"/>

                <!-- The audio, behind everything else. Stretched to the bar's
                     width rather than re-rendered on resize: it is a guide to
                     where sound is, not a measurement, and decoding the whole
                     track again for a crisper approximation is a poor trade.
                     Dimmed so the range marks and position stay readable over
                     it. Absent when the video has no audio, which is simply
                     nothing to draw. -->
                <Image Source="{Binding Waveform}" Stretch="Fill" Opacity="0.38"
                       IsHitTestVisible="False"/>

                <ProgressBar Value="{Binding TimelineProgress}" Minimum="0" Maximum="1"
                             Height="6" Margin="0,6" Background="Transparent"
                             Foreground="{DynamicResource PrimaryButton}" BorderThickness="0"/>

                <helpers:TimelineRanges Height="8" Margin="0,2,0,8"
                                        VerticalAlignment="Top"
                                        Bookmarks="{Binding Session.Bookmarks}"
                                        DurationSeconds="{Binding Session.VideoDurationSeconds}"
                                        ToolTip="Bookmarked ranges — teal when checked, orange when marked for inversion, red tick for an open bookmark"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- List -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                    <DockPanel>
                        <!-- Columns mirror the row template below so the captions
                             sit over the controls they name. The speed slider had
                             nothing labelling it at all: what it did was only
                             discoverable by dragging one and watching the clip
                             length change. -->
                        <Grid DockPanel.Dock="Top" Margin="4,2,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <!-- The count reads CompletePairCount, not
                                 Bookmarks.Count as the old "n items" did: a lone
                                 opening timestamp still awaiting its close is a
                                 row in the list but not yet a cut, and counting
                                 it promised one more clip than a split would
                                 produce. Spans column 3 as well, which the count
                                 used to occupy — "Bookmarks: 12" does not fit
                                 the 88px the first three columns give it. -->
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="4"
                                       Text="{Binding CompletePairCount, StringFormat='Bookmarks: {0}'}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Text="PLAY SPEED"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" LineHeight="11"
                                       ToolTip="Each clip can be written out slower or faster than it was recorded. Drag a row's slider to change that clip; the length beside it updates to match."/>
                        </Grid>

                        <ListView ItemsSource="{Binding Session.Bookmarks}"
                                  SelectedItem="{Binding SelectedBookmark}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextBody}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RowSelected}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="26"/>
                                            <!-- Auto, not a fixed 34: the index is followed by
                                                 exactly one space, and a fixed column would pad
                                                 "[1]" out to the width of "[10]" instead. -->
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- One-click split: clicking this radio button
                                             immediately FFmpeg-splits just this clip into
                                             the quick save folder (File ▸ "Quick save: …"),
                                             or next to the source video when that folder is
                                             unset, using the active suffix. Only shown on
                                             complete (valid) bookmarks. -->
                                        <RadioButton Grid.Column="0"
                                                     GroupName="{Binding Index}"
                                                     Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"
                                                     Command="{Binding DataContext.SplitSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                     CommandParameter="{Binding}"
                                                     ToolTip="Click to save this clip now — goes to the quick save folder, or next to the source video if none is set"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Cursor="Hand"/>
                                        <!-- Disabled rather than hidden while the bookmark is
                                             still open: it shows the checkbox is coming once a
                                             closing timestamp is set, instead of the row
                                             silently changing shape. -->
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsValid}"
                                                  ToolTip="Set a closing timestamp before this cut can be selected"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Index, StringFormat=[{0}]}" FontWeight="Bold" Foreground="{DynamicResource LinkBlue}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Only present while chapter names are in use.
                                                 With the setting off there is nothing to edit,
                                                 and an empty box on every row would be a column
                                                 of noise for the many sessions that are one cut
                                                 and done. -->
                                            <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Width="130" Margin="0,0,8,0" Padding="4,2"
                                                     Background="{DynamicResource ControlBackground}"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="This cut's name. Used as the chapter title when exporting chapters. Rename it to anything; renaming one does not disturb the others."
                                                     Visibility="{Binding DataContext.UseChapterNames, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVis}}"/>

                                            <!-- [1] < 4s > - < 12s > (8s), one space between each
                                                 of them. Nudging the opening mark by a frame is
                                                 the common correction — a cut that is one frame
                                                 late — and retyping the whole timestamp was
                                                 previously the only way to make it. -->
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <Button Content="&lt;" Style="{StaticResource NudgeArrow}"
                                                    Command="{Binding DataContext.NudgeFrameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="start-"
                                                    ToolTip="Move the start one frame earlier"/>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <TextBlock ToolTip="Click to seek MPC-HC to this time">
                                                <Hyperlink Style="{StaticResource TimestampLink}"
                                                           Tag="{Binding StartSeconds}"
                                                           Click="TimestampHyperlink_Click">
                                                    <Run Text="{Binding StartDisplay, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <Button Content="&gt;" Style="{StaticResource NudgeArrow}"
                                                    Command="{Binding DataContext.NudgeFrameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="start+"
                                                    ToolTip="Move the start one frame later"/>

                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <TextBlock Text="-" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource RowGap}"/>

                                            <Button Content="&lt;" Style="{StaticResource NudgeArrow}"
                                                    Command="{Binding DataContext.NudgeFrameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="end-"
                                                    ToolTip="Move the end one frame earlier"/>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <TextBlock ToolTip="Click to seek MPC-HC to this time">
                                                <Hyperlink Style="{StaticResource TimestampLink}"
                                                           Tag="{Binding EndSeconds}"
                                                           Click="TimestampHyperlink_Click">
                                                    <Run Text="{Binding EndDisplay, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <Button Content="&gt;" Style="{StaticResource NudgeArrow}"
                                                    Command="{Binding DataContext.NudgeFrameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="end+"
                                                    ToolTip="Move the end one frame later"/>

                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <TextBlock Text="{Binding DurationDisplay, StringFormat=({0})}" Foreground="{DynamicResource ValueGreen}" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <TextBlock Text="incomplete" Foreground="{DynamicResource StatusError}" FontStyle="Italic" VerticalAlignment="Center"
                                                       Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Flip, rotation and mute. The speed keeps its own two
                                             columns, so it is not stated twice — the overlay
                                             combines all four instead, where there is no room
                                             for columns (see Bookmark.Prefix). -->
                                        <TextBlock Grid.Column="4" Text="{Binding RowMarkers}" Foreground="{DynamicResource StatusWarn}"
                                                   FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"/>

                                        <Slider Grid.Column="5" Minimum="0.25" Maximum="2.0" TickFrequency="0.25"
                                                IsSnapToTickEnabled="True" Value="{Binding Speed, Mode=TwoWay}"
                                                VerticalAlignment="Center" Width="80"
                                                ToolTip="How fast this clip plays when it is saved. Left is slower, right is faster; the clip's length changes to match."/>

                                        <TextBlock Grid.Column="6" Text="{Binding SpeedDisplay}" Foreground="{DynamicResource LinkBlue}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   ToolTip="{Binding EffectiveDurationDisplay, StringFormat=Saved clip will run {0}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Right panel -->
                <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CURRENT VIDEO" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button Content="📁" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding RevealVideoCommand}"
                                    ToolTip="Show this video in Explorer"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Session.VideoFileName}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" FontSize="14" Margin="0,0,0,16"/>

                        <!-- No video means no duration to report, so the whole
                             block goes rather than showing 00:00. -->
                        <StackPanel Visibility="{Binding Session.HasVideo, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DURATION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding DurationDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,14"/>
                        </StackPanel>

                        <!-- Edit length needs a video, a loaded bookmark file
                             and at least one complete pair. It shows the sum of
                             the checked cuts, or of every cut when none are
                             checked (see EditSession.SelectedDurationSeconds). -->
                        <StackPanel Visibility="{Binding HasEditLength, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="EDIT LENGTH" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding Session.SelectedDurationDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ValueYellow}" Margin="0,2,0,18"/>
                        </StackPanel>

                        <!-- First and last frame of the highlighted clip. Only the
                             selected one is rendered: two frames per selection is
                             free, two per bookmark across a long list is hundreds
                             of ffmpeg launches for pictures nobody looks at. The
                             frames appear a moment after the labels, which is why
                             the placeholders below carry a background. -->
                        <StackPanel Visibility="{Binding HasClipPreview, Converter={StaticResource BoolToVis}}">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding ClipPreviewHeading}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Background="{DynamicResource InsetBackground}" CornerRadius="3" Height="76">
                                        <Image Source="{Binding ClipInThumbnail}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="IN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Background="{DynamicResource InsetBackground}" CornerRadius="3" Height="76">
                                        <Image Source="{Binding ClipOutThumbnail}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="OUT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ValueYellow}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,6,0,16" TextWrapping="Wrap"
                                       Text="{Binding ClipPreviewSubtext}"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CURRENT BOOKMARKS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button Content="✎" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding EditBookmarksCommand}"
                                    ToolTip="Open the bookmark CSV in a text editor — changes are picked up when this window regains focus"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BookmarksFileName}" TextWrapping="Wrap" Foreground="{DynamicResource ValueGreen}" FontSize="14" Margin="0,0,0,14"/>

                        <TextBlock Text="CURRENT PLAYLIST" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PlaylistFileName}" TextWrapping="Wrap" Foreground="{DynamicResource ValueGreen}" FontSize="14" Margin="0,0,0,18"/>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>

                        <TextBlock Text="MPC-HC" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Not running"/>
                                    <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMpcRunning}" Value="True">
                                            <Setter Property="Text" Value="● Running"/>
                                            <Setter Property="Foreground" Value="{DynamicResource StatusOk}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
