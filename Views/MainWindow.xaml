                <MenuItem Header="Search" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Scan for bookmarks…" Command="{Binding DetectBookmarksCommand}"
                          ToolTip="Scans the video for silence, black frames or scene cuts and proposes bookmarks you can review before accepting">
                    <MenuItem.Icon>
                        <TextBlock Text="🔍" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>

                <!-- Beside Edit bookmarks, the other two entries that treat
                     the bookmark file as a file. Timings and names only:
                     none of the formats on the other side of these has
                     anywhere to put a speed, a crop or a fade, so they are a
                     way out to another editor rather than a second place to
                     keep the work. -->
                <!-- One entry that points at whichever of the two is worth
                     offering, the same way the toolbar's select button does
                     and by the same rule: a full list offers to clear it, an
                     empty one offers to fill it, and a partial selection
                     leaves the last answer standing. -->
            </MenuItem>
            <MenuItem x:Name="PlaylistMenu" Header="&#127902; Playlists">
                <!-- These three are Click handlers rather than commands, so
                     they cannot be gated by CanExecute — IsEnabled binds to
                     the equivalent ViewModel predicate instead. -->
                <!-- Gated on a playlist simply being loaded. It used to key off
                     the loaded playlist still having entries, which was cached
                     and went stale — leaving this grayed out with a playlist
                     plainly loaded. An empty playlist can no longer be loaded
                     at all, so the entry count adds nothing here. -->
                <Separator x:Name="PlaylistStartSeparator" Visibility="Collapsed"/>
                <!-- Dynamic per-playlist entries inserted here at runtime
                     by MainWindow.xaml.cs. Each playlist is headed by its
                     name and the number of entries it lists — "clips.pls (50)"
                     — and expands to show those entries (numbered 1, 2, 3, …)
                     plus actions: View playlist content / Load this playlist /
                     Add current video / Remove missing entries / Delete playlist.
                     PlaylistEndSeparator doubles as the divider before
                     "New playlist…" — no extra static separator needed. -->
                <MenuItem Header="(no playlist folder set)" IsEnabled="False" x:Name="PlaylistEmptyPlaceholder"/>
                <Separator x:Name="PlaylistEndSeparator" Visibility="Collapsed"/>
                <MenuItem Header="Directory" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="{Binding PlaylistFolderDisplay}" Command="{Binding SetPlaylistFolderCommand}"
                          ToolTip="Folder scanned for playlists (.pls, .m3u8)">
                    <MenuItem.Icon>
                        <TextBlock Text="📁" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Manage" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Load playlist…" Click="LoadPlaylist_Click"
                          ToolTip="Load a .pls playlist — subsequent Add-to-playlist actions route to it directly">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Unload playlist" Click="ClearLoadedPlaylist_Click"
                          IsEnabled="{Binding HasLoadedPlaylist}"
                          ToolTip="Forget the currently-loaded playlist — Add-to-playlist will prompt again">
                    <MenuItem.Icon>
                        <TextBlock Text="✕" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Create playlist…" Click="NewPlaylist_Click"
                          ToolTip="Create a new empty .pls file in the playlist folder">
                    <MenuItem.Icon>
                        <TextBlock Text="➕" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding AddToPlaylistMenuLabel}" Command="{Binding AddCurrentToPlaylistCommand}"
                          ToolTip="{Binding AddToPlaylistToolTip}">
                    <MenuItem.Icon>
                        <TextBlock Text="➕" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Refresh playlists" Click="RefreshPlaylists_Click"
                          IsEnabled="{Binding HasPlaylistFiles}"
                          ToolTip="Re-read the playlist folder and rebuild this menu">
                    <MenuItem.Icon>
                        <TextBlock Text="⟳" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="&#128336; History" x:Name="RecentMenuItem" ToolTip="Recently played videos">
                <MenuItem Header="Viewed" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="(no recent videos)" IsEnabled="False" x:Name="RecentEmptyPlaceholder"/>
                <Separator x:Name="RecentStartSeparator" Visibility="Collapsed"/>
                <!-- Dynamic per-video entries inserted here at runtime -->
                <Separator x:Name="RecentEndSeparator" Visibility="Collapsed"/>
                <MenuItem Header="Clear history" Click="ClearRecentList_Click" x:Name="RecentClearItem" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Text="🗑" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- History — the recently-played videos, promoted out of the File
                 menu to a top-level menu of its own. Entries between the two
                 named separators are inserted at runtime from RecentVideos. -->
            <!-- Shortcuts menu — lets the user add folder shortcuts that then
                 appear as clickable items at the bottom of the File menu. -->
            <MenuItem x:Name="ShortcutsMenu" Header="&#128279; Shortcuts">
                <Separator x:Name="ShortcutsMenuStartSeparator"/>
                <MenuItem Header="Add shortcut…" Command="{Binding AddShortcutCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="➕" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Manage shortcuts…" Command="{Binding ManageShortcutsCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="✎" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Dynamic per-shortcut "Open" + "Rename…" + "Remove" entries
                     appended here at runtime by MainWindow.xaml.cs. These open
                     a folder in Explorer and have nothing to do with the
                     quick save shortcuts in the File menu. -->
            </MenuItem>
            <!-- Suffix menu — manages filename suffixes appended to all video
                 outputs (merge, split, convert, strip audio, bulk merge).
                 The first item shows the currently-active suffix; the dynamic
                 list below lets the user switch by clicking. -->
            <MenuItem x:Name="OptionsMenu" Header="&#9881; Options">
                <!-- Not IsEnabled="False", unlike the example line below it: the
                     MenuItem style grays disabled items to #888888, and this is
                     the one line here that says which tag is actually in use, so
                     it stays at full contrast. It has no Command, so it is still
                     a label — clicking it just closes the menu. -->
                <!-- Dynamic per-suffix entries inserted here at runtime by
                     MainWindow.xaml.cs. The active one gets a ✓ prefix;
                     clicking any entry sets it as active. SuffixListEndSeparator
                     doubles as the divider before "Add suffix…" — no extra
                     static separator needed. -->
                <!-- The way back from a rearranged toolbar. Dragging is
                     discoverable by accident; undoing it is not, so it needs a
                     line somewhere that can be found on purpose. -->
                <MenuItem Header="Toolbar" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Customize toolbar…" Command="{Binding CustomizeToolbarCommand}"
                          ToolTip="Choose which buttons are on the toolbar and how they are arranged. Right-clicking the toolbar opens this too.">
                    <MenuItem.Icon>
                        <TextBlock Text="🔧" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Change button colors…" Command="{Binding ChangeButtonColorsCommand}"
                          ToolTip="What each kind of operation is painted: video, audio, images, and the rest">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reset toolbar" Command="{Binding ResetToolbarOrderCommand}"
                          ToolTip="Put the buttons across the top back in the order the program ships with. Drag a button onto another to rearrange them.">
                    <MenuItem.Icon>
                        <TextBlock Text="↺" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Right-clicking the seekbar reaches the same three
                     commands — see its own ContextMenu — so this is the way
                     back for whoever only ever looks in Options. -->
                <MenuItem Header="Seekbar" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Customize seekbar…" Command="{Binding CustomizeSeekbarCommand}"
                          ToolTip="How a bookmark's start and end are marked on the seekbar, its transparency, and whether the filled bar draws at all. Right-clicking the seekbar opens this too.">
                    <MenuItem.Icon>
                        <TextBlock Text="🔧" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Hide seekbar" IsCheckable="True"
                          IsChecked="{Binding HideSeekbar, Mode=TwoWay}"
                          ToolTip="Put the seekbar away without losing how it is set up. Everything under Customize seekbar is remembered."/>
                <MenuItem Header="Change seekbar colors…" Command="{Binding ChangeSeekbarColorsCommand}"
                          ToolTip="What the seekbar's position bar, border, background, brackets and waveform are painted">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reset seekbar" Command="{Binding ResetSeekbarCommand}"
                          ToolTip="Put the seekbar's colors, transparency and bracket style back the way the program ships with.">
                    <MenuItem.Icon>
                        <TextBlock Text="↺" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <!-- Its own menu rather than a section of Options. The tags are
                 a list the user maintains and switches between, which is a
                 different kind of thing from the handful of appearance
                 dialogs Options holds.

                 Adding one lives inside Manage, where Rename and Remove
                 already were — a second door to the same room is one door
                 too many. -->
            <MenuItem x:Name="TagsMenu" Header="&#127991; Tags">
                <!-- The active tag, shown as what it does to a filename rather
                     than as its own name. The name is in the list below with a
                     tick against it, so repeating it here would say the same
                     thing twice and the example says the part the name does
                     not. -->
                <MenuItem Header="Current" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="{Binding SuffixExampleDisplay}" IsEnabled="False"/>
                <MenuItem Header="Available" Style="{StaticResource MenuSectionHeader}"/>
                <Separator x:Name="SuffixListStartSeparator" Visibility="Collapsed"/>
                <!-- Your tags are inserted here at runtime -->
                <Separator x:Name="SuffixListEndSeparator" Visibility="Collapsed"/>
                <Separator/>
                <MenuItem Header="Manage…" Command="{Binding ManageSuffixesCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="✎" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="&#128421; View">
                <!-- The whole of the view control, and on by default. Picking
                     the view by hand is gone: Minimal and Full were a mode the
                     user had to keep in their head, with nothing on screen
                     saying which one was in force, and the automatic behavior
                     is what both of them were usually being used to get.

                     Off leaves this window up permanently. The hotkey still
                     works there — it says what it recorded in a toast, since
                     this window is behind the player at the time. -->
                <MenuItem Header="Behavior" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Switch views automatically" IsCheckable="True"
                          IsChecked="{Binding AutoSwitchViews, Mode=TwoWay}"/>
                <!-- A pair of alternatives, not two switches — see
                     MainViewModel.CutsAsList for why each one only acts on
                     being ticked. -->
                <MenuItem Header="Layout" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="List" IsCheckable="True"
                          IsChecked="{Binding CutsAsList, Mode=TwoWay}"/>
                <!-- A submenu rather than four more entries out here: the four
                     are one choice — how the storyboard looks — and the View
                     menu stays four lines long instead of eight. Picking any of
                     them also switches to the storyboard, since choosing how it
                     looks while looking at something else would be a setting
                     rather than a view. -->
                <MenuItem Header="Storyboard">
                    <MenuItem Header="Cards" IsCheckable="True"
                              IsChecked="{Binding LayoutIsCards, Mode=TwoWay}"/>
                    <MenuItem Header="Contact sheet" IsCheckable="True"
                              IsChecked="{Binding LayoutIsContactSheet, Mode=TwoWay}"/>
                    <MenuItem Header="Detail" IsCheckable="True"
                              IsChecked="{Binding LayoutIsDetail, Mode=TwoWay}"/>
                    <MenuItem Header="Filmstrip" IsCheckable="True"
                              IsChecked="{Binding LayoutIsFilmstrip, Mode=TwoWay}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="&#10067; Help">
                <MenuItem Header="Program" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="About…" Command="{Binding ShowAboutCommand}"
                          ToolTip="Version, licensing and third-party components">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                          ToolTip="Ask GitHub whether a newer release has been published. Works whether or not the startup check is turned on.">
                    <MenuItem.Icon>
                        <TextBlock Text="⟳" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Licenses" Command="{Binding ShowAboutCommand}"
                          ToolTip="License terms for this app and the components it uses">
                    <MenuItem.Icon>
                        <TextBlock Text="📄" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Code" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="GitHub repository" Command="{Binding OpenRepositoryCommand}"
                          ToolTip="https://github.com/gouryellas/MPC-HC-Video-Editor">
                    <MenuItem.Icon>
                        <TextBlock Text="🔗" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Report an issue" Command="{Binding OpenIssuesCommand}"
                          ToolTip="Open the issue tracker in your browser">
                    <MenuItem.Icon>
                        <TextBlock Text="🐞" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <!-- Messages and nothing else now. The hotkey binding moved to the
             right panel and the player clock moved onto the timeline, where it
             sits either side of the bar it describes. Both were standing state
             parked in the one strip meant for reporting what just happened, and
             between them they had taken most of its width.

             No progress bar here either: the job panel directly above owns
             progress, and a second bar showed the same number twice. -->
        <!-- Three layers, because the colour is temporary and the strip is
             not. The theme fill is the floor; the two flashes sit over it at
             zero opacity until something succeeds or fails; the text is above
             both so a flash colours the strip rather than covering what it
             says.

             The glow is thrown upward, over the panel above. There is nowhere
             else for it to go in a strip at the bottom edge of a window, and
             it is what makes this read as a flare rather than as the bar
             having quietly changed colour. -->
        <!-- The two flashes are begun from the code-behind, on StatusLevel
             changing — see FlashStatusStrip, and PulseJobPanel above it, which
             does the same thing for the same reason. A BeginStoryboard in a
             Style trigger cannot resolve these names. -->
        <Grid DockPanel.Dock="Bottom">
            <Border Background="{DynamicResource PrimaryButton}"/>

            <Border x:Name="StatusOkFlash" Background="{DynamicResource StatusOk}"
                    Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#8FD4A8" ShadowDepth="0" BlurRadius="26" Opacity="0.85"/>
                </Border.Effect>
            </Border>

            <Border x:Name="StatusFailFlash" Background="{DynamicResource StatusError}"
                    Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#E8706E" ShadowDepth="0" BlurRadius="26" Opacity="0.85"/>
                </Border.Effect>
            </Border>

            <Border Padding="10,6">
                <!-- Marquee rather than TextBlock: "Created <name> — <warning>"
                     runs past the end of the bar on a long file name, and the
                     warning is the half that gets clipped. -->
                <helpers:MarqueeText Text="{Binding StatusText}" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Job progress. Sits above the status bar and only takes space while
             an operation is running. -->
        <Border x:Name="JobPanel" DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackground}" Padding="12,8"
                Visibility="{Binding Job.IsRunning, Converter={StaticResource BoolToVis}}">
            <Grid>
            <StackPanel>
                <!-- One line for what is happening, the file counter and the
                     percentage; one for the file itself. The step used to carry
                     its own count and sit on a row of its own, which said the
                     same thing three ways. -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Job.HeadlineDisplay}" Foreground="{DynamicResource TextPrimary}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Job.FileProgressDisplay}" Foreground="{DynamicResource ValueYellow}"
                               FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Job.PercentDisplay}" Foreground="{DynamicResource TextPrimary}"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Visibility="{Binding Job.ShowsProgress, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- What the finished job produced. Empty while one is
                     running, so it costs the panel no height until there is
                     something to report. -->
                <TextBlock Text="{Binding Job.Summary}" Foreground="{DynamicResource ValueGreen}"
                           FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"
                           Visibility="{Binding Job.Summary, Converter={StaticResource NonEmptyToVis}}"/>

                <TextBlock Text="{Binding Job.CurrentFile}" Foreground="{DynamicResource Accent}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                <!-- Black track. Fill colour comes from the percentage: red
                     under 25, orange to 50, yellow to 75, blue under 100, solid
                     green at 100 (held for a few seconds by JobProgress).

                     Gone entirely for a job with no honest percentage — an
                     empty bar that fills in one jump at the end tells you less
                     than the sentence above it. -->
                <Border Background="#FF000000" CornerRadius="3" Height="14" Padding="2"
                        Visibility="{Binding Job.ShowsProgress, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Rectangle HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                   Fill="{Binding Job.Percent, Converter={StaticResource ProgressBrush}}"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Job.PercentFraction}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>

                <Grid Margin="0,6,0,0"
                      Visibility="{Binding Job.ShowsProgress, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left">
                        <Run Text="Elapsed"/><Run Text="  "/><Run Text="{Binding Job.ElapsedDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right">
                        <Run Text="Remaining"/><Run Text="  "/><Run Text="{Binding Job.RemainingDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <!-- A brief green flash over the whole panel when a job finishes
                 successfully, so the outcome registers even with the
                 completion sound off and the window not being watched.
                 Hit-test invisible — it is a flourish, not a control — and
                 begun from code-behind on JobProgress.Finished, the one
                 place every successful operation already reports through. -->
            <Border x:Name="JobCompleteGlow" Background="{DynamicResource StatusOk}"
                    Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar. WrapPanel, not StackPanel: a horizontal StackPanel
                 keeps laying out past the right edge, so at narrow widths the
                 last buttons were cut off rather than moving to a second row.

                 Named so the window can take its minimum width from what this
                 row actually measures. The wrap is still the safety net — for a
                 display too narrow to hold the row at all, and for the moment
                 during startup before the first measurement. -->
            <!-- Built from MainViewModel.ToolbarRows rather than written out
                 here, so the row can be rearranged by dragging and by the
                 Customize dialog, and the layout saved.

                 Two levels: the outer control draws one line per row break the
                 user has put in, and each row lays itself out with
                 ToolbarRowPanel — which is what gives an expander its width and
                 wraps a row the window is too narrow to hold. -->
            <ItemsControl x:Name="ActionToolbar" Grid.Row="0" Margin="0,0,0,10"
                          ItemsSource="{Binding ToolbarRows}"
                          PreviewMouseLeftButtonDown="Toolbar_MouseDown"
                          PreviewMouseMove="Toolbar_MouseMove">
                <ItemsControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Customize toolbar…" Command="{Binding CustomizeToolbarCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="🔧" Style="{StaticResource MenuGlyph}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Change button colors…" Command="{Binding ChangeButtonColorsCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="🎨" Style="{StaticResource MenuGlyph}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Reset toolbar" Command="{Binding ResetToolbarOrderCommand}">
                            <MenuItem.Icon>
                                <TextBlock Text="↺" Style="{StaticResource MenuGlyph}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ItemsControl.ContextMenu>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <helpers:ToolbarRowPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- A spacer is a fixed gap; an expander is
                                             a gap the row panel widens. Neither
                                             draws anything at runtime — what they
                                             look like belongs to the Customize
                                             dialog, where they are being placed. -->
                                        <Rectangle Width="18" Height="4"
                                                   Visibility="{Binding Kind, Converter={StaticResource SpacerVis}}"/>
                                        <Rectangle Height="4"
                                                   Visibility="{Binding Kind, Converter={StaticResource ExpanderVis}}"/>

                                        <!-- ShowOnDisabled, because a disabled
                                             control gives no tooltip by
                                             default: with the labels off, a
                                             greyed button that will not say
                                             what it is is only a grey square.
                                             Whether it is greyed at all is the
                                             bound command's own answer.

                                             AutomationProperties.Name is stated
                                             because it used to be free. A button
                                             whose Content is a string reports
                                             that string as its name; one whose
                                             content is a panel reports nothing
                                             — so putting the picture in cost
                                             every toolbar button its name to a
                                             screen reader, and with the labels
                                             off there is no text inside to fall
                                             back on. -->
                                        <Button Visibility="{Binding IsButton, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding Command}"
                                                ToolTip="{Binding Hint}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding Hint}"
                                                Width="{Binding ButtonWidth, Converter={StaticResource WidthOrAuto}}"
                                                MinWidth="{Binding ButtonMinWidth}"
                                                Padding="{Binding ButtonPadding}"
                                                Style="{Binding StyleKey, Converter={StaticResource StyleByKey}}"
                                                Opacity="{Binding IsDragging, Converter={StaticResource DragOpacity}}">
                                            <!-- Picture then name. Both are
                                                 optional and neither is always
                                                 present: the naming tags have
                                                 no picture, and with the labels
                                                 off a button that has one drops
                                                 its text. -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Image Source="{Binding IconSource}"
                                                       Width="{Binding IconSize}"
                                                       Height="{Binding IconSize}"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       SnapsToDevicePixels="True"/>
                                                <!-- The gap belongs to the text,
                                                     and only when there is a
                                                     picture to be spaced from:
                                                     on the image it would pad
                                                     the right of an icon-only
                                                     button, and fixed on the
                                                     text it would indent the
                                                     naming tags, which have no
                                                     picture at all.

                                                     Set through the style and
                                                     never as an attribute here —
                                                     a local value outranks every
                                                     setter and the trigger would
                                                     silently do nothing. -->
                                                <TextBlock Text="{Binding Caption}"
                                                           Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                    <Setter Property="Margin" Value="6,0,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Timeline, in two lanes: the bookmark marks in a strip of their
                 own on top, the playback position owning the bar underneath.
                 They used to be stacked on the same 18px with overlapping
                 margins, so the position line ran behind the marks and was
                 hidden wherever a range covered it — which is most of the bar
                 on a well-marked video. Separating them also lets the position
                 bar be worth looking at instead of a 6px sliver. -->
            <!-- Position on the left, length on the right, the way a transport
                 bar reads. These used to be a single "26s / 1:00" in the corner
                 of the status bar, which is the wrong place for them: the status
                 bar reports what just happened, and this is where you are.

                 Both ends are one shared-size group, so they are always the same
                 width and the bar between them cannot move. The width comes from
                 whichever is wider, which is the duration — the position can
                 never be longer than the thing it is a position in. That holds
                 for an hour-long file reading 1:04:22 as readily as for a minute
                 reading 12s, without a guessed-at fixed width to outgrow.

                 Each number is aligned towards the bar, so the growth on a long
                 file happens on the outside edges and the track keeps its ends.
                 Consolas for the same reason: proportional digits shuffle the
                 label's width every time a 1 ticks over to a 2. -->
            <Grid Grid.Row="1" Margin="0,0,0,10" Grid.IsSharedSizeScope="True"
                  Visibility="{Binding ShowSeekbar, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TimelineClock"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TimelineClock"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" VerticalAlignment="Bottom"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentBright}"
                           ToolTip="Where the player is now"/>

                <!-- One rectangular bar holding everything. The marks used to be
                     a separate strip floating above the track, which read as two
                     controls for one thing; they are now lanes inside the same
                     frame — the marks along the top of it, the position along the
                     bottom — so the bar is the timeline rather than a bar with a
                     timeline over it.

                     The two lanes rather than one layer on top of the other: a
                     range painted across the position is what hid the position in
                     the first place. Stacked, each keeps its own room and the
                     handle crosses both to tie them together. -->
                <Border Grid.Column="1" Background="{DynamicResource SeekbarTrack}" CornerRadius="0"
                        BorderBrush="{DynamicResource SeekbarBorder}" BorderThickness="1" Height="22"
                        Cursor="Hand" MouseLeftButtonDown="Timeline_MouseLeftButtonDown"
                        MouseLeftButtonUp="Timeline_MouseLeftButtonUp" LostMouseCapture="Timeline_LostMouseCapture"
                        MouseMove="Timeline_MouseMove" MouseLeave="Timeline_MouseLeave">
                    <!-- Right-click reaches the same commands Options offers,
                         the way the toolbar's own context menu does — found by
                         right-clicking the thing being customized, rather than
                         only from a menu bar three words away from it. -->
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Customize seekbar…" Command="{Binding CustomizeSeekbarCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔧" Style="{StaticResource MenuGlyph}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Change seekbar colors…" Command="{Binding ChangeSeekbarColorsCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="🎨" Style="{StaticResource MenuGlyph}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Reset seekbar" Command="{Binding ResetSeekbarCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="↺" Style="{StaticResource MenuGlyph}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Scan for bookmarks…" Command="{Binding ScanEditPointsCommand}"
                                      ToolTip="Look for where the video actually changes — silence, black frames or scene cuts — and mark each with a tick on the bar. Nothing is added to the cut list.">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔍" Style="{StaticResource MenuGlyph}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Snap brackets to edit points" IsCheckable="True"
                                      IsChecked="{Binding SnapToEditPoints, Mode=TwoWay}"
                                      ToolTip="A bracket dragged near one of the ticks lands exactly on it. Hold Alt while dragging to place it freely."/>
                            <MenuItem Header="Hide seekbar" IsCheckable="True"
                                      IsChecked="{Binding HideSeekbar, Mode=TwoWay}"
                                      ToolTip="Put the seekbar away without losing how it is set up. Bring it back from Options ▸ Hide seekbar."/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <!-- Named because the click handler measures against it
                         rather than against the Border: the border line is a
                         pixel the bar does not represent any time with. -->
                    <Grid x:Name="TimelineArea">
                        <!-- Behind everything else in the bar, which is the only
                             place it can go: it is the shape of the sound across
                             the whole file, and the marks and the position are
                             things read against it.

                             Stretch, not Uniform. The picture is drawn 1600
                             pixels wide whatever the window is, so the bar
                             squeezes or stretches it horizontally to fit; the
                             point is where the loud parts are, and that is a
                             position along the file rather than a shape with an
                             aspect ratio to keep.

                             IsHitTestVisible="False" so it never eats the click
                             that seeks — the handler is on the Border and this
                             covers all of it. -->
                        <Image Source="{Binding Waveform}" Stretch="Fill" Opacity="0.5"
                               IsHitTestVisible="False"
                               Visibility="{Binding ShowSeekbarWaveform, Converter={StaticResource BoolToVis}}"/>

                        <!-- Templated rather than styled: the stock ProgressBar
                             chrome draws its own track and border inside ours.
                             This is the fill, and the handle riding the end of it.

                             The handle lives inside PART_Indicator, pinned to its
                             right edge and hanging half its width past it. The
                             indicator is the one part of the template whose width
                             the control sets, so anything anchored to its end
                             tracks the position without a converter or a
                             code-behind hook. Nothing here clips, so the handle
                             stands taller than its lane. -->
                        <ProgressBar Value="{Binding TimelineProgress}" Minimum="0" Maximum="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource SeekbarFill}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border x:Name="PART_Track"/>
                                        <!-- The indicator itself draws nothing —
                                             it is here for its width, which is the
                                             one thing the control sets, and which
                                             the wash and the handle both hang off.
                                             Opacity belongs on the wash and not on
                                             the indicator: set here it would carry
                                             into the handle and fade that too. -->
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                Background="Transparent" CornerRadius="0">
                                            <Grid>
                                                <!-- The wash itself. Off leaves only the
                                                     caret below, which is what "seekbar
                                                     bar" off means — the playhead is
                                                     still findable, nothing is painted
                                                     over what has played. -->
                                                <Border Background="{TemplateBinding Foreground}"
                                                        Opacity="{Binding SeekbarOpacity}"
                                                        Visibility="{Binding SeekbarBarEnabled, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Filled in the bracket
                                                     colour — the handle is a
                                                     mark, like a bracket is,
                                                     not a second wash — with
                                                     its own edge in the border
                                                     colour, the same as the
                                                     bar's own edge. The fill
                                                     used to be a flat pale
                                                     neutral with the bracket
                                                     colour buried in a 1px
                                                     line at 0.55 opacity
                                                     inside it — technically
                                                     present, invisibly so.
                                                     Taller than the bar so it
                                                     stays findable where the
                                                     wash crosses a bookmark. -->
                                                <Border Width="7" Height="26" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" Margin="0,0,-3.5,0"
                                                        Background="{DynamicResource SeekbarMark}"
                                                        BorderBrush="{DynamicResource SeekbarBorder}"
                                                        BorderThickness="1" CornerRadius="0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>

                        <!-- Last, so it draws on top of everything. The marks
                             used to sit under the position, and the wash —
                             half-opaque blue across everything played so far —
                             went over them: a white bracket behind it came out
                             pale blue, and on a video watched to the end every
                             mark in the list was under it.

                             The wash was never going to lose that fight. It
                             covers whole stretches of the bar while a bracket is
                             two pixels wide, so whichever is on top wins
                             outright, and the marks are the thing being read.
                             The position is still perfectly legible under them —
                             it is a coloured region metres wide, interrupted by
                             a few white strokes.

                             Full height, so the brackets stand clear of the
                             handle rather than being hidden behind it. -->
                        <helpers:TimelineRanges x:Name="RangesControl" Bookmarks="{Binding Session.Bookmarks}"
                                                DurationSeconds="{Binding Session.VideoDurationSeconds}"
                                                BracketStyle="{Binding SeekbarBracketStyle}"
                                                MarkBrush="{DynamicResource SeekbarMark}"
                                                SnapPoints="{Binding SnapPoints}"
                                                ToolTip="Where the bookmarks fall — a bracket at each end of every range, with the bookmark's number between them and a tick when it is checked. A bookmark still waiting for its closing timestamp shows an opening bracket on its own. Drag a bracket to resize the cut."/>
                    </Grid>
                </Border>

                <!-- Hover-scrub preview: a frame at wherever the pointer sits
                     over the bar, fetched from ffmpeg and debounced in
                     code-behind so dragging across the whole bar does not
                     fire a decode per pixel. IsHitTestVisible="False" so the
                     popup itself is never what a click or a drag lands on —
                     it floats over the bar, not in front of it as far as the
                     mouse is concerned. -->
                <Popup x:Name="HoverPreviewPopup" Placement="RelativePoint" AllowsTransparency="True"
                       StaysOpen="True" IsHitTestVisible="False" PopupAnimation="None">
                    <Border Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="3">
                        <StackPanel>
                            <Image x:Name="HoverPreviewImage" Width="160" Height="90" Stretch="Uniform"/>
                            <TextBlock x:Name="HoverPreviewTime" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" FontFamily="Consolas" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <!-- The name of the cut the pointer is inside, when
                                 the pointer is inside one and chapter names are
                                 in use. Collapsed otherwise, so the popup keeps
                                 its height over the stretches between cuts
                                 rather than growing and shrinking as the
                                 pointer crosses a bracket. Trimmed rather than
                                 wrapped: the frame above sets the width, and a
                                 long name should not make the popup taller. -->
                            <TextBlock x:Name="HoverPreviewChapter" HorizontalAlignment="Center"
                                       Margin="0,1,0,0" FontSize="11" MaxWidth="160"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ValueYellow}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" VerticalAlignment="Bottom"
                           HorizontalAlignment="Left" TextAlignment="Left"
                           FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource AccentBright}"
                           ToolTip="How long the video runs"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- List -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                    <!-- The storyboard's four arrangements. Declared here, above
                         the control that uses them, so they are in scope by the
                         time its Style asks for them.

                         All four draw the same cuts, carry the same checkbox and
                         drive the same selection; they differ only in how much
                         of a cut is spelled out beside its picture. Each shows
                         Prefix rather than RowMarkers — Prefix carries the speed
                         as well, which the row list leaves out because a row has
                         a slider and a reading of its own, and a card has
                         neither. -->
                    <Border.Resources>
                        <!-- The speed slider has no room on a card, a tile or a
                             strip, and finding one there would mean giving up
                             the picture it sits on. So the setting moves to a
                             right-click instead of onto the layout: the same
                             eight stops the slider snaps to, ticked at the one
                             in force. Ctrl and the wheel does it without the
                             menu — see Storyboard_PreviewMouseWheel. -->
                        <ContextMenu x:Key="ClipSpeedMenu">
                            <MenuItem Header="Quarter speed" Tag="0.25" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=0.25}"/>
                            <MenuItem Header="Half speed" Tag="0.5" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=0.5}"/>
                            <MenuItem Header="0.75x" Tag="0.75" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=0.75}"/>
                            <MenuItem Header="Normal" Tag="1" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=1}"/>
                            <MenuItem Header="1.25x" Tag="1.25" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=1.25}"/>
                            <MenuItem Header="1.5x" Tag="1.5" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=1.5}"/>
                            <MenuItem Header="1.75x" Tag="1.75" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=1.75}"/>
                            <MenuItem Header="Double speed" Tag="2" Click="ClipSpeed_Click" IsCheckable="True"
                                      IsChecked="{Binding Speed, Mode=OneWay, Converter={StaticResource SpeedIs}, ConverterParameter=2}"/>
                        </ContextMenu>

                        <ItemsPanelTemplate x:Key="StoryboardWrap">
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>

                        <!-- Detail is one cut to a row, so it stacks rather than
                             wraps. IsItemsHost on a StackPanel inside a
                             ScrollViewer still scrolls; the ListView provides it. -->
                        <ItemsPanelTemplate x:Key="StoryboardStack">
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>

                        <!-- A — Cards. The check and the number ride on the frame
                             itself, the name sits along its foot, and the times
                             are centred underneath. -->
                        <DataTemplate x:Key="StoryboardCards">
                            <Border Width="168" Padding="6"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <!-- Fixed box whether or not a frame has
                                         arrived, so cards do not jump about as
                                         the thumbnails fill in one by one. The
                                         black behind is what an undrawn card
                                         shows, and what letterboxes a frame
                                         whose shape does not match the box. -->
                                    <Border Height="88" Background="#FF000000" CornerRadius="2"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>

                                            <!-- Both on one plate rather than two:
                                                 they are read together, and a frame
                                                 can be any colour at all — white
                                                 snow behind a white tick is no tick.
                                                 The plate is what makes either of
                                                 them legible on every frame instead
                                                 of on most of them. -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="4" Padding="3,1"
                                                    Background="#A0000000" CornerRadius="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Quick save, as on the bookmark list:
                                                         one click writes this clip on its
                                                         own, and the icon becomes a check
                                                         mark once it has. Same style as the
                                                         list, so the two never drift. -->
                                                    <Button Style="{StaticResource RowQuickSave}"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.SplitSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Check this bookmark for the actions that work on a selection"/>
                                                    <TextBlock Text="{Binding Index}" FontWeight="Bold"
                                                               Margin="4,0,1,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource LinkBlue}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- The name and the marks along the
                                                 foot of the picture. Inside rather
                                                 than above or below it, so a card
                                                 is the same height however much it
                                                 has to say and a row of them lines
                                                 up regardless.

                                                 One plate holding both, each line
                                                 appearing only if it has something
                                                 to say — two plates stacked would
                                                 show a seam between them on a cut
                                                 that had both. -->
                                            <Border VerticalAlignment="Bottom" Background="#A0000000"
                                                    Padding="4,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasLabel}" Value="False"/>
                                                                    <Condition Binding="{Binding HasEffects}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ValueYellow}"
                                                               ToolTip="{Binding Label}"
                                                               Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">
                                                        <Path Style="{StaticResource RotationMark}" Margin="0,0,3,0"
                                                              Visibility="{Binding ShowsRotationMark, Converter={StaticResource BoolToVis}}"/>
                                                        <ItemsControl ItemsSource="{Binding EffectMarks}" FontSize="11"
                                                      VerticalAlignment="Center"
                                                      ItemsPanel="{StaticResource EffectMarksPanel}"
                                                      ItemTemplate="{StaticResource EffectMarkTemplate}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Times and length on one centred line. -->
                                    <TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Visibility="{Binding IsIncomplete, Converter={StaticResource NotBoolToVis}}">
                                        <Run Text="{Binding StartDisplay, Mode=OneWay}"/><Run Text=" – "/><Run Text="{Binding EndDisplay, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding EffectiveDurationDisplay, StringFormat=({0}), Mode=OneWay}" Foreground="{DynamicResource ValueGreen}"/>
                                    </TextBlock>

                                    <TextBlock Text="open" FontStyle="Italic" Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource StatusError}"
                                               Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!-- B — Contact sheet. Everything the tile has to say is
                             said on the tile: the check and the number at the top
                             left, the marks opposite them, and the times along the
                             foot. One plate for the times rather than a badge at
                             each end — on a tile this size two of them very nearly
                             touch in the middle, and a single bar reads as one
                             caption instead of two scraps. -->
                        <DataTemplate x:Key="StoryboardContactSheet">
                            <Border Width="116" Height="66" Background="#FF000000" CornerRadius="2"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>

                                    <!-- Dark plates behind every reading: a frame
                                         can be any colour at all, and white text
                                         straight onto a pale one is unreadable. -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="3" Padding="3,1"
                                            Background="#A0000000" CornerRadius="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RowQuickSave}"
                                                    Margin="0,0,4,0"
                                                    Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.SplitSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Check this bookmark for the actions that work on a selection"/>
                                            <TextBlock Text="{Binding Index}" FontSize="10" FontWeight="Bold"
                                                       Margin="4,0,1,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource LinkBlue}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="3" Padding="3,1"
                                            Background="#A0000000" CornerRadius="3"
                                            Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource RotationMark}" Margin="0,0,2,0"
                                                  Visibility="{Binding ShowsRotationMark, Converter={StaticResource BoolToVis}}"/>
                                            <ItemsControl ItemsSource="{Binding EffectMarks}" FontSize="10"
                                                      VerticalAlignment="Center"
                                                      ItemsPanel="{StaticResource EffectMarksPanel}"
                                                      ItemTemplate="{StaticResource EffectMarkTemplate}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border VerticalAlignment="Bottom" Background="#A0000000" Padding="4,1"
                                            Visibility="{Binding IsIncomplete, Converter={StaticResource NotBoolToVis}}">
                                        <StackPanel>
                                            <!-- The name above the times, on the
                                                 same plate. A tile this size has
                                                 no corner left to put it in, and
                                                 a name is what a cut is called —
                                                 worth the line it costs on the
                                                 cuts that have one, and costing
                                                 nothing on the ones that do
                                                 not. -->
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ValueYellow}"
                                                       Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"/>
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Left" FontSize="10"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextSecondary}">
                                                    <Run Text="{Binding StartDisplay, Mode=OneWay}"/><Run Text="–"/><Run Text="{Binding EndDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding EffectiveDurationDisplay}"
                                                           HorizontalAlignment="Right" FontSize="10"
                                                           Foreground="{DynamicResource ValueGreen}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border VerticalAlignment="Bottom" Background="#A0000000" Padding="4,1"
                                            Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="open" FontSize="10" FontStyle="Italic"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource StatusError}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <!-- C — Detail. One cut to a row, frame on the left. The
                             only layout with room for the speed as its own
                             column, the way the row list has it. -->
                        <DataTemplate x:Key="StoryboardDetail">
                            <Border Padding="6" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Style="{StaticResource RowQuickSave}"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.SplitSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Check this bookmark for the actions that work on a selection"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="112" Height="63" Margin="0,0,10,0"
                                            Background="#FF000000" CornerRadius="2">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Index, StringFormat=[{0}]}" FontWeight="Bold"
                                                       Foreground="{DynamicResource LinkBlue}"/>
                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ValueYellow}"
                                                       Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="open" FontStyle="Italic" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource StatusError}"
                                                       Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Visibility="{Binding IsIncomplete, Converter={StaticResource NotBoolToVis}}">
                                            <Run Text="{Binding StartDisplay, Mode=OneWay}"/><Run Text=" – "/><Run Text="{Binding EndDisplay, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding EffectiveDurationDisplay, StringFormat=({0}), Mode=OneWay}" Foreground="{DynamicResource ValueGreen}"/>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">
                                            <Path Style="{StaticResource RotationMark}" Margin="0,0,3,0"
                                                  Visibility="{Binding ShowsRotationMark, Converter={StaticResource BoolToVis}}"/>
                                            <ItemsControl ItemsSource="{Binding EffectMarks}" FontSize="11"
                                                      VerticalAlignment="Center"
                                                      ItemsPanel="{StaticResource EffectMarksPanel}"
                                                      ItemTemplate="{StaticResource EffectMarkTemplate}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding SpeedShortDisplay}"
                                               VerticalAlignment="Center" Margin="10,0,2,0"
                                               Foreground="{DynamicResource LinkBlue}"
                                               ToolTip="{Binding SpeedDisplay, StringFormat=Plays at {0} when saved}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <!-- D — Filmstrip. First and last frame side by side, the
                             only layout that says how a cut ends. The second
                             frame is a second ffmpeg call, which is why only this
                             layout fetches one. -->
                        <DataTemplate x:Key="StoryboardFilmstrip">
                            <Border Width="206" Padding="6"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Style="{StaticResource RowQuickSave}"
                                                Margin="0,0,4,0"
                                                Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.SplitSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Check this bookmark for the actions that work on a selection"/>
                                        <TextBlock Text="{Binding Index, StringFormat=[{0}]}" FontWeight="Bold"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource LinkBlue}"/>
                                        <TextBlock Text="{Binding Label}" Margin="5,0,0,0" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ValueYellow}"
                                                   Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <!-- Two frames, a hairline apart, so the pair
                                         reads as one strip rather than two
                                         pictures that happen to be adjacent. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="54" Background="#FF000000" CornerRadius="2,0,0,2">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        </Border>
                                        <Border Grid.Column="2" Height="54" Background="#FF000000" CornerRadius="0,2,2,0">
                                            <Image Source="{Binding ThumbnailEnd}" Stretch="Uniform"/>
                                        </Border>

                                        <!-- The marks ride on the strip itself,
                                             over the join between the two frames,
                                             rather than on a line of their own
                                             below it. Centred there because the
                                             join is the one part of the picture
                                             that is never the subject. -->
                                        <Border Grid.ColumnSpan="3" HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom" Margin="0,0,0,3"
                                                Background="#A0000000" CornerRadius="3" Padding="3,1"
                                                Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource RotationMark}" Margin="0,0,2,0"
                                                      Visibility="{Binding ShowsRotationMark, Converter={StaticResource BoolToVis}}"/>
                                                <ItemsControl ItemsSource="{Binding EffectMarks}" FontSize="10"
                                                              VerticalAlignment="Center"
                                                              ItemsPanel="{StaticResource EffectMarksPanel}"
                                                              ItemTemplate="{StaticResource EffectMarkTemplate}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4,0,0"
                                          Visibility="{Binding IsIncomplete, Converter={StaticResource NotBoolToVis}}">
                                        <TextBlock Text="{Binding StartDisplay}" HorizontalAlignment="Left"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding EffectiveDurationDisplay}" HorizontalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource ValueGreen}"/>
                                        <TextBlock Text="{Binding EndDisplay}" HorizontalAlignment="Right"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>

                                    <TextBlock Text="open" FontStyle="Italic" Margin="0,4,0,0"
                                               Foreground="{DynamicResource StatusError}"
                                               Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </Border.Resources>

                    <DockPanel>
                        <!-- The count reads CompletePairCount, not
                             Bookmarks.Count as the old "n items" did: a lone
                             opening timestamp still awaiting its close is a row
                             in the list but not yet a cut, and counting it
                             promised one more clip than a split would produce.

                             The only caption left. This used to be a grid of
                             columns mirroring the row template, so a "PLAY
                             SPEED" heading could sit over the sliders — but the
                             reading beside each slider names what it is doing
                             in the row itself, which is where it is read. -->
                        <!-- The count, and the five views out at the right end
                             of the same line. They go here rather than on a
                             line of their own because the row was already
                             there with nothing in the rest of it, and a
                             switcher is read as belonging to the thing it is
                             sitting over. The View menu still carries all five
                             for whoever looks there first. -->
                        <Grid DockPanel.Dock="Top" Margin="4,2,4,8">
                            <TextBlock Text="{Binding CompletePairCount, StringFormat='Bookmarks: {0}'}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton Content="☰" Style="{StaticResource ViewToggle}"
                                              IsChecked="{Binding CutsAsList, Mode=TwoWay}"/>

                                <!-- A rule between the list and the four
                                     storyboards: they are one choice of five,
                                     but the storyboards are four of a kind. -->
                                <Border Width="1" Margin="4,2" Background="{DynamicResource ControlHover}"/>

                                <ToggleButton Content="▦" Style="{StaticResource ViewToggle}"
                                              IsChecked="{Binding LayoutIsCards, Mode=TwoWay}"/>
                                <ToggleButton Content="▩" Style="{StaticResource ViewToggle}"
                                              IsChecked="{Binding LayoutIsContactSheet, Mode=TwoWay}"/>
                                <ToggleButton Content="▤" Style="{StaticResource ViewToggle}"
                                              IsChecked="{Binding LayoutIsDetail, Mode=TwoWay}"/>
                                <ToggleButton Content="▭" Style="{StaticResource ViewToggle}"
                                              IsChecked="{Binding LayoutIsFilmstrip, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <!-- A box at the head of the column of boxes, checking
                             and clearing the lot. The first two column widths
                             repeat the row template's, and the 4px left margin
                             repeats the ListViewItem padding, so this box sits
                             exactly over the ones below it rather than merely
                             near them. Change either there and this has to
                             follow.

                             Nothing else on the row: the headings that used to
                             sit here named columns that now name themselves. -->
                        <Grid DockPanel.Dock="Top" Margin="4,0,4,4"
                              Visibility="{Binding ShowSelectAllHeader, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bound to a bool?, but not three-state: the
                                 indeterminate look is for showing a partly
                                 ticked list, never something to click into.

                                 The 2px is the ListView's own inner padding,
                                 which the rows below sit inside and this row,
                                 being outside the list entirely, does not. -->
                            <CheckBox Grid.Column="1" IsThreeState="False"
                                      IsChecked="{Binding AllBookmarksSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="2,0,0,0"
                                      ToolTip="Check every bookmark, or clear them all"/>
                        </Grid>

                        <!-- Both views live here, one of them collapsed. A Grid
                             rather than two children of the DockPanel: a
                             DockPanel stretches its last child and docks every
                             other one, so the rows list would be given its own
                             width and shoved to the left edge the moment a
                             second view was added after it. -->
                        <Grid>
                        <ListView ItemsSource="{Binding Session.Bookmarks}"
                                  SelectedItem="{Binding SelectedBookmark}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextBody}"
                                  Visibility="{Binding StoryboardView, Converter={StaticResource NotBoolToVis}}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RowSelected}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="26"/>
                                            <!-- Auto, not a fixed 34: the index is followed by
                                                 exactly one space, and a fixed column would pad
                                                 "[1]" out to the width of "[10]" instead. -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Auto, not star: the times and the length are
                                                 the row, and a star column hands back
                                                 whatever is left after everything else has
                                                 taken its share — which on a narrow window
                                                 was less than the text needed, so the
                                                 closing "(4m 17s)" was simply cut in half.
                                                 Sized to its content, it is never clipped,
                                                 and the markers column below absorbs the
                                                 slack instead. -->
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto" MinWidth="52"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- One-click split: clicking this save icon
                                             immediately FFmpeg-splits just this clip into
                                             the quick save folder (File ▸ "Quick save: …"),
                                             or next to the source video when that folder is
                                             unset, using the active suffix. It turns into a
                                             check mark once the clip has been written —
                                             see the RowQuickSave style. Only shown on
                                             complete (valid) bookmarks. -->
                                        <Button Grid.Column="0"
                                                Style="{StaticResource RowQuickSave}"
                                                Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.SplitSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                        <!-- Checkable on every row, including a bookmark that is
                                             still open. It was disabled until a closing timestamp
                                             arrived, which made a lone opening timestamp the one
                                             row that could not be marked — and so the one row
                                             "delete selected" could not reach. The actions that
                                             need a real range filter for one themselves; see
                                             Bookmark.IsSelected. -->
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="Check this bookmark for the actions that work on a selection"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Index, StringFormat=[{0}]}" FontWeight="Bold" Foreground="{DynamicResource LinkBlue}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Only present while chapter names are in use.
                                                 With the setting off there is nothing to edit,
                                                 and an empty box on every row would be a column
                                                 of noise for the many sessions that are one cut
                                                 and done.

                                                 The space before the box is inside this panel
                                                 rather than beside it, so it leaves with the box.
                                                 A bare gap out in the row would survive the
                                                 setting being turned off and push every row along
                                                 by a space for a box that is not there. -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.UseChapterNames, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource RowGap}"/>
                                                <!-- Height and vertical padding are held down to
                                                     the row's own text height. A taller box makes
                                                     the whole row taller, and anything in it that
                                                     is not centered then reads as lifted. -->
                                                <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="ChapterName_KeyDown"
                                                         Width="90" Height="20" Padding="4,0"
                                                         Background="{DynamicResource ControlBackground}"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         VerticalAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="This bookmark's name. Used as the chapter title when exporting chapters. Rename it to anything; renaming one does not disturb the others."/>
                                            </StackPanel>

                                            <!-- [1] < 4s > - < 12s > (8s), one space between each
                                                 of them. Nudging the opening mark by a second is
                                                 the common correction — a cut that came in a
                                                 second late — and retyping the whole timestamp
                                                 was previously the only way to make it. -->
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <Button Content="&lt;" Style="{StaticResource NudgeStartBack}"
                                                    Click="NudgeArrow_Click" Tag="start-"
                                                    ToolTip="Move the start one second earlier"/>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <!-- Centered like everything else in the row. Without
                                                 this a TextBlock stretches to the row's full
                                                 height and draws its text at the top of it, which
                                                 goes unnoticed until something taller — the
                                                 chapter name box — makes the row taller than one
                                                 line, and then the two timestamps alone sit
                                                 raised above the dash and the duration. -->
                                            <TextBlock VerticalAlignment="Center"
                                                       ToolTip="Click to seek MPC-HC to this time">
                                                <Hyperlink Style="{StaticResource TimestampLink}"
                                                           Tag="{Binding StartSeconds}"
                                                           Click="TimestampHyperlink_Click">
                                                    <Run Text="{Binding StartDisplay, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <Button Content="&gt;" Style="{StaticResource NudgeStartForward}"
                                                    Click="NudgeArrow_Click" Tag="start+"
                                                    ToolTip="Move the start one second later"/>

                                            <!-- Everything past the opening timestamp belongs to a
                                                 range, and an open bookmark has not got one. It
                                                 used to render the absent end as a number anyway —
                                                 "40s - 0s (0s)" — which reads as a cut that starts
                                                 at 40 seconds and runs backwards to nothing. An
                                                 open bookmark is now just its start time, and the
                                                 word after it says why there is nothing else. -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsIncomplete, Converter={StaticResource NotBoolToVis}}">
                                                <TextBlock Style="{StaticResource RowGap}"/>
                                                <TextBlock Text="-" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource RowGap}"/>

                                                <Button Content="&lt;" Style="{StaticResource NudgeEndBack}"
                                                        Click="NudgeArrow_Click" Tag="end-"
                                                        ToolTip="Move the end one second earlier"/>
                                                <TextBlock Style="{StaticResource RowGap}"/>
                                                <TextBlock VerticalAlignment="Center"
                                                           ToolTip="Click to seek MPC-HC to this time">
                                                    <Hyperlink Style="{StaticResource TimestampLink}"
                                                               Tag="{Binding EndSeconds}"
                                                               Click="TimestampHyperlink_Click">
                                                        <Run Text="{Binding EndDisplay, Mode=OneWay}"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource RowGap}"/>
                                                <Button Content="&gt;" Style="{StaticResource NudgeEndForward}"
                                                        Click="NudgeArrow_Click" Tag="end+"
                                                        ToolTip="Move the end one second later"/>

                                                <TextBlock Style="{StaticResource RowGap}"/>
                                                <TextBlock Text="{Binding EffectiveDurationDisplay, StringFormat=({0})}" Foreground="{DynamicResource ValueGreen}" VerticalAlignment="Center"
                                                           ToolTip="How long the saved clip will run — the marked range at this clip's speed"/>

                                                <!-- Two more, for three in all with the one
                                                     that follows this panel. Every other gap
                                                     on the row is a space, a nudge arrow and
                                                     another space — and the arrows are hidden
                                                     rather than collapsed off-hover, so they
                                                     hold their width and those gaps read far
                                                     wider than the single space that used to
                                                     separate the length from the markers.
                                                     There is no arrow to put here, so the
                                                     spaces stand in for one. -->
                                                <TextBlock Style="{StaticResource RowGap}"/>
                                                <TextBlock Style="{StaticResource RowGap}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource RowGap}"/>
                                            <TextBlock Text="incomplete" Foreground="{DynamicResource StatusError}" FontStyle="Italic" VerticalAlignment="Center"
                                                       Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Flip, rotation and mute. The speed keeps its own two
                                             columns, so it is not stated twice — the overlay
                                             combines all four instead, where there is no room
                                             for columns (see Bookmark.Prefix).

                                             One line, trimmed, never wrapped. This is the star
                                             column — it is handed whatever is left once every
                                             other column has taken its share — so wrapping made
                                             a row's height depend on how little was left over,
                                             and "flipped · turned right · muted" came out as
                                             four stacked words on a narrow window. A row is one
                                             line tall; what does not fit ends in an ellipsis and
                                             the tooltip says the rest. -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource RotationMark}" Margin="0,0,3,0"
                                                  Visibility="{Binding ShowsRotationMark, Converter={StaticResource BoolToVis}}"/>
                                            <ItemsControl ItemsSource="{Binding EffectMarks}" FontSize="12"
                                                      VerticalAlignment="Center"
                                                      ItemsPanel="{StaticResource EffectMarksPanel}"
                                                      ItemTemplate="{StaticResource EffectMarkTemplate}"/>
                                        </StackPanel>

                                        <Slider Grid.Column="5" Minimum="0.25" Maximum="2.0" TickFrequency="0.25"
                                                IsSnapToTickEnabled="True" Value="{Binding Speed, Mode=TwoWay}"
                                                VerticalAlignment="Center" Width="80"
                                                ToolTip="{Binding SpeedDisplay, StringFormat=Plays at {0} when saved — drag to change}"/>

                                        <!-- The short reading — "normal", "1.5x" — rather
                                             than the spelled-out one, which needs a column
                                             half again as wide to say the same thing beside
                                             a slider that already shows the direction. -->
                                        <TextBlock Grid.Column="6" Text="{Binding SpeedShortDisplay}"
                                                   Foreground="{DynamicResource LinkBlue}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Margin="6,0,0,0"
                                                   ToolTip="{Binding DurationDisplay, StringFormat=Marked range is {0} of the source}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Storyboard: the same cuts, the same selection and
                             the same checkboxes, read as pictures. A ListView
                             rather than an ItemsControl so SelectedBookmark
                             keeps working across both views — picking a card
                             drives the clip preview exactly as picking a row
                             does, and switching views leaves the selection
                             where it was.

                             Only one of the two is ever up, so the hidden one
                             costs a visibility binding and nothing else. -->
                        <ListView ItemsSource="{Binding Session.Bookmarks}"
                                  SelectedItem="{Binding SelectedBookmark}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextBody}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="Storyboard_PreviewMouseWheel">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource ClipSpeedMenu}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <!-- Detail stretches its row to the full
                                         width; the wrapping layouts size to
                                         their own content, where this has
                                         nothing to do. -->
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RowSelected}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <!-- Visibility, the template and the panel all come
                                 from here rather than from attributes: a local
                                 value beats a Style setter, so anything set
                                 above would pin itself and the triggers below
                                 would silently stop working. -->
                            <ListView.Style>
                                <Style TargetType="ListView">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="ItemTemplate" Value="{StaticResource StoryboardCards}"/>
                                    <Setter Property="ItemsPanel" Value="{StaticResource StoryboardWrap}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StoryboardView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StoryboardLayout}"
                                                     Value="{x:Static services:StoryboardLayout.ContactSheet}">
                                            <Setter Property="ItemTemplate" Value="{StaticResource StoryboardContactSheet}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StoryboardLayout}"
                                                     Value="{x:Static services:StoryboardLayout.Detail}">
                                            <Setter Property="ItemTemplate" Value="{StaticResource StoryboardDetail}"/>
                                            <Setter Property="ItemsPanel" Value="{StaticResource StoryboardStack}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StoryboardLayout}"
                                                     Value="{x:Static services:StoryboardLayout.Filmstrip}">
                                            <Setter Property="ItemTemplate" Value="{StaticResource StoryboardFilmstrip}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Style>
                        </ListView>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Right panel. Named so the window can refuse to be shortened
                     past the point where its last line — whether MPC-HC is
                     running — is cut off. -->
                <Border x:Name="SidePanel" Grid.Column="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="14">
                    <!-- Scrolls, for the case the minimum size cannot fix. The
                         window's minimum height is measured from this panel's
                         own content, but capped to the work area — a panel
                         taller than the screen would otherwise be clipped at
                         the bottom with no way to see the rest. On any screen
                         with room for it the scrollbar never appears. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CURRENT VIDEO" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button Content="📁" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding RevealVideoCommand}"
                                    ToolTip="Show this video in Explorer"/>
                            <!-- The way in, where the way out already was. With
                                 nothing loaded this line reads "<none>" and said
                                 nothing about what to do next; the file menu and
                                 a drag from Explorer were the only routes, and
                                 neither is where someone looking at the empty
                                 line is looking.

                                 Visibility rather than the style's own
                                 disabled-means-hidden rule: the command works
                                 whether or not a video is loaded, and what
                                 decides this is the panel's state, not the
                                 command's. It is the exact opposite of the
                                 button above, so the two are never both here. -->
                            <Button Content="📂" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding OpenVideoFileCommand}"
                                    Visibility="{Binding Session.HasVideo, Converter={StaticResource NotBoolToVis}}"
                                    ToolTip="Open a video"/>
                        </StackPanel>
                        <!-- Red for the placeholder, the same as the two fields
                             below: "<none>" is nothing loaded, and nothing
                             loaded should not be wearing the colour the panel
                             uses for a healthy value. -->
                        <TextBlock Text="{Binding Session.VideoFileName}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Session.HasVideo}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Duration and edit length on one row: they are the
                             same kind of number and get read against each other
                             ("a minute of video, twenty seconds kept"), so
                             stacking them put a comparison a line apart and
                             pushed everything below down for nothing.

                             No video means no duration to report, so the row
                             goes rather than showing 00:00. -->
                        <Grid Visibility="{Binding Session.HasVideo, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DURATION" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding DurationDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,14"/>
                            </StackPanel>

                            <!-- Edit length needs a video, a loaded bookmark file
                                 and at least one complete pair. It shows the sum of
                                 the checked cuts, or of every cut when none are
                                 checked (see EditSession.SelectedDurationSeconds).
                                 Its column simply stays empty until then. -->
                            <StackPanel Grid.Column="1" Visibility="{Binding HasEditLength, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="EDIT LENGTH" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding Session.SelectedDurationDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ValueYellow}" Margin="0,2,0,14"/>
                            </StackPanel>
                        </Grid>

                        <!-- The timestamp binding. It used to sit in the status
                             bar, which is for messages about what just happened;
                             this is standing state, and it belongs with the rest
                             of the state down this side. Wraps because a captured
                             combination can be a good deal longer than "MButton". -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CURRENT HOTKEY" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <!-- Same idea as the folder beside CURRENT VIDEO and
                                 the pencil beside CURRENT BOOKMARKS: the thing
                                 that changes this value, next to the value. -->
                            <Button Content="&#9000;" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding SetTimestampHotkeyCommand}"
                                    ToolTip="Set the bookmark hotkey — pick a mouse button or capture a keyboard combination"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HotkeyDisplay}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ValueYellow}" Margin="0,2,0,18"/>

                        <!-- First and last frame of the highlighted clip. Only the
                             selected one is rendered: two frames per selection is
                             free, two per bookmark across a long list is hundreds
                             of ffmpeg launches for pictures nobody looks at. The
                             frames appear a moment after the labels, which is why
                             the placeholders below carry a background. -->
                        <StackPanel Visibility="{Binding HasClipPreview, Converter={StaticResource BoolToVis}}">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding ClipPreviewHeading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Background="{DynamicResource InsetBackground}" CornerRadius="3" Height="76"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ClipInThumbnail}" Stretch="Uniform"
                                                   Style="{StaticResource PreviewFrame}"/>
                                            <!-- The frame as the cut will start:
                                                 out of black. Drawn over the
                                                 picture rather than beside it,
                                                 because a fade is a thing the
                                                 frame does, not a property of
                                                 it. -->
                                            <Rectangle Visibility="{Binding PreviewedBookmark.FadeInSeconds,
                                                                     Converter={StaticResource PositiveToVis}}"
                                                       IsHitTestVisible="False">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#F2000000" Offset="0"/>
                                                        <GradientStop Color="#99000000" Offset="0.45"/>
                                                        <GradientStop Color="#00000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <ContentControl Style="{StaticResource PreviewSpeedBadge}"/>
                                            <ContentControl Style="{StaticResource PreviewMuteBadge}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="IN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Background="{DynamicResource InsetBackground}" CornerRadius="3" Height="76"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ClipOutThumbnail}" Stretch="Uniform"
                                                   Style="{StaticResource PreviewFrame}"/>
                                            <!-- Mirrored: this end fades down
                                                 into black rather than up out
                                                 of it. -->
                                            <Rectangle Visibility="{Binding PreviewedBookmark.FadeOutSeconds,
                                                                     Converter={StaticResource PositiveToVis}}"
                                                       IsHitTestVisible="False">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#99000000" Offset="0.55"/>
                                                        <GradientStop Color="#F2000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <ContentControl Style="{StaticResource PreviewSpeedBadge}"/>
                                            <ContentControl Style="{StaticResource PreviewMuteBadge}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="OUT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ValueYellow}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CURRENT BOOKMARKS" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button Content="✎" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding EditBookmarksCommand}"
                                    ToolTip="Open the bookmark CSV in a text editor — changes are picked up when this window regains focus"/>
                            <Button Content="📂" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding OpenBookmarkFileCommand}"
                                    Visibility="{Binding HasBookmarksFile, Converter={StaticResource NotBoolToVis}}"
                                    ToolTip="Open a bookmark file"/>
                        </StackPanel>
                        <!-- Green says "this is loaded and fine". A placeholder
                             is the opposite of that, so both of these fields
                             turn red when there is nothing behind them rather
                             than reporting "<none>" in the healthy colour. -->
                        <TextBlock Text="{Binding BookmarksFileName}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBookmarksFile}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ValueGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CURRENT PLAYLIST" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <!-- The same pair the bookmarks header carries, for
                                 the same reason: the file named below is a
                                 file, and editing it by hand is the escape
                                 hatch when the menu cannot express something.
                                 Shown only with a playlist loaded, there being
                                 nothing to edit otherwise. -->
                            <Button Content="✎" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding OpenPlaylistFileCommand}"
                                    CommandParameter="{Binding LoadedPlaylistPath}"
                                    Visibility="{Binding HasLoadedPlaylist, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Open the playlist in a text editor"/>
                            <!-- Every format the program reads, not only the one
                                 it writes. -->
                            <Button Content="📂" Style="{StaticResource HeaderIcon}"
                                    Command="{Binding LoadPlaylistFileCommand}"
                                    Visibility="{Binding HasLoadedPlaylist, Converter={StaticResource NotBoolToVis}}"
                                    ToolTip="Open a playlist"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PlaylistFileName}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadedPlaylist}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ValueGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>

                        <TextBlock Text="MPC-HC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Not running"/>
                                    <Setter Property="Foreground" Value="{DynamicResource StatusError}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMpcRunning}" Value="True">
                                            <Setter Property="Text" Value="● Running"/>
                                            <Setter Property="Foreground" Value="{DynamicResource StatusOk}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
