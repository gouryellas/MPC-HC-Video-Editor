                    <MenuItem.Icon>
                        <TextBlock Text="◐" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>

            </MenuItem>
            <MenuItem Header="&#9000; Hotkey">
                <!-- Header shows the current binding live (e.g. "Hotkey: MButton",
                     "Hotkey: Ctrl+Shift+T", "Hotkey: OFF"). Bound to the
                     ViewModel's HotkeyMenuLabel which is updated whenever the
