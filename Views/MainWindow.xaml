                <MenuItem Header="Set" Style="{StaticResource MenuSectionHeader}"/>
                <MenuItem Header="Change keybind…" Command="{Binding SetTimestampHotkeyCommand}"
                          ToolTip="Pick a mouse button or capture a keyboard combination">
                    <MenuItem.Icon>
                        <TextBlock Text="⌨" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="&#128278; Bookmarks">
                <!-- Header carries the live hotkey binding, e.g.
