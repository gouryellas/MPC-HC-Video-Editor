                <MenuItem Header="Resize images…" Command="{Binding ResizeImagesCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📐" Style="{StaticResource MenuGlyph}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Image info…" Command="{Binding ShowImageInfoCommand}"
