<!-- Title is set in the constructor from the assembly version — see AppVersion.
     The literal that used to be on the Title attribute below is why 3.0.1
     shipped with a window still captioned 3.0; what is left there is only what
     the XAML designer shows. -->
<Window x:Class="MpcHcVideoEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MpcHcVideoEditor.ViewModels"
        xmlns:helpers="clr-namespace:MpcHcVideoEditor.Helpers"
        Title="MPC-HC Video Editor"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="780" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:ProgressToBrushConverter x:Key="ProgressBrush"/>


        <Style TargetType="Button" x:Key="DarkButton">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}"/>

        <!-- Readable menus: light background, black text, LTR -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#CCE8FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#CCCCCC"/>
        </Style>

        <!-- Clickable timestamp look: teal, no underline by default,
             underline + brighter colour on hover, hand cursor.
             Used for the bookmark timestamp hyperlinks. -->
        <Style x:Key="TimestampLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#4EC9B0"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to seek MPC-HC to this time"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#7FE0C8"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu x:Name="HeaderMenu" DockPanel.Dock="Top" Background="#F3F3F3" Foreground="Black" FlowDirection="LeftToRight" Padding="4">
            <MenuItem Header="_File">
                <MenuItem Header="Open…" Command="{Binding OpenFileCommand}"
                          ToolTip="Open a video file, bookmark CSV, or .pls playlist (auto-detected by extension)"/>
                <!-- Where every action except the one-click row button writes.
                     Defaults to the loaded video's own folder and stays that
                     way until the user picks a folder, after which it is
                     pinned for the rest of the session. -->
                <MenuItem Header="{Binding SaveToFolderDisplay}" Command="{Binding SetSaveToFolderCommand}"
                          ToolTip="Destination for merge, split, convert, strip audio and bulk merge"/>
                <MenuItem Header="{Binding QuickSaveFolderDisplay}" Command="{Binding SetQuickSaveFolderCommand}"
                          ToolTip="Destination for the one-click save button on each bookmark row"/>
                <Separator x:Name="ShortcutsStartSeparator"/>
                <!-- Dynamic quick save shortcuts inserted here at runtime from
                     the ViewModel's QuickSaveShortcuts collection. Each has a
                     "Set" / "Remove" submenu; Set points the quick save folder
                     at it. ShortcutsEndSeparator stays visible at all times —
                     it doubles as the divider before the items below, so we
                     never end up with two consecutive separators. -->
                <Separator x:Name="ShortcutsEndSeparator"/>
                <MenuItem Header="Add quick save shortcut…" Command="{Binding AddQuickSaveShortcutCommand}"
                          ToolTip="Pick a folder to add to the quick save shortcut list above"/>
                <Separator/>
                <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}"
                          ToolTip="Output format, view switching, and what happens to source files after an operation"/>
                <MenuItem Header="Reset everything…" Command="{Binding ResetEverythingCommand}"
                          ToolTip="Restart the application (settings, history, naming tags, and shortcuts are preserved)"/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Bookmarks">
                <!-- Header carries the live hotkey binding, e.g.
                     "Set timestamp: MButton". Bound to SetTimestampMenuLabel. -->
                <MenuItem Header="{Binding SetTimestampMenuLabel}" Command="{Binding SetTimestampCommand}"
                          ToolTip="Set a timestamp at the current MPC-HC position — toggles open/close automatically"/>
                <MenuItem Header="Undo last bookmark" Command="{Binding UndoLastBookmarkCommand}"
                          ToolTip="Remove the most recently added bookmark from the GUI and CSV"/>
                <Separator/>
                <MenuItem Header="Edit bookmarks" Command="{Binding EditBookmarksCommand}"
                          ToolTip="Open the bookmark CSV in a text editor — changes are picked up when this window regains focus"/>
                <MenuItem Header="Enter time / range…" Command="{Binding EnterTimeManualCommand}"/>
                <MenuItem Header="Delete bookmarks" Command="{Binding DeleteBookmarksCommand}"
                          ToolTip="Delete the bookmark file from disk"/>
                <MenuItem Header="Remove selected timestamps" Command="{Binding DeleteSelectedCommand}"
                          ToolTip="Remove the checked timestamps from the list and from the bookmark file"/>
                <Separator/>
                <MenuItem Header="Play all cuts" Command="{Binding PlayAllCommand}"
                          ToolTip="Seek MPC-HC to each bookmark and play it for its full duration, sequentially"/>
                <MenuItem Header="Play selected cuts" Command="{Binding PlaySelectedCommand}"
                          ToolTip="Same as Play all, but only the cuts you've checked"/>
                <Separator/>
                <MenuItem Header="Select all" Command="{Binding SelectAllCommand}"/>
                <MenuItem Header="Select none" Command="{Binding SelectNoneCommand}"/>
                <Separator/>
            </MenuItem>
            <MenuItem Header="_Actions">
                <MenuItem Header="Merge selected / all / any" Command="{Binding MergeSelectedCommand}"
                          ToolTip="Merges the checked cuts, or every cut, or — with no video loaded — files you pick. A single cut is written out on its own as a trim.">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="#0E639C" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Split selected / all" Command="{Binding SplitSelectedCommand}">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="#3D5A40" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Convert files to MP4…" Command="{Binding ConvertFilesCommand}">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="#5B3A8E" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Strip audio to MP3…" Command="{Binding StripAudioCommand}">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="#8B5A1A" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- Target format is the CommandParameter, so picking one is a
                     single gesture rather than a menu click then a dialog. -->
                <MenuItem Header="Image conversion" ToolTip="Convert image files to another format">
                    <MenuItem.Icon>
                        <Rectangle Width="12" Height="12" Fill="#2E7D5B" RadiusX="2" RadiusY="2"/>
                    </MenuItem.Icon>
                    <MenuItem Header="To PNG…"  Command="{Binding ConvertImagesCommand}" CommandParameter="png"/>
                    <MenuItem Header="To JPG…"  Command="{Binding ConvertImagesCommand}" CommandParameter="jpg"/>
                    <MenuItem Header="To JPEG…" Command="{Binding ConvertImagesCommand}" CommandParameter="jpeg"/>
                    <MenuItem Header="To BMP…"  Command="{Binding ConvertImagesCommand}" CommandParameter="bmp"/>
                    <MenuItem Header="To GIF…"  Command="{Binding ConvertImagesCommand}" CommandParameter="gif"/>
                    <MenuItem Header="To TIFF…" Command="{Binding ConvertImagesCommand}" CommandParameter="tiff"/>
                    <MenuItem Header="To ICO…"  Command="{Binding ConvertImagesCommand}" CommandParameter="ico"
                              ToolTip="Scaled to 256px if larger — the ICO format cannot express more"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Playlist">
                <MenuItem Header="{Binding PlaylistFolderDisplay}" Command="{Binding SetPlaylistFolderCommand}"
                          ToolTip="Folder scanned for .pls playlists"/>
                <!-- These three are Click handlers rather than commands, so
                     they cannot be gated by CanExecute — IsEnabled binds to
                     the equivalent ViewModel predicate instead. -->
                <MenuItem Header="Refresh list" Click="RefreshPlaylists_Click"
                          IsEnabled="{Binding HasPlaylistFiles}"
                          ToolTip="Re-read the playlist folder and rebuild this menu"/>
                <MenuItem Header="Load playlist…" Click="LoadPlaylist_Click"
                          ToolTip="Load a .pls playlist — subsequent Add-to-playlist actions route to it directly"/>
                <!-- Gated on a playlist simply being loaded. It used to key off
                     the loaded playlist still having entries, which was cached
                     and went stale — leaving this greyed out with a playlist
                     plainly loaded. An empty playlist can no longer be loaded
                     at all, so the entry count adds nothing here. -->
                <MenuItem Header="Unload playlist" Click="ClearLoadedPlaylist_Click"
                          IsEnabled="{Binding HasLoadedPlaylist}"
                          ToolTip="Forget the currently-loaded playlist — Add-to-playlist will prompt again"/>
                <Separator x:Name="PlaylistStartSeparator" Visibility="Collapsed"/>
                <!-- Dynamic per-playlist entries inserted here at runtime
                     by MainWindow.xaml.cs. Each playlist is headed by its
                     name and the number of entries it lists — "clips.pls (50)"
                     — and expands to show those entries (numbered 1, 2, 3, …)
                     plus actions: View playlist content / Load this playlist /
                     Add current video / Remove missing entries / Delete playlist.
                     PlaylistEndSeparator doubles as the divider before
                     "New playlist…" — no extra static separator needed. -->
                <MenuItem Header="(no playlist folder set)" IsEnabled="False" x:Name="PlaylistEmptyPlaceholder"/>
                <Separator x:Name="PlaylistEndSeparator" Visibility="Collapsed"/>
                <MenuItem Header="New playlist…" Click="NewPlaylist_Click"
                          ToolTip="Create a new empty .pls file in the playlist folder"/>
                <MenuItem Header="{Binding AddToPlaylistMenuLabel}" Command="{Binding AddCurrentToPlaylistCommand}"
                          ToolTip="{Binding AddToPlaylistToolTip}"/>
            </MenuItem>
            <MenuItem Header="_Hotkey">
                <!-- Header shows the current binding live (e.g. "Hotkey: MButton",
                     "Hotkey: Ctrl+Shift+T", "Hotkey: OFF"). Bound to the
                     ViewModel's HotkeyMenuLabel which is updated whenever the
                     binding changes. -->
                <MenuItem Header="{Binding HotkeyMenuLabel}" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Set timestamp hotkey…" Command="{Binding SetTimestampHotkeyCommand}"
                          ToolTip="Pick a mouse button or capture a keyboard combination"/>
                <MenuItem Header="Disable hotkey" Command="{Binding DisableTimestampHotkeyCommand}"/>
            </MenuItem>
            <!-- Suffix menu — manages filename suffixes appended to all video
                 outputs (merge, split, convert, strip audio, bulk merge).
                 The first item shows the currently-active suffix; the dynamic
                 list below lets the user switch by clicking. -->
            <MenuItem Header="_Options">
                <!-- Not IsEnabled="False", unlike the example line below it: the
                     MenuItem style greys disabled items to #888888, and this is
                     the one line here that says which tag is actually in use, so
                     it stays at full contrast. It has no Command, so it is still
                     a label — clicking it just closes the menu. -->
                <MenuItem Header="{Binding ActiveSuffixDisplay}"/>
                <MenuItem Header="{Binding SuffixExampleDisplay}" IsEnabled="False"/>
                <Separator x:Name="SuffixListStartSeparator"/>
                <!-- Dynamic per-suffix entries inserted here at runtime by
                     MainWindow.xaml.cs. The active one gets a ✓ prefix;
                     clicking any entry sets it as active. SuffixListEndSeparator
                     doubles as the divider before "Add suffix…" — no extra
                     static separator needed. -->
                <Separator x:Name="SuffixListEndSeparator"/>
                <MenuItem Header="Add new naming tag…" Command="{Binding AddSuffixCommand}"/>
                <MenuItem Header="Manage naming tags…" Command="{Binding ManageSuffixesCommand}"/>
            </MenuItem>
            <!-- Shortcuts menu — lets the user add folder shortcuts that then
                 appear as clickable items at the bottom of the File menu. -->
            <MenuItem Header="Sho_rtcuts">
                <MenuItem Header="Add shortcut…" Command="{Binding AddShortcutCommand}"/>
                <MenuItem Header="Manage shortcuts…" Command="{Binding ManageShortcutsCommand}"/>
                <Separator x:Name="ShortcutsMenuStartSeparator"/>
                <!-- Dynamic per-shortcut "Open" + "Rename…" + "Remove" entries
                     appended here at runtime by MainWindow.xaml.cs. These open
                     a folder in Explorer and have nothing to do with the
                     quick save shortcuts in the File menu. -->
            </MenuItem>

            <!-- History — the recently-played videos, promoted out of the File
                 menu to a top-level menu of its own. Entries between the two
                 named separators are inserted at runtime from RecentVideos. -->
            <MenuItem Header="H_istory" x:Name="RecentMenuItem" ToolTip="Recently played videos">
                <MenuItem Header="(no recent videos)" IsEnabled="False" x:Name="RecentEmptyPlaceholder"/>
                <Separator x:Name="RecentStartSeparator" Visibility="Collapsed"/>
                <!-- Dynamic per-video entries inserted here at runtime -->
                <Separator x:Name="RecentEndSeparator" Visibility="Collapsed"/>
                <MenuItem Header="Clear history" Click="ClearRecentList_Click" x:Name="RecentClearItem" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Bring MPC-HC to front" Command="{Binding BringMpcToFrontCommand}"/>
                <Separator/>
                <!-- Minimal pins a click-through overlay of just the bookmark
                     list; X, or Full below, is what unpins it. Focus decides
                     whether a pinned overlay is on screen, never whether it is
                     still pinned — it hides for an unrelated window and comes
                     back for this one or MPC-HC. Deliberately not the same as
                     "Switch views automatically" further down, which restores
                     this window outright when the player loses focus. Disabled
                     with no bookmarks — see CanShowMinimalView. -->
                <MenuItem Header="Minimal" Command="{Binding ShowMinimalViewCommand}"
                          ToolTip="Compact always-on-top bookmark list. Stays until you press X or pick Full, and hides itself while another application is in front — needs at least one bookmark"/>
                <MenuItem Header="Full" Command="{Binding ShowFullViewCommand}"
                          ToolTip="The normal window"/>
                <Separator/>
                <!-- Lives here rather than under Options: it governs the two
                     items directly above it. -->
                <MenuItem Header="Switch views automatically" IsCheckable="True"
                          IsChecked="{Binding AutoSwitchViews, Mode=TwoWay}"
                          ToolTip="Drop to the minimal overlay whenever MPC-HC becomes the active window. Either way, this window returns as soon as MPC-HC stops being active."/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="About…" Command="{Binding ShowAboutCommand}"
                          ToolTip="Version, licensing and third-party components"/>
                <Separator/>
                <MenuItem Header="GitHub repository" Command="{Binding OpenRepositoryCommand}"
                          ToolTip="https://github.com/gouryellas/MPC-HC-Video-Editor"/>
                <MenuItem Header="Report an issue" Command="{Binding OpenIssuesCommand}"
                          ToolTip="Open the issue tracker in your browser"/>
                <Separator/>
                <MenuItem Header="Licences" Command="{Binding ShowAboutCommand}"
                          ToolTip="Licence terms for this app and the components it uses"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" Foreground="White" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="{Binding HotkeyStatus}" Foreground="#EBCB8B" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMpcRunning, Converter={StaticResource BoolToVis}}" Margin="16,0,0,0">
                        <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="#A6E3A1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " Foreground="#88C0D0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DurationDisplay}" Foreground="#88C0D0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <ProgressBar Grid.Column="2" Width="160" Height="8"
                             Value="{Binding ProgressPercent}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             Background="#005A9E" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Job progress. Sits above the status bar and only takes space while
             an operation is running. -->
        <Border DockPanel.Dock="Bottom" Background="#252526" Padding="12,8"
                Visibility="{Binding Job.IsRunning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Job.Action}" Foreground="#E0E0E0" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Job.FileCountDisplay}" Foreground="#888"
                               Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Job.PercentDisplay}" Foreground="#E0E0E0"
                               FontWeight="SemiBold"/>
                </Grid>

                <TextBlock Text="{Binding Job.CurrentFile}" Foreground="#4EC9B0"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding Job.Step}" Foreground="#DCDCAA"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                <!-- Colour comes from the percentage itself, ramping black →
                     red → orange → yellow → green. -->
                <Border Background="#1A1A1A" CornerRadius="3" Height="14" Padding="2">
                    <Grid>
                        <Rectangle HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                                   Fill="{Binding Job.Percent, Converter={StaticResource ProgressBrush}}"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Job.PercentFraction}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>

                <Grid Margin="0,6,0,0">
                    <TextBlock Foreground="#888" HorizontalAlignment="Left">
                        <Run Text="Elapsed"/><Run Text="  "/><Run Text="{Binding Job.ElapsedDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#888" HorizontalAlignment="Right">
                        <Run Text="Remaining"/><Run Text="  "/><Run Text="{Binding Job.RemainingDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar. WrapPanel, not StackPanel: a horizontal StackPanel
                 keeps laying out past the right edge, so at narrow widths the
                 last buttons were cut off rather than moving to a second row. -->
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="📍 Set timestamp" Command="{Binding SetTimestampCommand}" ToolTip="Set a timestamp at the current MPC-HC position"/>
                <Button Content="🗑" Command="{Binding DeleteSelectedCommand}" Width="36" ToolTip="Delete selected"/>
                <Button Content="↕ Flip" Command="{Binding ToggleFlipCommand}" ToolTip="Toggle vertical flip"/>
                <Rectangle Width="12"/>
                <Button Content="Select All" Command="{Binding SelectAllCommand}"/>
                <Button Content="None" Command="{Binding SelectNoneCommand}"/>
                <Rectangle Width="12"/>
                <!-- Bulk merge sits next to Merge; the rest keep their order.
                     None of these set an explicit Width — the button style
                     pads around the content, so each one is as wide as its
                     text needs. A fixed width was clipping "Convert video". -->
                <Button Content="🎬 Merge" Command="{Binding MergeSelectedCommand}"
                        Background="#0E639C" BorderBrush="#1177BB" FontWeight="SemiBold"/>
                <Button Content="✂ Split" Command="{Binding SplitSelectedCommand}"
                        Background="#3D5A40" BorderBrush="#4E6B50"/>
                <Button Content="🔄 Convert video" Command="{Binding ConvertFilesCommand}"
                        Background="#5B3A8E" BorderBrush="#6E4FA8"/>
                <Button Content="🔊 Strip audio" Command="{Binding StripAudioCommand}"
                        Background="#8B5A1A" BorderBrush="#A87423"/>
                <Rectangle Width="12"/>
                <Button Content="✎ Edit bookmarks" Command="{Binding EditBookmarksCommand}"/>
                <Button Content="⏱ Enter time" Command="{Binding EnterTimeManualCommand}"/>
            </WrapPanel>

            <!-- Timeline. Bottom to top: track, playback position, then the
                 bookmark ranges drawn across the upper half so they read as
                 marks on the bar rather than competing with the position. -->
            <Grid Grid.Row="1" Margin="0,0,0,8" Height="18">
                <Border Background="#1A1A1A" CornerRadius="3"/>

                <ProgressBar Value="{Binding TimelineProgress}" Minimum="0" Maximum="1"
                             Height="6" Margin="0,6" Background="Transparent"
                             Foreground="#0E639C" BorderThickness="0"/>

                <helpers:TimelineRanges Height="8" Margin="0,2,0,8"
                                        VerticalAlignment="Top"
                                        Bookmarks="{Binding Session.Bookmarks}"
                                        DurationSeconds="{Binding Session.VideoDurationSeconds}"
                                        ToolTip="Bookmarked ranges — teal when checked, orange when marked for inversion, red tick for an open bookmark"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- List -->
                <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                    <DockPanel>
                        <!-- Columns mirror the row template below so the captions
                             sit over the controls they name. The speed slider had
                             nothing labelling it at all: what it did was only
                             discoverable by dragging one and watching the clip
                             length change. -->
                        <Grid DockPanel.Dock="Top" Margin="4,2,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="Bookmarks"
                                       FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" Foreground="#888"
                                       Text="{Binding Session.Bookmarks.Count, StringFormat={}{0} items}"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Text="PLAY SPEED OF THE SAVED CLIP"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#888"
                                       TextWrapping="Wrap" LineHeight="11"
                                       ToolTip="Each clip can be written out slower or faster than it was recorded. Drag a row's slider to change that clip; the length beside it updates to match."/>
                        </Grid>

                        <ListView ItemsSource="{Binding Session.Bookmarks}"
                                  SelectedItem="{Binding SelectedBookmark}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="#DDDDDD"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#094771"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2A2D2E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- One-click split: clicking this radio button
                                             immediately FFmpeg-splits just this clip into
                                             the quick save folder (File ▸ "Quick save: …"),
                                             or next to the source video when that folder is
                                             unset, using the active suffix. Only shown on
                                             complete (valid) bookmarks. -->
                                        <RadioButton Grid.Column="0"
                                                     GroupName="{Binding Index}"
                                                     Visibility="{Binding IsValid, Converter={StaticResource BoolToVis}}"
                                                     Command="{Binding DataContext.SplitSingleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                     CommandParameter="{Binding}"
                                                     ToolTip="Click to save this clip now — goes to the quick save folder, or next to the source video if none is set"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Cursor="Hand"/>
                                        <!-- Disabled rather than hidden while the bookmark is
                                             still open: it shows the checkbox is coming once a
                                             closing timestamp is set, instead of the row
                                             silently changing shape. -->
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsValid}"
                                                  ToolTip="Set a closing timestamp before this cut can be selected"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Index, StringFormat=[{0}]}" FontWeight="Bold" Foreground="#569CD6" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock ToolTip="Click to seek MPC-HC to this time">
                                                <Hyperlink Style="{StaticResource TimestampLink}"
                                                           Tag="{Binding StartSeconds}"
                                                           Click="TimestampHyperlink_Click">
                                                    <Run Text="{Binding StartDisplay, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text=" → " Foreground="#666"/>
                                            <TextBlock ToolTip="Click to seek MPC-HC to this time">
                                                <Hyperlink Style="{StaticResource TimestampLink}"
                                                           Tag="{Binding EndSeconds}"
                                                           Click="TimestampHyperlink_Click">
                                                    <Run Text="{Binding EndDisplay, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DurationDisplay, StringFormat=  ({0})}" Foreground="#DCDCAA" Margin="4,0,0,0"/>
                                            <TextBlock Text="  incomplete" Foreground="#F44747" FontStyle="Italic"
                                                       Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Flip only. The speed has its own column, so the
                                             two are not squeezed into one marker — the
                                             overlay still combines them, where there is no
                                             room for columns (see Bookmark.Prefix). -->
                                        <TextBlock Grid.Column="4" Text="{Binding FlipDisplay}" Foreground="#CE9178"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>

                                        <Slider Grid.Column="5" Minimum="0.25" Maximum="2.0" TickFrequency="0.25"
                                                IsSnapToTickEnabled="True" Value="{Binding Speed, Mode=TwoWay}"
                                                VerticalAlignment="Center" Width="80"
                                                ToolTip="How fast this clip plays when it is saved. Left is slower, right is faster; the clip's length changes to match."/>

                                        <TextBlock Grid.Column="6" Text="{Binding SpeedDisplay}" Foreground="#9CDCFE"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   ToolTip="{Binding EffectiveDurationDisplay, StringFormat=Saved clip will run {0}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Right panel -->
                <Border Grid.Column="1" Background="#252526" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="CURRENT VIDEO" FontSize="11" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Session.VideoFileName}" TextWrapping="Wrap" Foreground="#4EC9B0" FontSize="14" Margin="0,0,0,16"/>

                        <!-- No video means no duration to report, so the whole
                             block goes rather than showing 00:00. -->
                        <StackPanel Visibility="{Binding Session.HasVideo, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DURATION" FontSize="11" FontWeight="SemiBold" Foreground="#888"/>
                            <TextBlock Text="{Binding DurationDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,2,0,14"/>
                        </StackPanel>

                        <!-- Edit length needs a video, a loaded bookmark file
                             and at least one complete pair. It shows the sum of
                             the checked cuts, or of every cut when none are
                             checked (see EditSession.SelectedDurationSeconds). -->
                        <StackPanel Visibility="{Binding HasEditLength, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="EDIT LENGTH" FontSize="11" FontWeight="SemiBold" Foreground="#888"/>
                            <TextBlock Text="{Binding Session.SelectedDurationDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="#DCDCAA" Margin="0,2,0,18"/>
                        </StackPanel>

                        <!-- First and last frame of the highlighted clip. Only the
                             selected one is rendered: two frames per selection is
                             free, two per bookmark across a long list is hundreds
                             of ffmpeg launches for pictures nobody looks at. The
                             frames appear a moment after the labels, which is why
                             the placeholders below carry a background. -->
                        <StackPanel Visibility="{Binding HasClipPreview, Converter={StaticResource BoolToVis}}">
                            <Border BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding ClipPreviewHeading}" FontSize="11" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Background="#1B1B1C" CornerRadius="3" Height="76">
                                        <Image Source="{Binding ClipInThumbnail}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="IN" FontSize="10" FontWeight="SemiBold" Foreground="#4EC9B0"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Background="#1B1B1C" CornerRadius="3" Height="76">
                                        <Image Source="{Binding ClipOutThumbnail}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="OUT" FontSize="10" FontWeight="SemiBold" Foreground="#DCDCAA"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Foreground="#777" FontSize="11" Margin="0,6,0,16" TextWrapping="Wrap"
                                       Text="{Binding ClipPreviewSubtext}"/>
                        </StackPanel>

                        <Border BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>

                        <TextBlock Text="CURRENT BOOKMARKS" FontSize="11" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding BookmarksFileName}" TextWrapping="Wrap" Foreground="#B5CEA8" FontSize="14" Margin="0,0,0,14"/>

                        <TextBlock Text="CURRENT PLAYLIST" FontSize="11" FontWeight="SemiBold" Foreground="#888" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PlaylistFileName}" TextWrapping="Wrap" Foreground="#B5CEA8" FontSize="14" Margin="0,0,0,18"/>

                        <Border BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>

                        <TextBlock Text="MPC-HC" FontSize="11" FontWeight="SemiBold" Foreground="#888"/>
                        <TextBlock Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Not running"/>
                                    <Setter Property="Foreground" Value="#F44747"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMpcRunning}" Value="True">
                                            <Setter Property="Text" Value="● Running"/>
                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
