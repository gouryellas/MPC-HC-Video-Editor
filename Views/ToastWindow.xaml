<Window x:Class="MpcHcVideoEditor.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MPC-HC Video Editor notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="0">

    <!-- Deliberately borderless + transparent: the visible chrome is the
         Border below, so the toast reads as an overlay rather than a window.
         Clicks pass straight through to whatever is underneath (MPC-HC) —
         see the WS_EX_TRANSPARENT / WS_EX_NOACTIVATE styles applied in the
         code-behind. -->
    <Border Background="{DynamicResource OverlayBackground}"
            BorderBrush="{DynamicResource ControlHover}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18,13"
            MinWidth="240">
        <!-- Black, not a theme key. This read
             Color="{DynamicResource MenuBarForeground}", and every theme key
             in this program is a Brush while DropShadowEffect.Color is a
             Color — so building this window threw a XamlParseException, every
             time, from the moment the shadow was added. ToastService.Show
             catches everything on the grounds that a notification is
             best-effort, so the throw went nowhere and no toast has ever
             appeared, for any caller.

             A shadow wants to be black at low opacity under either theme
             anyway; the theme key was never buying anything. -->
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText"
                       Text="📍"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="Timestamp set"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailText"
                           Text=""
                           Foreground="{DynamicResource TextDim}"
                           FontSize="12"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
