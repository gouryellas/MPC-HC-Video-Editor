<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For System.Windows.Forms.NotifyIcon, which is still the only
         supported way to put an icon in the notification area. WPF has no
         equivalent, and hand-rolling Shell_NotifyIcon means owning a hidden
         message window and the taskbar-restart protocol by hand. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MPC-HC Video Editor</AssemblyName>
    <RootNamespace>MpcHcVideoEditor</RootNamespace>
    <Version>3.0.7</Version>
    <Authors>Chris Larsen</Authors>
    <Description>Modern rewrite of the MPC-HC Video Editor (original AHK v2.1)</Description>

    <!-- Shown on the executable, the desktop shortcut and the window. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds System.Windows.Forms and System.Drawing to the
         implicit global usings. In a WPF project that makes Application,
         Color, Brush, Point, TextBox, RadioButton, DragEventArgs,
         MouseEventArgs and KeyEventArgs ambiguous in every file at once — the
         WinForms and WPF type of each name is then equally in scope.

         Removing them from the global set is the fix, rather than qualifying
         several dozen call sites: WinForms is used by exactly one file, which
         imports what it needs itself. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied beside the exe: the tray icon is loaded
         through a pack:// URI at runtime, and a portable install should not
         depend on a loose file surviving next to the executable. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\tray.ico" />
  </ItemGroup>

</Project>
