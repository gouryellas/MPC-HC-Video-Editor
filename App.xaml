<Application x:Class="MpcHcVideoEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- The picture in a menu item's icon column.

             Sized to the 16 the column is built for, and HighQuality because
             the art is 50px being drawn at 16 — the default scaler leaves
             that visibly crunchy. Here rather than in a window because the
             dialogs draw menu icons too. -->
        <Style x:Key="MenuIcon" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <!-- The eye beside Hide toolbar and Hide seekbar, which says which
             way the bar currently stands rather than what the click will do —
             the words beside it say that.

             Two styles rather than one with a parameter, because a Style
             cannot take one: each names the property it watches. Both are
             here rather than in the window, since the right-click menus are
             in their own visual trees but inherit the same DataContext.

             These items used to be checkable, and the tick was the state.
             A checked MenuItem draws the tick in place of its icon, so an
             eye that changed with the state would have been invisible in one
             of the two states it exists to tell apart. -->
        <Style x:Key="ToolbarEye" TargetType="Image" BasedOn="{StaticResource MenuIcon}">
            <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_show.png"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HideToolbar}" Value="True">
                    <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_hide.png"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeekbarEye" TargetType="Image" BasedOn="{StaticResource MenuIcon}">
            <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_show.png"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HideSeekbar}" Value="True">
                    <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_hide.png"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The mark beside a label whose tooltip carries the explanation,
             for the places where one is wanted on demand rather than on the
             way past.

             A raised asterisk, in the theme's accent. Both halves of that
             matter.

             Raised, because that is what a footnote reference is, and a
             footnote reference is exactly what this is: a mark saying there
             is more to read about the thing beside it. Centuries of print
             have already taught everybody what it means, so nothing has to
             explain the explainer. Raised by hand rather than by WPF's
             Superscript alignment, which lifts less and gives no say in how
             much.

             The accent, because the previous version inherited the colour of
             whatever it sat in — and on a row whose own text is muted, so was
             the mark. It disappeared completely on the Customize toolbar
             cards. The accent is the one colour every palette picks to stand
             out, so it cannot vanish into a surface nobody thought about.

             The heavy asterisk rather than the plain one. The plain * is
             typographically a superscript already and sits high before any
             lifting, which leaves it clipping the line above; and it is a
             thin, spindly shape that loses its form at this size. U+2731 is
             a solid six-pointed star, vertically centred, which keeps its
             shape small and only has to be lifted into place.

             It has been a ringed ?, a filled accent disc, a disc with the
             mark cut out of it, and a plain ?. Every one of those drew the
             eye to the container rather than the mark.

             Menu items in this program wait three seconds before showing a
             tooltip, so that reading down a menu does not pop panels over the
             entries below. That delay does not inherit, so a mark inside a
             header answers at the ordinary speed — which is the point of
             putting it there.

             ShowOnDisabled, because twelve of the marks in the menus sit on
             items that go grey when there is nothing to act on — and a
             greyed-out item is exactly when someone wants to know what it
             would have done. WPF suppresses tooltips on disabled elements by
             default, and IsEnabled is coerced down the tree, so without this
             the mark went quiet at the only moment it was worth hovering. -->
        <!-- Every tooltip in the program, themed.

             Nothing had ever styled one, so they were drawn in Windows'
             own near-white chrome — and the text inside them comes from
             whichever window built it, which in these dark windows means
             a pale grey. Pale grey on near-white: the explainers were
             unreadable, and so was every other tooltip in the app.

             Dark surface, outlined in the accent so it is tied to the
             mark that summoned it and reads as sitting on top of the
             window rather than blending into it. Foreground is set here
             as well, for tooltips whose content does not bring its own.

             Templated rather than left to the default chrome: the stock
             template paints a system-coloured border of its own that no
             amount of Background setting removes. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource InsetBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Qmhp" TargetType="ContentControl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <!-- The padding is the point of this Border, and the
                             Transparent with it: a mark eight pixels across
                             is a very small thing to hit, and a null
                             background is not a hit-test target at all. This
                             gives the pointer a few pixels of grace either
                             side without putting anything on screen.

                             The margin lives here rather than on the style so
                             that the padding does not add to it — six pixels
                             of gap, of which four are catchable. -->
                        <Border Background="Transparent"
                                Margin="2,0,0,0" Padding="4,2,4,2">
                            <TextBlock Text="&#x2731;" FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <!-- Lifted into the footnote position.
                                         A RenderTransform rather than a
                                         margin: a margin is laid out, so it
                                         would push the row taller by exactly
                                         the amount the mark was raised. -->
                                    <TranslateTransform Y="-3"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbars, themed.

             Here rather than in a window, because this is the one resource
             dictionary every window in the program shares: the dialogs are
             separate windows and would otherwise keep Windows' own white bar
             while the thing they are scrolling is dark.

             The theme brushes these name are written into this same dictionary
             by ThemeService at startup and again whenever the theme changes,
             so DynamicResource is what makes a scrollbar follow a theme picked
             while the program is running. -->

        <!-- The draggable block. Accent, because the complaint it answers is
             that it could not be seen: a thumb in a neutral grey is exactly
             the thing that disappears against a pale track, and the accent is
             the one colour in every palette picked to stand out.

             Slightly transparent at rest so a long bar does not shout, and
             solid under the pointer — which also makes it obvious that the
             part under the cursor is the part that moves. -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Transparent border rather than a margin: the gap
                             between the block and the edge of the bar stays
                             put while the block itself takes the colour, so
                             nothing moves when it lights up. -->
                        <Border x:Name="Block" Background="{DynamicResource Accent}"
                                CornerRadius="5" Opacity="0.75"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Block" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Block" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The track either side of the block. Invisible, but not absent:
             a null background is not a hit-test target, and clicking the
             track to page up or down is how a scrollbar is used by anyone who
             does not drag it. -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No stepper arrows at the ends. The default template has two, and
             a templated bar that kept them would need four more button styles
             to stop them being drawn in the system's own chrome — which is
             the look being replaced. Dragging, clicking the track and the
             wheel all still work. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- IsDirectionReversed, because a vertical track
                                 counts downwards while its value counts up. -->
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollPageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollPageButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The horizontal bar is the same parts laid the other way.
                     Width and Height swap, and the track counts the way its
                     value does, so the reversal above comes off. -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource ScrollPageButton}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource ScrollPageButton}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The button that dismisses a window.
             Here rather than in each window because every dialog carries
             its own button styling, and a red fill set on top of nine
             different templates would come out nine different ways — one
             hovering to the theme grey, one to a system blue, one not at
             all. This brings its own template, so an explicit style beats
             whatever the window states implicitly and the button looks
             the same wherever it is used.

             Red is fixed rather than themed, as the operation buttons
             are: the fill is its own colour and has nothing to match.
             It keeps that colour when disabled, since a close button
             made hard to read is a close button somebody is hunting
             for. -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#B3312C"/>
            <Setter Property="BorderBrush" Value="#8E2622"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#C93A34"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#A02A24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
