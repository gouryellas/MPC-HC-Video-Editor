<Application x:Class="MpcHcVideoEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- The picture in a menu item's icon column.

             Sized to the 16 the column is built for, and HighQuality because
             the art is 50px being drawn at 16 — the default scaler leaves
             that visibly crunchy. Here rather than in a window because the
             dialogs draw menu icons too. -->
        <Style x:Key="MenuIcon" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <!-- The eye beside Hide toolbar and Hide seekbar, which says which
             way the bar currently stands rather than what the click will do —
             the words beside it say that.

             Two styles rather than one with a parameter, because a Style
             cannot take one: each names the property it watches. Both are
             here rather than in the window, since the right-click menus are
             in their own visual trees but inherit the same DataContext.

             These items used to be checkable, and the tick was the state.
             A checked MenuItem draws the tick in place of its icon, so an
             eye that changed with the state would have been invisible in one
             of the two states it exists to tell apart. -->
        <Style x:Key="ToolbarEye" TargetType="Image" BasedOn="{StaticResource MenuIcon}">
            <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_show.png"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HideToolbar}" Value="True">
                    <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_hide.png"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeekbarEye" TargetType="Image" BasedOn="{StaticResource MenuIcon}">
            <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_show.png"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HideSeekbar}" Value="True">
                    <Setter Property="Source" Value="pack://application:,,,/Assets/icons/icon-eye_hide.png"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A question mark that carries an explanation, for the places where
             one is wanted on demand rather than on the way past.

             A ContentControl whose template is the whole mark, so a use is
             three lines and the disc is described once.

             A 10px disc in TextSecondary — the same ink as the words beside
             it, one shade down — with the "?" cut out of it so the surface
             shows through. No colour of its own at all, which is the point:
             an accent-filled disc was a fleck of the theme's orange, cyan or
             indigo sitting in the middle of a line of text, and at 14px it
             was the loudest thing in the menu.

             Because the mark is a hole rather than a glyph, the surface it
             is cut out of has to be named. Foreground is the ink of the disc,
             Background is what shows through it. The default pair suits a
             menu item; the dialogs set Background to whatever they are
             actually drawn on, since in a dark theme the menus are light
             while the panels behind them are not.

             No hover state. The mark does not do anything when clicked — it
             is there to be pointed at, and the tooltip appearing is the
             response.

             Menu items in this program wait three seconds before showing a
             tooltip, so that reading down a menu does not pop panels over the
             entries below. That delay does not inherit, so a mark inside a
             header answers at the ordinary speed — which is the point of
             putting it there.

             ShowOnDisabled, because twelve of the fourteen marks in the menus
             sit on items that go grey when there is nothing to act on — and a
             greyed-out item is exactly when someone wants to know what it
             would have done. WPF suppresses tooltips on disabled elements by
             default, and IsEnabled is coerced down the tree, so without this
             the mark went quiet at the only moment it was worth hovering. -->
        <Style x:Key="Qmhp" TargetType="ContentControl">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource MenuBarBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Disc" Width="10" Height="10" CornerRadius="5"
                                Background="{TemplateBinding Foreground}">
                            <TextBlock Text="?" FontSize="8" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- A disabled item's mark fades with it. IsEnabled
                                 is coerced down the tree, so a mark inside a
                                 disabled MenuItem is itself disabled without
                                 being told — and a disc left at full strength
                                 on a greyed-out line would be the one thing on
                                 it still claiming to be live.

                                 The same colour at reduced strength, rather
                                 than a swap to TextMuted. TextMuted is tuned
                                 to sit on a theme's panels, and the menus run
                                 the other way — pale in the dark themes — so
                                 against a menu bar it carries *more* contrast
                                 than TextSecondary, not less (3.4 against 2.3
                                 in Graphite). Swapping to it made a dead mark
                                 bolder than a live one, and only the opacity
                                 that came with it hid that.

                                 Not fainter than this: the tooltip now answers
                                 while disabled, so the mark has to stay worth
                                 aiming at. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbars, themed.

             Here rather than in a window, because this is the one resource
             dictionary every window in the program shares: the dialogs are
             separate windows and would otherwise keep Windows' own white bar
             while the thing they are scrolling is dark.

             The theme brushes these name are written into this same dictionary
             by ThemeService at startup and again whenever the theme changes,
             so DynamicResource is what makes a scrollbar follow a theme picked
             while the program is running. -->

        <!-- The draggable block. Accent, because the complaint it answers is
             that it could not be seen: a thumb in a neutral grey is exactly
             the thing that disappears against a pale track, and the accent is
             the one colour in every palette picked to stand out.

             Slightly transparent at rest so a long bar does not shout, and
             solid under the pointer — which also makes it obvious that the
             part under the cursor is the part that moves. -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Transparent border rather than a margin: the gap
                             between the block and the edge of the bar stays
                             put while the block itself takes the colour, so
                             nothing moves when it lights up. -->
                        <Border x:Name="Block" Background="{DynamicResource Accent}"
                                CornerRadius="5" Opacity="0.75"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Block" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Block" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The track either side of the block. Invisible, but not absent:
             a null background is not a hit-test target, and clicking the
             track to page up or down is how a scrollbar is used by anyone who
             does not drag it. -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- No stepper arrows at the ends. The default template has two, and
             a templated bar that kept them would need four more button styles
             to stop them being drawn in the system's own chrome — which is
             the look being replaced. Dragging, clicking the track and the
             wheel all still work. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- IsDirectionReversed, because a vertical track
                                 counts downwards while its value counts up. -->
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollPageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollPageButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The horizontal bar is the same parts laid the other way.
                     Width and Height swap, and the track counts the way its
                     value does, so the reversal above comes off. -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Style="{StaticResource ScrollPageButton}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Style="{StaticResource ScrollPageButton}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
